/* webAgent Server Manager — Textual CSS.
 *
 * Every color is a THEME VARIABLE (no literal hex) so the UI re-skins live
 * across all 23 shared themes and stays legible in light AND dark schemes.
 * Custom tokens ($dim, $tool, $bar-bg, $bar-fg, $bar-accent, $border-dim,
 * $sel) come from each theme plus the app's get_theme_variable_defaults().
 *
 * Flat look: the chrome (header pills, action buttons, the input pill,
 * and user-message bubbles) all share the MAIN background and are distinguished
 * by a bright outline — not a filled background. A "toggled" / active control
 * is shown by colouring its TEXT and OUTLINE, never by inverting its fill.
 */

Screen {
    background: $background;
    color: $foreground;
}

/* Custom header toolbar — clickable PILL buttons + live server status. The pills
 * share the main background and are STACKED with no gaps; the open category and the
 * mode pill are highlighted by outline + text colour, not a filled background. */
#status {
    layout: horizontal;
    height: 3;
    width: 100%;
    background: $background;
    color: $bar-fg;
    padding: 0 1;
    align: left middle;
}
#status .hdr-btn {
    width: auto; height: 3;
    margin: 0; padding: 0 2;
    border: round $border-dim;
    background: $background;
    color: $bar-accent;
    content-align: center middle;
}
#status .hdr-btn:hover { border: round $primary; color: $primary; }
#status .hdr-btn.hdr-on { border: round $primary; color: $primary; background: $background; }
#status .hdr-note { width: auto; height: 3; margin: 0; padding: 0 2; content-align: center middle; }

/* Plain-text app header (WEBAGENT / Server Manager) — replaces the old logo banner. */
#title { height: 3; width: 100%; content-align: center middle; padding: 1 0 0 0; }

/* Merged bar: token HUD text (left) + [Stop] / [Continue] (right).
 * Handles what was previously two rows (HUD + actionbar). The spinner widget
 * lives in here too but is invisible — its animated frame shows inside the
 * token HUD text as a spinning slash between in/out counts. */
#hud { layout: horizontal; height: 1; width: 100%; background: $background; color: $dim; padding: 0 2; }
#hud #hud-text { width: 1fr; height: 1; content-align: left middle; }
#hud #spinner { display: none; }   /* invisible — drives the slash animation */
#hud .act-btn {
    width: auto; height: 1; margin: 0 0 0 2; padding: 0;
    background: $background; color: $bar-accent;
    content-align: center middle;
}
#hud .act-btn:hover { text-style: bold; color: $primary; }
#hud .act-btn.disabled { color: $dim; text-style: none; }

/* Onboarding call-to-action — the tappable "get started" button (hidden once a
 * checkout is linked). Theme variables only, so it stays legible in every theme. */
#cta {
    height: 3;
    width: 100%;
    content-align: center middle;
    text-align: center;
    text-style: bold;
    color: $bar-accent;
    background: $background;
    border: round $primary;
}
#cta:hover { color: $primary; border: round $primary; }

/* Body = the middle band between header and footer: the chat column on the left
 * (always visible) and the docked side panel on the right (shown only when open). */
#body { layout: horizontal; width: 100%; height: 1fr; }
#main { width: 1fr; height: 100%; }

/* Thin docked right-side category panel (Admin / Scene / App / Server). Appears only
 * while a category is open; closes only on Esc or the ✕ header button — clicking
 * in the main/chat area does NOT dismiss it. Theme variables only — legible in light
 * AND dark. Width is capped at 60% so the chat stays visible even on a small phone;
 * button labels stack and wrap so they stay readable. */
#side-panel {
    width: 34; max-width: 85%;
    height: 100%;
    background: $panel;
    padding: 1 1;
    overflow-y: auto; overflow-x: hidden;
    scrollbar-size-vertical: 1;
    scrollbar-corner-color: $panel;
}

/* Drag handle on the panel's left edge — grab + drag to resize the panel.
 * A thin vertical strip; widens its tint on hover so it's discoverable. */
#panel-grip {
    width: 1; height: 100%;
    background: $primary;
    color: $background;
    content-align: center middle;
}
#panel-grip:hover { background: $secondary; }
#side-panel #panel-title { text-style: bold; color: $bar-accent; margin-bottom: 1; }
#side-panel .panel-sub { width: 100%; height: auto; color: $dim; margin-top: 1; }
/* Panel text fields use the same rounded PILL as the chat input + buttons
 * (override Textual's default heavy Input border). */
#side-panel Input {
    width: 100%; height: 3;
    border: round $border-dim;
    background: $background;
    color: $foreground;
}
#side-panel Input:focus { border: round $primary; }

/* LLM key block: 4 borderless input LINES sharing one background panel, with a
 * one-line gap between each (so the whole block is ~8 lines tall). No per-field
 * boxes — just clean lines on a tinted surface. */
#side-panel .keybox {
    width: 100%; height: auto;
    background: $boost;
    border: round $border-dim;
    padding: 0 1; margin-bottom: 1;
}
#side-panel .keybox Input {
    width: 100%; height: 1;
    border: none; background: $boost;
    margin: 0 0 1 0; padding: 0;
    color: $foreground;
}
#side-panel .keybox Input:focus { border: none; background: $background; }

/* Connect (WEBAGENT) dropdowns — full width, spaced; the Select draws its own pill. */
#side-panel .connect-select { width: 100%; margin-bottom: 1; }

/* Diagnostics / Logs readout — wrapping monospace text on a tinted surface that
 * fills the (widened) panel and scrolls with it. */
#side-panel .readout-body {
    width: 100%; height: auto;
    background: $boost;
    border: round $border-dim;
    padding: 0 1; margin-top: 1;
    color: $foreground;
}
/* Side-panel PILL buttons — rounded, full-width, centred; big tap targets for phones. */
#side-panel .panel-btn {
    width: 100%; height: 3;
    margin-bottom: 1; padding: 0 1;
    border: round $border-dim;
    background: $boost;
    color: $bar-accent;
    content-align: center middle; text-align: center;
}
#side-panel .panel-btn:hover { color: $primary; border: round $primary; }
/* Toggled state = coloured outline + text, NOT an inverted fill. */
#side-panel .panel-btn-active { color: $secondary; background: $boost; border: round $secondary; }
/* A row of side-by-side pills (e.g. Save / Clear). */
#side-panel .panel-row { layout: horizontal; width: 100%; height: 3; }
#side-panel .panel-row .panel-btn { width: 1fr; margin: 0 1 0 0; }

/* Expanded sidebar width — toggled by the [‹› wide] button at the top of every view. */
#side-panel.side-wide { width: 60; max-width: 85%; }

/* Top row of every panel view: the expand/collapse toggle + the title. */
#side-panel .panel-top { layout: horizontal; width: 100%; height: 3; margin-bottom: 1; }
#side-panel .panel-top .panel-btn { width: auto; margin-bottom: 0; padding: 0 1; }
#side-panel .panel-top #panel-title { width: 1fr; height: 3; margin: 0 0 0 1; content-align: left middle; }

/* In-sidebar confirmation body (replaces the pop-up modal). */
#side-panel .confirm-body { width: 100%; height: auto; color: $foreground; margin: 1 0; }

/* Connect view: agent / session pick buttons read left-aligned (they're a list). */
#side-panel .connect-agent, #side-panel .connect-session, #side-panel .connect-new {
    content-align: left middle; text-align: left;
}

/* 'Scene' panel rows — one labelled Select per theme/animation setting. */
#side-panel .set-row { height: 3; width: 100%; }
#side-panel .set-row .set-label { width: 8; height: 3; content-align: left middle; color: $dim; }
#side-panel .set-row Select { width: 1fr; }

/* Confirm dialog — details + Confirm/Cancel, for admin actions (Update/Uninstall). */
ConfirmModal { align: center middle; }
#confirm-panel {
    width: 76; height: auto; max-height: 90%;
    background: $panel; border: round $primary; padding: 1 2;
}
#confirm-title { text-style: bold; color: $bar-accent; margin-bottom: 1; }
#confirm-body { height: auto; color: $foreground; margin-bottom: 1; }
#confirm-buttons { height: 3; align: right middle; }
#confirm-buttons .confirm-btn {
    width: auto; height: 3; margin: 0 0 0 2; padding: 0 2;
    border: round $border-dim; background: $background; color: $bar-accent;
    content-align: center middle;
}
#confirm-buttons .confirm-btn:hover { color: $primary; border: round $primary; }
#confirm-buttons .confirm-yes { color: $secondary; }

/* Transcript — a scrolling column of mounted widgets (text lines, user bubbles,
 * agent replies, and expandable tool-call blocks). Flat on the main background. */
#log {
    height: 1fr;
    width: 100%;
    background: $background;
    padding: 0 1;
    overflow-x: hidden;
    overflow-y: auto;
    scrollbar-gutter: stable;
    scrollbar-size-vertical: 1;
    scrollbar-color: $primary $background;
    scrollbar-color-hover: $primary-lighten-2 $background;
    scrollbar-color-active: $primary-lighten-2 $background;
    scrollbar-background: $background;
    scrollbar-corner-color: $background;
}

/* Transcript message kinds. */
.msg-line { width: 100%; height: auto; }
.msg-block { width: 100%; height: auto; color: $dim; }
.msg-agent { width: 100%; height: auto; color: $foreground; padding: 0 1; margin: 1 0 0 0; }
/* System notification from the watchdog — distinct from user/agent messages. */
.msg-notify {
    width: 100%; height: auto;
    background: $boost;
    border: round $accent; padding: 0 1; margin: 1 0 0 0;
    color: $accent;
}
.msg-user {
    width: 100%; height: auto;
    background: $background; color: $foreground;
    border: round $primary; padding: 0 1; margin: 1 0 0 0;
}
/* New-session notice: a pill-style announcement marking a session reset.
   Flush with the main background; outlined in the accent (blue/cyan) like
   the user-message pill but with a different border colour. */
.msg-session-new {
    width: 100%; height: auto;
    background: $background;
    border: round $accent;
    padding: 0 1; margin: 1 0 0 0;
    color: $foreground;
}
/* Clickable [Clear] pill inside the session-new notice — styled as a flat
   action button, same accent colour as the bordering outline. */
.session-clear-btn {
    width: auto; height: 3;
    background: $background;
    border: round $accent;
    padding: 0 2; margin: 0 0 1 0;
    color: $accent; text-style: bold;
    content-align: center middle;
}
.session-clear-btn:hover {
    color: $primary;
    border: round $primary;
}

/* Resume-session row in the sessions panel — distinct from other panel buttons. */
.resume-session {
    content-align: left middle; text-align: left;
}

/* Live web-app stream: the app agent's reply, and a message bound for the app. */
.msg-webagent {
    width: 100%; height: auto;
    color: $foreground; background: $boost;
    border: round $secondary; padding: 0 1; margin: 1 0 0 0;
}
.msg-webuser {
    width: 100%; height: auto;
    color: $secondary; padding: 0 1; margin: 1 0 0 0;
}

/* Expandable tool calls (nested, like the launcher).
 *   • collapsed group  → "N tool calls"
 *   • expand once       → each call listed (one row each)
 *   • expand a call     → its arguments + result, each in a code block */
.tool-group {
    width: 100%; height: auto;
    background: $background;
    border: round $border-dim;
    margin: 1 0 0 0;
    padding-bottom: 0;
}
.tool-group > CollapsibleTitle { color: $accent; text-style: bold; }
.tool-block {
    width: 1fr; height: auto;
    background: $background;
    border: none;
    margin-top: 1;
    padding-bottom: 0;
}
.tool-block CollapsibleTitle { color: $tool; }
/* Code block — the "special codeblock" for a call's arguments / command and its
 * result. Distinct, slightly raised surface so code reads apart from the chrome. */
.code-block {
    width: 100%; height: auto;
    background: $panel; color: $foreground;
    border: round $border-dim;
    padding: 0 1; margin: 0 0 1 0;
}

/* Framed "code card" — a header row (dim label + [Copy] button) above a code body.
 * Used for tool-call args/results AND for fenced code blocks in the agent's replies,
 * so every code/tool view has a one-click copy. Theme variables only (dark + light).
 *   • .code-card        the frame (border + raised surface)
 *   • .code-card-head   the title/Copy row
 *   • .copy-btn         the bracketed [Copy] / [Copied] text button */
.code-card {
    width: 100%; height: auto;
    background: $panel;
    border: round $border-dim;
    margin: 0 0 1 0;
    padding: 0 1;
}
.code-card .code-card-head {
    layout: horizontal;
    width: 100%; height: 1;
    margin: 0;
}
.code-card .code-card-title {
    width: 1fr; height: 1;
    content-align: left middle;
    color: $dim;
}
.code-card .copy-btn {
    width: auto; height: 1;
    margin: 0 0 0 1;
    content-align: right middle;
    color: $bar-accent;
}
.code-card .copy-btn:hover { color: $primary; text-style: bold; }
/* The body inside a card drops its own border + margin — the card frames it. */
.code-card .code-block {
    width: 100%; height: auto;
    background: $panel; color: $foreground;
    border: none;
    padding: 0; margin: 0;
}

#input-row {
    layout: horizontal;
    width: 100%;
    height: auto;
    border: round $primary;
    background: $background;
    min-height: 3;
    max-height: 5;
}
#input-row #prompt {
    width: 1fr;
    height: auto;
    min-width: 2;
    border: none;
    outline: none;
    background: $background;
    color: $foreground;
    padding: 0 0 0 1;
    margin: 0;
    scrollbar-size: 0 0;
}
#input-row #prompt .text-area-cursor { display: none; }
#input-row #prompt .text-area-gutter { display: none; }
#input-row #prompt .text-area-scrollbar { display: none; }
#input-row #prompt .text-area-editor { padding: 0; margin: 0; border: none; }
#input-row #send-btn {
    width: auto; min-width: 5; height: auto;
    padding: 0 1 0 0;
    margin-top: 1;
    background: $background;
    color: $primary;
    content-align: center middle;
    text-style: bold;
}
#input-row #send-btn:hover {
    color: $secondary;
    text-style: bold underline;
}

/* Pending image attachments: a wrapping row of removable chips above the input.
 * Each chip is the filename plus a clickable [x]. Theme variables only (so it
 * reads correctly in both dark and light themes). */
#attach-row {
    layout: horizontal;
    width: 100%;
    height: auto;
    margin: 1 0 0 0;
}
#attach-row .attach-chip {
    width: auto;
    height: 1;
    margin: 0 1 0 0;
    padding: 0 1;
    background: $boost;
    border-left: thick $accent;
}
#attach-row .attach-name {
    width: auto;
    height: 1;
    content-align: left middle;
    color: $foreground;
}
#attach-row .attach-x {
    width: auto;
    height: 1;
    margin: 0 0 0 1;
    color: $dim;
    text-style: bold;
}
#attach-row .attach-x:hover {
    color: $error;
}


