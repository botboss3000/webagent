                <div class="ac-details-body">
                  <ol style="margin:6px 0 0 16px;padding:0;">
                    <li>Go to <a href="https://kit.snapchat.com/manage" target="_blank" style="color:var(--accent);">Snap Kit Developer Portal → Create App</a></li>
                    <li>Add <strong>Login Kit</strong> and enter the Redirect URI above under <em>Redirect URLs</em></li>
                    <li>Copy the Client ID and Client Secret into the fields above and click Save</li>
                  </ol>
                </div>
              </details>
            </div>

            <!-- Twitch OAuth Config -->
            <div class="ac-card" id="ac-int-twitch-card">
              <div style="display:flex;align-items:center;gap:12px;margin-bottom:12px;">
                <svg viewBox="0 0 24 24" width="24" height="24" style="flex-shrink:0;">
                  <path fill="#9146FF" d="M11.571 4.714h1.715v5.143H11.57zm4.715 0H18v5.143h-1.714zM6 0L1.714 4.286v15.428h5.143V24l4.286-4.286h3.428L22.286 12V0zm14.571 11.143l-3.428 3.428h-3.429l-3 3v-3H6.857V1.714h13.714z"/>
                </svg>
                <div style="flex:1;">
                  <div style="font-weight:600;font-size:14px;">Twitch OAuth</div>
                  <div class="ac-hint" style="margin:0;">Channel and stream data access — app-level credentials</div>
                </div>
                <span id="ac-int-twitch-badge" class="ac-int-badge ac-int-badge-off">Not configured</span>
              </div>

              <div id="ac-int-twitch-configured" style="display:none;font-size:12px;">
                <div style="display:flex;flex-direction:column;gap:6px;">
                  <div><span style="color:var(--fg-muted);">Client ID:</span> <code id="ac-int-twitch-cid" style="font-size:11px;"></code></div>
                  <div><span style="color:var(--fg-muted);">Redirect URI:</span> <code id="ac-int-twitch-uri" style="font-size:11px;word-break:break-all;"></code></div>
                  <div class="ac-hint" style="margin-top:4px;">Users connect from the agent's <strong>Connections</strong> tab.</div>
                </div>
                <div style="margin-top:12px;">
                  <button id="ac-int-twitch-unconfigure" class="ac-btn ac-btn-ghost" style="color:#f7768e;">Unconfigure</button>
                </div>
              </div>

              <div id="ac-int-twitch-form" style="display:none;">
                <div class="ac-field" style="margin-bottom:10px;">
                  <label class="ac-label">Client ID</label>
                  <input type="text" id="ac-int-twitch-input-cid" class="ac-input" placeholder="abcdefg1234567hijklmn" autocomplete="off">
                </div>
                <div class="ac-field" style="margin-bottom:10px;">
                  <label class="ac-label">Client Secret</label>
                  <input type="password" id="ac-int-twitch-input-secret" class="ac-input" placeholder="Client secret" autocomplete="off">
                </div>
                <div class="ac-field">
                  <label class="ac-label" style="color:var(--fg-muted);">Redirect URI (add to Twitch App → OAuth Redirect URLs)</label>
                  <code id="ac-int-twitch-form-uri" style="font-size:11px;display:block;padding:6px 8px;background:var(--bg-base,#0d0d1a);border-radius:4px;word-break:break-all;"></code>
                </div>
                <div style="margin-top:12px;">
                  <button id="ac-int-twitch-save" class="ac-btn ac-btn-primary">Save</button>
                </div>
              </div>
              <span id="ac-int-twitch-status" class="ac-status" style="display:none;margin-top:8px;"></span>
              <details class="ac-details" style="margin-top:12px;">
                <summary>Setup instructions</summary>
                <div class="ac-details-body">
                  <ol style="margin:6px 0 0 16px;padding:0;">
                    <li>Go to <a href="https://dev.twitch.tv/console/apps/create" target="_blank" style="color:var(--accent);">Twitch Developer Console → Register Your Application</a></li>
                    <li>Set Category to <strong>Website Integration</strong> and add the Redirect URI above</li>
                    <li>Copy the Client ID and generate a Client Secret, then enter both above and click Save</li>
                  </ol>
                </div>
              </details>
            </div>

          </section>

          <!-- ── Database Management ── -->
          <section id="ac-section-database" class="ac-section">
            <div class="ac-section-header">
              <i data-lucide="database" class="lucide-icon ac-section-icon"></i>
              <div>
                <h2 class="ac-section-title">Database Management</h2>
                <p class="ac-section-desc">Switch between cloud (Supabase) and local (SQLite) storage.</p>
              </div>
            </div>

            <div class="ac-card">
              <div class="ac-card-label">Storage Backend</div>
              <div style="display:flex;gap:10px;margin-top:10px;">
                <button type="button" id="ac-db-seg-cloud" class="ac-seg-btn" style="flex:1;">
                  <i data-lucide="cloud" class="lucide-icon" style="width:18px;height:18px;margin-bottom:4px;"></i><br>
                  Cloud<br><span class="ac-seg-sub">Supabase</span>
                </button>
                <button type="button" id="ac-db-seg-local" class="ac-seg-btn" style="flex:1;">
                  <i data-lucide="monitor" class="lucide-icon" style="width:18px;height:18px;margin-bottom:4px;"></i><br>
                  Local<br><span class="ac-seg-sub">SQLite</span>
                </button>
              </div>
              <div id="ac-db-status" class="ac-hint" style="margin-top:8px;"></div>
              <div class="ac-info-banner" style="margin-top:12px;">
                <strong style="color:var(--accent);">Current Mode:</strong> <span id="ac-db-current-mode">Loading…</span><br>
                <span>Cloud stores data in Supabase (multi-device). Local stores data in <code>app/db/local.db</code> (single-device).</span>
              </div>
            </div>

            <div class="ac-card">
              <div class="ac-card-label">Display Settings</div>
              <div style="display:flex;align-items:center;gap:10px;margin-top:10px;">
                <input type="checkbox" id="ac-db-show-hidden" style="cursor:pointer;width:16px;height:16px;accent-color:var(--accent);">
                <label for="ac-db-show-hidden" style="cursor:pointer;font-size:13px;">Show Hidden Columns</label>
              </div>
              <div class="ac-hint" style="margin-top:6px;">When enabled, you can toggle column visibility in the data view using the eye icon.</div>
            </div>
          </section>

          <!-- ── Optimizer Stats ── -->
          <section id="ac-section-optimizer" class="ac-section">
            <div class="ac-section-header">
              <i data-lucide="zap" class="lucide-icon ac-section-icon"></i>
              <div>
                <h2 class="ac-section-title">Optimizer Stats</h2>
                <p class="ac-section-desc">Session usage statistics and optimizer run configuration.</p>
              </div>
            </div>

            <div class="ac-card">
              <div class="ac-card-label" style="display:flex;align-items:center;gap:8px;">
                Session Manager
                <span id="ac-opt-session-count" style="font-weight:400;font-size:11px;color:var(--fg-muted);">— loading…</span>
              </div>
              <div style="overflow-x:auto;margin-top:10px;border:1px solid var(--border);border-radius:6px;">
                <table id="ac-opt-session-table" class="ac-stats-table">
                  <thead>
                    <tr>
                      <th>Session</th><th>Msgs</th><th>Turns</th><th>Tokens In</th><th>Tokens Out</th><th>Total</th><th>Duration</th><th>Cost</th><th>Active</th><th>Switch</th>
                    </tr>
                  </thead>
                  <tbody id="ac-opt-session-tbody">
                    <tr><td colspan="10" class="ac-table-empty">Loading sessions…</td></tr>
                  </tbody>
                </table>
              </div>
            </div>

            <div class="ac-card">
              <div class="ac-card-label">Run Mode</div>
              <div style="display:flex;gap:8px;margin-top:10px;">
                <button type="button" id="ac-opt-mode-live" class="ac-seg-btn active" data-mode="live" style="flex:1;">
                  <i data-lucide="zap" class="lucide-icon" style="width:16px;height:16px;margin-bottom:4px;"></i><br>
                  Live<br><span class="ac-seg-sub">After every message</span>
                </button>
                <button type="button" id="ac-opt-mode-scheduled" class="ac-seg-btn" data-mode="scheduled" style="flex:1;">
                  <i data-lucide="calendar" class="lucide-icon" style="width:16px;height:16px;margin-bottom:4px;"></i><br>
                  Scheduled<br><span class="ac-seg-sub">On a timer</span>
                </button>
              </div>
            </div>

            <div id="ac-opt-schedule-section" class="ac-card" style="display:none;">
              <div class="ac-card-label">Schedule</div>
              <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:8px;">
                <span class="ac-hint">Run every</span>
                <select id="ac-opt-schedule-interval" class="ac-input" style="width:auto;">
                  <option value="per-interaction">Message</option>
                  <option value="hourly">Hour</option>
                  <option value="daily">Day</option>
                  <option value="weekly">Week</option>
                </select>
                <span class="ac-hint">or when interactions exceed</span>
                <input type="number" id="ac-opt-schedule-min" class="ac-input" value="5" min="1" max="100" style="width:64px;">
              </div>
            </div>

            <div class="ac-card" style="display:flex;gap:10px;align-items:center;justify-content:flex-end;flex-wrap:wrap;">
              <span id="ac-opt-status" class="ac-status" style="flex:1;display:none;"></span>
              <button id="ac-opt-save" class="ac-btn ac-btn-primary">Save Config</button>
              <button id="ac-opt-run-now" class="ac-btn ac-btn-ghost">Run Now</button>
            </div>
          </section>

          <!-- ── Git Providers ── -->
          <section id="ac-section-git" class="ac-section">
            <div class="ac-section-header">
              <i data-lucide="git-branch" class="lucide-icon ac-section-icon"></i>
              <div>
                <h2 class="ac-section-title">Git Providers</h2>
                <p class="ac-section-desc">GitHub token and repository sync configuration.</p>
              </div>
            </div>

            <div class="ac-card">
              <div class="ac-card-label">
                GitHub Token
                <span id="ac-gh-token-configured" style="font-weight:400;font-size:11px;color:var(--fg-muted);margin-left:8px;">—</span>
              </div>
              <div class="ac-field" style="margin-top:10px;">
                <div style="display:flex;gap:8px;">
                  <input type="password" id="ac-gh-token-input" class="ac-input" placeholder="ghp_... or github_pat_..." style="flex:1;">
                  <button id="ac-gh-token-save" class="ac-btn ac-btn-primary" style="flex-shrink:0;">Save</button>
                </div>
                <div id="ac-gh-token-status" class="ac-status" style="display:none;margin-top:6px;"></div>
              </div>
              <details class="ac-details" style="margin-top:12px;">
                <summary>How to create a GitHub token →</summary>
                <div class="ac-details-body">
                  <p><strong>Classic token:</strong></p>
                  <ol>
                    <li>Go to <a href="https://github.com/settings/tokens" target="_blank" style="color:var(--accent);">github.com/settings/tokens</a></li>
                    <li>Click <strong>Generate new token (classic)</strong></li>
                    <li>Select scope: <strong>repo</strong> (full control)</li>
                    <li>Generate and copy the token</li>
                  </ol>
                  <p><strong>Fine-grained token:</strong></p>
                  <ol>
                    <li>Go to <a href="https://github.com/settings/tokens?type=beta" target="_blank" style="color:var(--accent);">tokens (fine-grained)</a></li>
                    <li>Select this repository only</li>
                    <li>Permissions → <strong>Contents: Read and write</strong></li>
                    <li>Generate and copy the token</li>
                  </ol>
                </div>
              </details>
            </div>

            <div class="ac-card">
              <div class="ac-card-label">Repository Status</div>
              <div id="ac-gh-status-area" style="margin-top:10px;">
                <div class="ac-gh-status-grid">
                  <div class="ac-gh-status-item"><span class="ac-gh-label">Branch</span><span id="ac-gh-branch" class="ac-gh-value">—</span></div>
                  <div class="ac-gh-status-item"><span class="ac-gh-label">Remote</span><span id="ac-gh-remote" class="ac-gh-value">—</span></div>
                  <div class="ac-gh-status-item"><span class="ac-gh-label">Last Commit</span><span id="ac-gh-last-commit" class="ac-gh-value">—</span></div>
                  <div class="ac-gh-status-item"><span class="ac-gh-label">Sync</span><span id="ac-gh-ahead-behind" class="ac-gh-value">—</span></div>
                  <div class="ac-gh-status-item"><span class="ac-gh-label">Changed Files</span><span id="ac-gh-file-count" class="ac-gh-value">—</span></div>
                </div>
                <div style="margin-top:10px;display:flex;gap:8px;flex-wrap:wrap;">
                  <button id="ac-gh-refresh" class="ac-btn ac-btn-ghost">↻ Refresh</button>
                  <span id="ac-gh-refresh-result" class="ac-hint"></span>
                </div>
              </div>
            </div>

            <div class="ac-info-banner">
              For full commit/push/pull controls, switch to the <a class="ac-tab-link" data-tab="github">GitHub tab</a>.
            </div>
          </section>

        </div><!-- /app-config-content -->
      </div><!-- /app-config-container -->
    </div><!-- /tab-app-config -->

    <div id="tab-database" class="tab-content">
      <div id="db-viewer">
        <div id="db-toolbar" style="display:none;">
          <button id="db-show-hidden-btn" style="background:var(--bg-elev);border:1px solid var(--border);color:var(--fg-3);padding:4px 8px;border-radius:4px;cursor:pointer;font-size:11px;font-family:inherit;margin-left:auto;display:inline-flex;align-items:center;gap:4px;"><i data-lucide="eye" style="width:12px;height:12px;"></i> Hide hidden</button>
          <span id="db-auto-status"></span>
        </div>
        <div id="db-panel">
          <div style="width:180px;min-width:140px;border-right:1px solid var(--border);display:flex;flex-direction:column;flex-shrink:0;">
            <div style="padding:8px 12px;border-bottom:1px solid var(--border);display:flex;gap:8px;position:relative;align-items:center;min-height:42px;box-sizing:border-box;">
              <button id="db-refresh" style="background:var(--bg-elev);border:1px solid var(--border);color:var(--fg-1);padding:4px 8px;border-radius:4px;cursor:pointer;font-size:11px;font-family:inherit;">↻ Refresh</button>
              <div style="position:relative;">
                <button id="db-reset" style="background:#cc241d;border:1px solid #fb4934;color:#fbf1c7;padding:4px 8px;border-radius:4px;cursor:pointer;font-size:11px;font-family:inherit;">Reset DB ▾</button>
                <div id="db-reset-dropdown" style="display:none;position:absolute;top:100%;left:0;margin-top:4px;background:var(--bg-elev);border:1px solid var(--border);border-radius:4px;padding:8px;z-index:100;min-width:180px;box-shadow:var(--shadow-md);">
                  <div style="font-size:11px;color:var(--fg-1);margin-bottom:8px;font-weight:bold;">Select tables to RESET:</div>
                  <div id="db-reset-options" style="display:flex;flex-direction:column;gap:4px;max-height:200px;overflow-y:auto;margin-bottom:8px;"></div>
                  <button id="db-reset-apply" style="width:100%;background:#cc241d;border:1px solid #fb4934;color:#fbf1c7;padding:4px 8px;border-radius:4px;cursor:pointer;font-size:11px;font-family:inherit;">Confirm Reset</button>
                </div>
              </div>
            </div>
            <div id="db-table-list" style="width:100%;border-right:none;flex:1;"></div>
          </div>
          <div id="db-table-view">
            <div id="db-table-header" style="display:flex;justify-content:space-between;align-items:center;">
              <span style="display:flex;align-items:center;gap:8px;">
                <div id="db-select-wrap" style="position:relative;display:inline-block;">
                  <select id="db-select" title="Switch database" style="position:absolute;width:1px;height:1px;opacity:0;pointer-events:none;">
                    <option value="local.db">local.db</option>
                  </select>
                  <button type="button" id="db-select-trigger" title="Switch database" style="background:var(--bg-elev);border:1px solid var(--border);color:var(--fg-1);padding:0 8px;border-radius:4px;font-size:11px;font-family:inherit;cursor:pointer;max-width:160px;display:inline-flex;align-items:center;gap:6px;height:24px;box-sizing:border-box;">
                    <span id="db-select-label" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:120px;">local.db</span>
                    <span style="color:var(--fg-3);font-size:9px;">▼</span>
                  </button>
                  <ul id="db-select-menu" role="listbox" style="display:none;position:fixed;top:0;left:0;margin:0;padding:4px;list-style:none;background:var(--bg-1);border:1px solid var(--border);border-radius:6px;box-shadow:var(--shadow-md);z-index:9999;min-width:240px;max-height:300px;overflow-y:auto;font-size:11px;"></ul>
                </div>
              </span>
              <span id="db-page-info" style="color:var(--fg-3);font-size:11px;"></span>
              <span style="display:flex;align-items:center;gap:8px;">
                <button id="db-page-prev" style="display:none;background:var(--bg-elev);border:1px solid var(--border);color:var(--fg-1);padding:2px 8px;border-radius:4px;cursor:pointer;font-size:11px;font-family:inherit;"><i data-lucide="chevron-left" style="width:13px;height:13px;"></i></button>
                <button id="db-page-next" style="display:none;background:var(--bg-elev);border:1px solid var(--border);color:var(--fg-1);padding:2px 8px;border-radius:4px;cursor:pointer;font-size:11px;font-family:inherit;"><i data-lucide="chevron-right" style="width:13px;height:13px;"></i></button>
                <button id="db-settings-btn" title="Database View Settings" style="background:var(--bg-elev);border:1px solid var(--border);color:var(--fg-3);padding:0 6px;border-radius:4px;cursor:pointer;font-size:14px;font-family:inherit;height:24px;box-sizing:border-box;display:inline-flex;align-items:center;justify-content:center;line-height:1;"><i data-lucide="settings" style="width:14px;height:14px;"></i></button>
                <button id="db-download-btn" title="Download local.db" style="background:var(--bg-elev);border:1px solid var(--border);color:var(--fg-3);padding:0 6px;border-radius:4px;cursor:pointer;font-size:14px;font-family:inherit;height:24px;box-sizing:border-box;display:inline-flex;align-items:center;justify-content:center;line-height:1;"><i data-lucide="download" style="width:14px;height:14px;"></i></button>
              </span>
            </div>
            <div id="db-table-data">
              <div class="db-hint">Select a table to view its contents</div>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>

  <!-- Chat resize handle -->
  <div id="chat-resize-handle"></div>

  <!-- Chat side -->
  <div id="chat-side">
    <div id="chat-header">
      <span id="header-user-session">
        <span id="session-label">Session:
          <select id="session-select" class="status-select" style="max-width:180px;"></select>
          <button id="session-delete" title="Delete this session" style="background:none;border:none;color:#565f89;cursor:pointer;font-size:14px;padding:0 4px;vertical-align:middle;display:inline-flex;align-items:center;"><i data-lucide="trash-2" style="width:14px;height:14px;"></i></button>
        </span>
      </span>
    </div>
    <div id="chat-messages" class="chat-drop-target">
      <div id="chat-messages-inner">
        <div class="chat-bubble agent">
          <span class="label">Assistant</span>
          Terminal agent ready. Ask me anything — I'll show tool calls in the terminal log.
        </div>
      </div>
      <div id="chat-drop-overlay">
        <span>Drop files here</span>
      </div>
    </div>
    <div id="chat-input-area" class="chat-footer-drop-target">
      <button id="chat-expand-btn" title="Expand input" class="chat-expand-btn">↗</button>
      <div id="chat-preview-bar" style="display:none;"></div>
      <div id="chat-input-row">
        <button id="chat-attach-btn" title="Attach files (or drag & drop onto chat)"><i data-lucide="paperclip" style="width:16px;height:16px;"></i></button>
        <button id="chat-voice-btn" title="Record voice"><i data-lucide="mic" style="width:16px;height:16px;"></i></button>
        <textarea id="chat-input" rows="2" placeholder="Ask the agent... (Enter to send, Shift+Enter for newline)" autocomplete="off"></textarea>
        <button id="chat-send" disabled>Send</button>
        <input type="file" id="chat-file-input" multiple accept="image/*,audio/*,video/*,.pdf,.txt,.md,.csv,.json" hidden>
      </div>
      <div id="chat-footer-drop-overlay">
        <span>Drop files here</span>
      </div>
    </div>
  </div>
</div>

<!-- Chat expand modal (full-screen textarea) -->
<div id="chat-expand-modal">
  <div id="chat-expand-backdrop"></div>
  <div id="chat-expand-panel">
    <div id="chat-expand-header">
      <span id="chat-expand-title">Compose message</span>
      <span id="chat-expand-actions">
        <button id="chat-expand-send" disabled>Send</button>
        <button id="chat-expand-close">&times;</button>
      </span>
    </div>
    <textarea id="chat-expand-editor" spellcheck="false"></textarea>
    <div id="chat-expand-footer">
      <span id="chat-expand-hint">Ctrl+Enter to send &nbsp;·&nbsp; Esc to close</span>
    </div>
  </div>
</div>

<!-- Cell editor modal (double-click popup) -->
<div id="cell-modal">
  <div id="cell-modal-backdrop"></div>
  <div id="cell-modal-panel">
    <div id="cell-modal-header">
      <span id="cell-modal-title">Cell viewer</span>
      <div style="margin-left:auto; display:flex; gap:8px; align-items:center;">
        <button id="cell-modal-edit-toggle" class="status-btn" style="padding: 2px 8px;display:inline-flex;align-items:center;gap:4px;"><i data-lucide="pencil" style="width:12px;height:12px;"></i> Edit</button>
        <button id="cell-modal-close" style="background:none; border:none; color:#565f89; cursor:pointer; font-size:18px; line-height:1;">&times;</button>
      </div>
    </div>
    <div id="cell-modal-viewer"></div>
    <textarea id="cell-modal-editor" spellcheck="false" style="display:none;"></textarea>
  </div>
</div>

<!-- Settings modal -->
<div id="settings-modal" style="display:none;position:fixed;top:0;left:0;right:0;bottom:0;z-index:1000;">
  <div id="settings-backdrop" style="position:absolute;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.6);"></div>
  <div id="settings-panel" style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);background:#1a1a2e;border:1px solid #2a2a4a;border-radius:12px;padding:24px;min-width:380px;max-width:480px;color:#c0caf5;font-size:14px;">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
      <h2 style="margin:0;font-size:18px;font-weight:600;display:inline-flex;align-items:center;gap:6px;"><i data-lucide="settings" style="width:18px;height:18px;"></i> Config</h2>
      <button id="settings-close" style="background:none;border:none;color:#565f89;cursor:pointer;font-size:20px;">&times;</button>
    </div>
    <div style="margin-bottom:16px;">
      <label style="display:block;margin-bottom:6px;color:#a9b1d6;font-size:13px;font-weight:600;">Provider</label>
      <select id="settings-provider" style="width:100%;padding:10px;background:#0d0d1a;border:1px solid #2a2a4a;border-radius:6px;color:#c0caf5;font-size:14px;font-family:inherit;">
        <option value="openrouter">OpenRouter</option>
        <option value="openai">OpenAI</option>
      </select>
    </div>
    <div style="margin-bottom:16px;">
      <label style="display:block;margin-bottom:6px;color:#a9b1d6;font-size:13px;font-weight:600;">Base URL</label>
      <input type="text" id="settings-base-url" placeholder="https://api.openai.com/v1" autocomplete="off" style="width:100%;padding:10px;background:#0d0d1a;border:1px solid #2a2a4a;border-radius:6px;color:#c0caf5;font-size:14px;font-family:inherit;">
      <div style="margin-top:4px;font-size:11px;color:#565f89;">Auto-filled when you pick a provider. Edit for custom endpoints.</div>
    </div>
    <div style="margin-bottom:16px;">
      <label style="display:block;margin-bottom:6px;color:#a9b1d6;font-size:13px;font-weight:600;">API Key</label>
      <input type="text" id="settings-api-key" placeholder="sk-..." style="width:100%;padding:10px;background:#0d0d1a;border:1px solid #2a2a4a;border-radius:6px;color:#c0caf5;font-size:14px;font-family:inherit;">
      <div style="margin-top:4px;font-size:11px;color:#565f89;">Stored on this device only. Never sent elsewhere.</div>
    </div>
    <div id="settings-model-group" style="margin-bottom:20px;">
      <label style="display:block;margin-bottom:6px;color:#a9b1d6;font-size:13px;font-weight:600;">Model</label>
      <div style="position:relative;">
        <input type="text" id="settings-model-search" placeholder="Search models..." autocomplete="off" style="width:100%;padding:10px;background:#0d0d1a;border:1px solid #2a2a4a;border-radius:6px;color:#c0caf5;font-size:14px;font-family:inherit;box-sizing:border-box;">
        <div id="settings-model-dropdown" style="display:none;position:absolute;top:100%;left:0;right:0;max-height:260px;overflow-y:auto;background:#16161e;border:1px solid #2a2a4a;border-radius:0 0 6px 6px;z-index:10;box-shadow:0 8px 24px rgba(0,0,0,0.4);"></div>
      </div>
      <div id="settings-model-status" style="margin-top:4px;font-size:11px;color:#565f89;"></div>
    </div>

    <div style="display:flex;gap:8px;margin-bottom:16px;">
      <button id="settings-save" style="flex:1;padding:10px;background:#7dcfff;border:none;border-radius:6px;color:#0d0d1a;font-size:14px;font-weight:600;cursor:pointer;">Save</button>
      <button id="settings-clear" style="flex:0 0 auto;padding:10px 16px;background:transparent;border:1px solid #565f89;border-radius:6px;color:#565f89;font-size:13px;cursor:pointer;">Clear</button>
    </div>
    <div id="settings-status" style="margin-bottom:8px;font-size:12px;color:#9ece6a;display:none;"></div>

    <!-- ── Saved Providers List ── -->
    <div id="settings-saved-list" style="display:flex;flex-direction:column;gap:6px;">
      <!-- JS will populate rows here -->
    </div>
  </div>
</div>

<!-- Database modal -->
<div id="database-modal" style="display:none;position:fixed;top:0;left:0;right:0;bottom:0;z-index:1000;">
  <div id="database-backdrop" style="position:absolute;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.6);"></div>
  <div id="database-panel" style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);background:#1a1a2e;border:1px solid #2a2a4a;border-radius:12px;padding:24px;min-width:400px;max-width:480px;color:#c0caf5;font-size:14px;">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
      <h2 style="margin:0;font-size:18px;font-weight:600;display:inline-flex;align-items:center;gap:6px;"><i data-lucide="database" style="width:18px;height:18px;"></i> Database</h2>
      <button id="database-close" style="background:none;border:none;color:#565f89;cursor:pointer;font-size:20px;">&times;</button>
    </div>

    <div style="margin-bottom:20px;">
      <label style="display:block;margin-bottom:8px;color:#a9b1d6;font-size:13px;font-weight:600;">Storage Backend</label>
      <div style="display:flex;gap:8px;">
        <button type="button" id="modal-seg-cloud" class="submenu-item" style="flex:1;text-align:center;padding:12px;border:2px solid #2a2a4a;border-radius:8px;background:#0d0d1a;font-size:13px;font-weight:600;cursor:pointer;color:#c0caf5;font-family:inherit;transition:all 0.15s;"><i data-lucide="cloud" style="width:16px;height:16px;margin-bottom:4px;"></i><br>Cloud<br><span style="font-weight:400;font-size:11px;color:#565f89;">Supabase</span></button>
        <button type="button" id="modal-seg-local" class="submenu-item" style="flex:1;text-align:center;padding:12px;border:2px solid #2a2a4a;border-radius:8px;background:#0d0d1a;font-size:13px;font-weight:600;cursor:pointer;color:#c0caf5;font-family:inherit;transition:all 0.15s;"><i data-lucide="monitor" style="width:16px;height:16px;margin-bottom:4px;"></i><br>Local<br><span style="font-weight:400;font-size:11px;color:#565f89;">SQLite</span></button>
      </div>
      <div id="database-modal-status" style="margin-top:8px;font-size:12px;color:#565f89;"></div>
    </div>

    <!-- DB UI Settings -->
    <div style="margin-bottom:20px;padding:16px;background:#0d0d1a;border-radius:8px;border:1px solid #2a2a4a;">
      <label style="display:block;margin-bottom:12px;color:#a9b1d6;font-size:13px;font-weight:600;">Display Settings</label>
      <div style="display:flex;align-items:center;gap:10px;">
        <input type="checkbox" id="db-setting-show-hidden" style="cursor:pointer;width:16px;height:16px;accent-color:#7dcfff;">
        <label for="db-setting-show-hidden" style="cursor:pointer;color:#c0caf5;font-size:13px;">Show Hidden Columns</label>
      </div>
      <div style="margin-top:6px;font-size:11px;color:#565f89;">
        When enabled, you can toggle visibility of individual columns in the data view using the eye icon.
      </div>
    </div>

    <div style="padding:12px;background:#0d0d1a;border-radius:8px;border-left:3px solid #7dcfff;font-size:12px;color:#a9b1d6;">
      <strong style="color:#7dcfff;">Current Mode:</strong> <span id="database-current-mode">Loading...</span><br>
      <span style="color:#565f89;">Cloud stores data in Supabase (multi-device). Local stores data in <code>app/db/local.db</code> (single-device).</span>
    </div>

    <div style="text-align:right;margin-top:20px;">
      <button id="database-close-btn" style="padding:8px 20px;background:transparent;border:1px solid #565f89;border-radius:6px;color:#565f89;font-size:13px;cursor:pointer;">Close</button>
    </div>
  </div>
</div>

<!-- Optimizer modal -->
<div id="optimizer-modal" style="display:none;position:fixed;top:0;left:0;right:0;bottom:0;z-index:1000;">
  <div id="optimizer-backdrop" style="position:absolute;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.6);"></div>
  <div id="optimizer-panel" style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);background:#1a1a2e;border:1px solid #2a2a4a;border-radius:12px;padding:24px;width:900px;max-width:95vw;max-height:85vh;overflow-y:auto;color:#c0caf5;font-size:14px;">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
      <h2 style="margin:0;font-size:18px;font-weight:600;display:inline-flex;align-items:center;gap:6px;"><i data-lucide="zap" style="width:18px;height:18px;"></i> Optimizer</h2>
      <button id="optimizer-close" style="background:none;border:none;color:#565f89;cursor:pointer;font-size:20px;">&times;</button>
    </div>

    <!-- SESSION MANAGER -->
    <div style="margin-bottom:20px;">
      <label style="display:block;margin-bottom:8px;color:#a9b1d6;font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:0.5px;">
        <i data-lucide="clipboard-list" style="width:12px;height:12px;margin-right:4px;vertical-align:middle;"></i> Session Manager
        <span id="opt-session-count" style="font-weight:400;font-size:11px;color:#565f89;text-transform:none;letter-spacing:0;">— loading...</span>
      </label>
      <div style="padding:0;background:#0d0d1a;border:1px solid #2a2a4a;border-radius:8px;overflow:hidden;">
        <div style="overflow-x:auto;">
          <table id="opt-session-table" style="width:100%;border-collapse:collapse;font-size:11px;">
            <thead>
              <tr style="background:#0d0d1a;border-bottom:1px solid #2a2a4a;">
                <th style="padding:8px 10px;text-align:left;color:#a9b1d6;font-weight:600;white-space:nowrap;">Session</th>
                <th style="padding:8px 10px;text-align:center;color:#a9b1d6;font-weight:600;white-space:nowrap;">Msgs</th>
                <th style="padding:8px 10px;text-align:center;color:#a9b1d6;font-weight:600;white-space:nowrap;">Turns</th>
                <th style="padding:8px 10px;text-align:right;color:#a9b1d6;font-weight:600;white-space:nowrap;">Tokens In</th>
                <th style="padding:8px 10px;text-align:right;color:#a9b1d6;font-weight:600;white-space:nowrap;">Tokens Out</th>
                <th style="padding:8px 10px;text-align:right;color:#a9b1d6;font-weight:600;white-space:nowrap;">Total</th>
                <th style="padding:8px 10px;text-align:right;color:#a9b1d6;font-weight:600;white-space:nowrap;">Duration</th>
                <th style="padding:8px 10px;text-align:right;color:#a9b1d6;font-weight:600;white-space:nowrap;">Cost</th>
                <th style="padding:8px 10px;text-align:left;color:#a9b1d6;font-weight:600;white-space:nowrap;">Active</th>
                <th style="padding:8px 10px;text-align:center;color:#a9b1d6;font-weight:600;white-space:nowrap;">Switch</th>
              </tr>
            </thead>
            <tbody id="opt-session-tbody">
              <tr><td colspan="10" style="padding:24px;text-align:center;color:#565f89;">Loading sessions...</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- MODE SELECTOR -->
    <div style="margin-bottom:20px;">
      <label style="display:block;margin-bottom:8px;color:#a9b1d6;font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:0.5px;">Run Mode</label>
      <div style="display:flex;gap:8px;">
        <button type="button" id="opt-mode-live" class="opt-mode-btn" data-mode="live" style="flex:1;padding:14px 12px;border:2px solid #7dcfff;border-radius:8px;background:rgba(125,207,255,0.08);cursor:pointer;color:#c0caf5;font-family:inherit;font-size:13px;font-weight:600;transition:all 0.15s;">
          <i data-lucide="zap" style="width:16px;height:16px;margin-bottom:4px;"></i><br>Live<br><span style="font-weight:400;font-size:11px;color:#a9b1d6;display:block;margin-top:4px;">After every message</span>
        </button>
        <button type="button" id="opt-mode-scheduled" class="opt-mode-btn" data-mode="scheduled" style="flex:1;padding:14px 12px;border:2px solid #2a2a4a;border-radius:8px;background:transparent;cursor:pointer;color:#565f89;font-family:inherit;font-size:13px;font-weight:600;transition:all 0.15s;">
          <i data-lucide="calendar" style="width:16px;height:16px;margin-bottom:4px;"></i><br>Scheduled<br><span style="font-weight:400;font-size:11px;color:#565f89;display:block;margin-top:4px;">On a timer</span>
        </button>
      </div>
    </div>

    <!-- SCHEDULE CONFIG (hidden in live mode) -->
    <div id="opt-schedule-section" style="display:none;margin-bottom:20px;padding:12px;background:#0d0d1a;border-radius:8px;border:1px solid #2a2a4a;">
      <label style="display:block;margin-bottom:8px;color:#a9b1d6;font-size:12px;font-weight:600;">Schedule</label>
      <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
        <span style="font-size:12px;color:#565f89;">Run every</span>
        <select id="opt-schedule-interval" style="padding:8px;background:#0d0d1a;border:1px solid #2a2a4a;border-radius:6px;color:#c0caf5;font-size:13px;font-family:inherit;">
          <option value="per-interaction">Message</option>
          <option value="hourly">Hour</option>
          <option value="daily">Day</option>
          <option value="weekly">Week</option>
        </select>
        <span style="font-size:12px;color:#565f89;">after at least</span>
        <input type="number" id="opt-schedule-min-interactions" value="10" min="1" max="1000" style="width:60px;padding:8px;background:#0d0d1a;border:1px solid #2a2a4a;border-radius:6px;color:#c0caf5;font-size:13px;font-family:inherit;">
        <span style="font-size:12px;color:#565f89;">interactions</span>
      </div>
    </div>

    <!-- USER FEEDBACK MODE -->
    <div style="margin-bottom:20px;">
      <label style="display:block;margin-bottom:8px;color:#a9b1d6;font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:0.5px;">User Feedback</label>
      <div style="display:flex;gap:8px;">
        <button type="button" id="opt-feedback-always" class="opt-feedback-btn" data-feedback="always" style="flex:1;padding:12px 8px;border:2px solid #7dcfff;border-radius:8px;background:rgba(125,207,255,0.08);cursor:pointer;color:#c0caf5;font-family:inherit;font-size:12px;font-weight:600;transition:all 0.15s;text-align:center;">
          <i data-lucide="message-circle" style="width:15px;height:15px;margin-bottom:3px;"></i><br>Always ask<br><span style="font-weight:400;font-size:10px;color:#a9b1d6;display:block;margin-top:2px;">After every task</span>
        </button>
        <button type="button" id="opt-feedback-failure" class="opt-feedback-btn" data-feedback="failure" style="flex:1;padding:12px 8px;border:2px solid #2a2a4a;border-radius:8px;background:transparent;cursor:pointer;color:#565f89;font-family:inherit;font-size:12px;font-weight:600;transition:all 0.15s;text-align:center;">
          <i data-lucide="alert-triangle" style="width:15px;height:15px;margin-bottom:3px;"></i><br>On failure<br><span style="font-weight:400;font-size:10px;color:#565f89;display:block;margin-top:2px;">Only when something breaks</span>
        </button>
        <button type="button" id="opt-feedback-never" class="opt-feedback-btn" data-feedback="never" style="flex:1;padding:12px 8px;border:2px solid #2a2a4a;border-radius:8px;background:transparent;cursor:pointer;color:#565f89;font-family:inherit;font-size:12px;font-weight:600;transition:all 0.15s;text-align:center;">
          <i data-lucide="volume-x" style="width:15px;height:15px;margin-bottom:3px;"></i><br>Never<br><span style="font-weight:400;font-size:10px;color:#565f89;display:block;margin-top:2px;">Silent optimization</span>
        </button>
      </div>
      <div style="margin-top:6px;font-size:10px;color:#565f89;">
        When enabled, agent asks "How was that?" after tasks. Your feedback guides future optimizations — e.g. "too verbose," "missed Linda's deadline," "wrong format."
      </div>
    </div>

    <!-- OPTIMIZATION VOLUME -->
    <div style="margin-bottom:20px;">
      <label style="display:block;margin-bottom:8px;color:#a9b1d6;font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:0.5px;">Optimization Intensity</label>
      <div style="padding:14px;background:#0d0d1a;border-radius:8px;border:1px solid #2a2a4a;">
        <div style="display:flex;align-items:center;gap:12px;margin-bottom:8px;">
          <span style="font-size:11px;color:#565f89;min-width:20px;">1</span>
          <input type="range" id="opt-intensity" min="1" max="5" value="3" style="flex:1;height:8px;-webkit-appearance:none;appearance:none;background:linear-gradient(to right, #9ece6a, #e0af68, #fb4934);border-radius:4px;outline:none;cursor:pointer;">
          <span style="font-size:11px;color:#565f89;min-width:20px;text-align:right;">5</span>
        </div>
        <div style="display:flex;justify-content:space-between;font-size:10px;color:#565f89;margin-bottom:8px;">
          <span>Conservative</span><span>Balanced</span><span>Aggressive</span>
        </div>
        <div id="opt-intensity-label" style="font-size:11px;color:#e0af68;text-align:center;padding:6px;background:rgba(224,175,104,0.08);border-radius:4px;">
          Balanced — optimize when ≥10% improvement expected. Standard thresholds. Moderate validation.
        </div>
      </div>
    </div>

    <!-- TWO-COLUMN: METRICS + MODELS -->
    <div style="margin-bottom:20px;">
      <label style="display:block;margin-bottom:8px;color:#a9b1d6;font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:0.5px;">Trials Per Change</label>
      <div style="padding:14px;background:#0d0d1a;border-radius:8px;border:1px solid #2a2a4a;display:flex;align-items:center;justify-content:space-between;">
        <div style="font-size:12px;color:#9aa5ce;">Number of worker trials run for each proposed change:</div>
        <input type="number" id="opt-trials-per-change" value="2" min="1" max="20" style="width:60px;padding:6px;background:#1a1a2e;border:1px solid #2a2a4a;border-radius:4px;color:#c0caf5;font-size:13px;font-family:inherit;">
      </div>
    </div>

    <div style="display:flex;gap:16px;margin-bottom:20px;flex-wrap:wrap;">

      <!-- TARGET METRICS -->
      <div style="flex:1;min-width:280px;">
        <label style="display:block;margin-bottom:8px;color:#a9b1d6;font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:0.5px;">Target Metrics</label>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:6px;">
          <div class="opt-metric-card active" data-metric="turns" style="padding:10px;background:#0d0d1a;border:1px solid #7dcfff;border-radius:6px;cursor:pointer;user-select:none;transition:all 0.15s;">
            <div style="font-size:13px;font-weight:600;color:#c0caf5;display:flex;align-items:center;gap:5px;"><i data-lucide="refresh-cw" style="width:13px;height:13px;"></i> Turn Count</div>
            <div style="font-size:10px;color:#565f89;margin-top:2px;">Fewer turns per task</div>
          </div>
          <div class="opt-metric-card active" data-metric="tokens" style="padding:10px;background:#0d0d1a;border:1px solid #7dcfff;border-radius:6px;cursor:pointer;user-select:none;transition:all 0.15s;">
            <div style="font-size:13px;font-weight:600;color:#c0caf5;display:flex;align-items:center;gap:5px;"><i data-lucide="coins" style="width:13px;height:13px;"></i> Token Usage</div>
            <div style="font-size:10px;color:#565f89;margin-top:2px;">Cheaper LLM calls</div>
          </div>
          <div class="opt-metric-card active" data-metric="time" style="padding:10px;background:#0d0d1a;border:1px solid #7dcfff;border-radius:6px;cursor:pointer;user-select:none;transition:all 0.15s;">
            <div style="font-size:13px;font-weight:600;color:#c0caf5;display:flex;align-items:center;gap:5px;"><i data-lucide="timer" style="width:13px;height:13px;"></i> Response Time</div>
            <div style="font-size:10px;color:#565f89;margin-top:2px;">Faster replies</div>
          </div>
          <div class="opt-metric-card active" data-metric="failures" style="padding:10px;background:#0d0d1a;border:1px solid #7dcfff;border-radius:6px;cursor:pointer;user-select:none;transition:all 0.15s;">
            <div style="font-size:13px;font-weight:600;color:#c0caf5;display:flex;align-items:center;gap:5px;"><i data-lucide="x-circle" style="width:13px;height:13px;"></i> Failure Rate</div>
            <div style="font-size:10px;color:#565f89;margin-top:2px;">Fewer errors</div>
          </div>
          <div class="opt-metric-card active" data-metric="rating" style="padding:10px;background:#0d0d1a;border:1px solid #7dcfff;border-radius:6px;cursor:pointer;user-select:none;transition:all 0.15s;">
            <div style="font-size:13px;font-weight:600;color:#c0caf5;display:flex;align-items:center;gap:5px;"><i data-lucide="star" style="width:13px;height:13px;"></i> User Rating</div>
            <div style="font-size:10px;color:#565f89;margin-top:2px;">Happier outcomes</div>
          </div>
          <div class="opt-metric-card" data-metric="size" style="padding:10px;background:#0d0d1a;border:1px solid #2a2a4a;border-radius:6px;cursor:pointer;user-select:none;transition:all 0.15s;">
            <div style="font-size:13px;font-weight:600;color:#565f89;display:flex;align-items:center;gap:5px;"><i data-lucide="ruler" style="width:13px;height:13px;"></i> Skill Size</div>
            <div style="font-size:10px;color:#565f89;margin-top:2px;">Smaller instructions</div>
          </div>
        </div>
      </div>

      <!-- MODELS PER ROLE -->
      <div style="flex:1;min-width:280px;">
        <label style="display:block;margin-bottom:8px;color:#a9b1d6;font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:0.5px;">Models per Role</label>
        <div style="padding:10px;background:#0d0d1a;border:1px solid #2a2a4a;border-radius:6px;">
          <div style="display:flex;align-items:center;justify-content:space-between;padding:8px 0;border-bottom:1px solid #1a1a2e;">
            <div>
              <span style="font-size:12px;font-weight:600;color:#c0caf5;display:inline-flex;align-items:center;gap:4px;"><i data-lucide="search" style="width:12px;height:12px;"></i> Analyzer</span>
              <span style="font-size:10px;color:#565f89;display:block;">Scans stats, ranks skills</span>
            </div>
            <select id="opt-model-analyzer" style="padding:6px 8px;background:#1a1a2e;border:1px solid #2a2a4a;border-radius:4px;color:#c0caf5;font-size:12px;font-family:inherit;max-width:160px;">
              <option value="gpt-4o-mini">gpt-4o-mini</option>
              <option value="claude-haiku">claude-haiku</option>
              <option value="gemini-flash">gemini-flash</option>
            </select>
          </div>
          <div style="display:flex;align-items:center;justify-content:space-between;padding:8px 0;border-bottom:1px solid #1a1a2e;">
            <div>
              <span style="font-size:12px;font-weight:600;color:#c0caf5;display:inline-flex;align-items:center;gap:4px;"><i data-lucide="pen-line" style="width:12px;height:12px;"></i> Proposer</span>
              <span style="font-size:10px;color:#e0af68;display:block;">Writes improved code</span>
            </div>
            <select id="opt-model-proposer" style="padding:6px 8px;background:#1a1a2e;border:1px solid #2a2a4a;border-radius:4px;color:#e0af68;font-size:12px;font-family:inherit;max-width:160px;">
              <option value="gpt-4o">gpt-4o</option>
              <option value="claude-opus">claude-opus</option>
              <option value="claude-sonnet">claude-sonnet</option>
              <option value="gemini-pro">gemini-pro</option>
            </select>
          </div>
          <div style="display:flex;align-items:center;justify-content:space-between;padding:8px 0;">
            <div>
              <span style="font-size:12px;font-weight:600;color:#c0caf5;display:inline-flex;align-items:center;gap:4px;"><i data-lucide="check-square" style="width:12px;height:12px;"></i> Validator</span>
              <span style="font-size:10px;color:#565f89;display:block;">Replays history</span>
            </div>
            <select id="opt-model-validator" style="padding:6px 8px;background:#1a1a2e;border:1px solid #2a2a4a;border-radius:4px;color:#c0caf5;font-size:12px;font-family:inherit;max-width:160px;">
              <option value="gpt-4o-mini">gpt-4o-mini</option>
              <option value="claude-haiku">claude-haiku</option>
              <option value="gemini-flash">gemini-flash</option>
            </select>
          </div>
        </div>
      </div>

    </div>

    <!-- SCAN SOURCES -->
    <div style="margin-bottom:20px;">
      <label style="display:block;margin-bottom:8px;color:#a9b1d6;font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:0.5px;">Scan Sources</label>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
        <div class="opt-metric-card active" data-source="skills" style="padding:10px;background:#0d0d1a;border:1px solid #7dcfff;border-radius:6px;cursor:pointer;user-select:none;transition:all 0.15s;">
          <div style="font-size:12px;font-weight:600;color:#c0caf5;display:flex;align-items:center;gap:4px;"><i data-lucide="wrench" style="width:12px;height:12px;"></i> Skills</div>
          <div style="font-size:9px;color:#565f89;margin-top:2px;">Custom tools + behavioral instructions</div>
        </div>
        <div class="opt-metric-card active" data-source="core_tools" style="padding:10px;background:#0d0d1a;border:1px solid #7dcfff;border-radius:6px;cursor:pointer;user-select:none;transition:all 0.15s;">
          <div style="font-size:12px;font-weight:600;color:#c0caf5;display:flex;align-items:center;gap:4px;"><i data-lucide="settings" style="width:12px;height:12px;"></i> Core Tools</div>
          <div style="font-size:9px;color:#565f89;margin-top:2px;">get_time, http_request, web_search</div>
        </div>
        <div class="opt-metric-card active" data-source="llm_patterns" style="padding:10px;background:#0d0d1a;border:1px solid #7dcfff;border-radius:6px;cursor:pointer;user-select:none;transition:all 0.15s;">
          <div style="font-size:12px;font-weight:600;color:#c0caf5;display:flex;align-items:center;gap:4px;"><i data-lucide="repeat" style="width:12px;height:12px;"></i> LLM Patterns</div>
          <div style="font-size:9px;color:#565f89;margin-top:2px;">Repetition, loops, tool storms</div>
        </div>
        <div class="opt-metric-card active" data-source="user_prefs" style="padding:10px;background:#0d0d1a;border:1px solid #7dcfff;border-radius:6px;cursor:pointer;user-select:none;transition:all 0.15s;">
          <div style="font-size:12px;font-weight:600;color:#c0caf5;display:flex;align-items:center;gap:4px;"><i data-lucide="user" style="width:12px;height:12px;"></i> User Prefs</div>
          <div style="font-size:9px;color:#565f89;margin-top:2px;">"I prefer X", "don't use Y"</div>
        </div>
      </div>
      <div style="margin-top:6px;font-size:10px;color:#565f89;">
        Choose what gets analyzed. Skills = custom tools. Core Tools = built-ins. LLM Patterns = repetition/loops. User Prefs = preference signals in your messages.
      </div>
    </div>

    <!-- SCOPE -->
    <div style="margin-bottom:20px;">
      <label style="display:block;margin-bottom:8px;color:#a9b1d6;font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:0.5px;">Scope</label>
      <div style="display:flex;gap:12px;flex-wrap:wrap;">
        <div style="flex:1;min-width:260px;padding:12px;background:#0d0d1a;border:1px solid #2a2a4a;border-radius:6px;">
          <div style="font-size:12px;font-weight:600;color:#7dcfff;margin-bottom:8px;display:flex;align-items:center;gap:4px;"><i data-lucide="globe" style="width:12px;height:12px;"></i> App-Wide (All Users)</div>
          <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;font-size:11px;color:#a9b1d6;">
            <span>Min</span>
            <input type="number" id="opt-scope-app-sample" value="100" min="5" max="10000" style="width:60px;padding:6px;background:#1a1a2e;border:1px solid #2a2a4a;border-radius:4px;color:#c0caf5;font-size:11px;font-family:inherit;">
            <span>executions</span>
            <span style="margin-left:8px;">min</span>
            <input type="number" id="opt-scope-app-age" value="14" min="1" max="90" style="width:50px;padding:6px;background:#1a1a2e;border:1px solid #2a2a4a;border-radius:4px;color:#c0caf5;font-size:11px;font-family:inherit;">
            <span>days old</span>
          </div>
          <div style="margin-top:6px;font-size:10px;color:#565f89;">Optimizes official skills shared across all users</div>
        </div>
        <div style="flex:1;min-width:260px;padding:12px;background:#0d0d1a;border:1px solid #2a2a4a;border-radius:6px;">
          <div style="font-size:12px;font-weight:600;color:#9ece6a;margin-bottom:8px;display:flex;align-items:center;gap:4px;"><i data-lucide="user" style="width:12px;height:12px;"></i> Per-User (Personal)</div>
          <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;font-size:11px;color:#a9b1d6;">
            <span>Min</span>
            <input type="number" id="opt-scope-user-sample" value="10" min="3" max="1000" style="width:50px;padding:6px;background:#1a1a2e;border:1px solid #2a2a4a;border-radius:4px;color:#c0caf5;font-size:11px;font-family:inherit;">
            <span>executions</span>
            <span style="margin-left:8px;">min</span>
            <input type="number" id="opt-scope-user-age" value="3" min="1" max="30" style="width:45px;padding:6px;background:#1a1a2e;border:1px solid #2a2a4a;border-radius:4px;color:#c0caf5;font-size:11px;font-family:inherit;">
            <span>days old</span>
          </div>
          <div style="margin-top:6px;font-size:10px;color:#565f89;">Optimizes this user's personal and forked skills</div>
        </div>
      </div>
    </div>

    <!-- WHAT WOULD CHANGE (skill preview) -->
    <div style="margin-bottom:20px;">
      <label style="display:block;margin-bottom:8px;color:#a9b1d6;font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:0.5px;">What Would Change</label>
      <div id="opt-preview" style="padding:12px;background:#0d0d1a;border:1px solid #2a2a4a;border-radius:6px;font-size:12px;max-height:180px;overflow-y:auto;">
        <div style="display:flex;justify-content:space-between;align-items:center;padding:6px 0;border-bottom:1px solid #1a1a2e;">
          <span style="color:#c0caf5;display:inline-flex;align-items:center;gap:4px;"><i data-lucide="mail" style="width:11px;height:11px;"></i> send-email</span>
          <span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:#e0af68;margin-right:6px;"></span>
          <span style="color:#e0af68;font-size:11px;">degraded</span>
          <span style="color:#565f89;font-size:11px;">connect Gmail → personal sender</span>
        </div>
        <div style="display:flex;justify-content:space-between;align-items:center;padding:6px 0;border-bottom:1px solid #1a1a2e;">
          <span style="color:#c0caf5;display:inline-flex;align-items:center;gap:4px;"><i data-lucide="mail" style="width:11px;height:11px;"></i> send-email</span>
          <span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:#fb4934;margin-right:6px;"></span>
          <span style="color:#fb4934;font-size:11px;">15% failure</span>
          <span style="color:#565f89;font-size:11px;">→ add retry, drop to ~3%</span>
        </div>
        <div style="display:flex;justify-content:space-between;align-items:center;padding:6px 0;border-bottom:1px solid #1a1a2e;">
          <span style="color:#c0caf5;display:inline-flex;align-items:center;gap:4px;"><i data-lucide="image" style="width:11px;height:11px;"></i> process-image</span>
          <span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:#9ece6a;margin-right:6px;"></span>
          <span style="color:#9ece6a;font-size:11px;">Good</span>
          <span style="color:#565f89;font-size:11px;">—</span>
        </div>
        <div style="display:flex;justify-content:space-between;align-items:center;padding:6px 0;border-bottom:1px solid #1a1a2e;">
          <span style="color:#c0caf5;display:inline-flex;align-items:center;gap:4px;"><i data-lucide="calendar" style="width:11px;height:11px;"></i> check-calendar</span>
          <span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:#e0af68;margin-right:6px;"></span>
          <span style="color:#e0af68;font-size:11px;">4.2 turns avg</span>
          <span style="color:#565f89;font-size:11px;">→ consolidate, -40%</span>
        </div>
        <div style="display:flex;justify-content:space-between;align-items:center;padding:6px 0;">
          <span style="color:#c0caf5;display:inline-flex;align-items:center;gap:4px;"><i data-lucide="file-text" style="width:11px;height:11px;"></i> take-note</span>
          <span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:#9ece6a;margin-right:6px;"></span>
          <span style="color:#9ece6a;font-size:11px;">Good</span>
          <span style="color:#565f89;font-size:11px;">—</span>
        </div>
        <div style="display:flex;justify-content:space-between;align-items:center;padding:6px 0;">
          <span style="color:#565f89;display:inline-flex;align-items:center;gap:4px;"><i data-lucide="lock" style="width:11px;height:11px;"></i> check-slack</span>
          <span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:#565f89;margin-right:6px;"></span>
          <span style="color:#565f89;font-size:11px;">blocked</span>
          <span style="color:#7dcfff;font-size:11px;cursor:pointer;">[Connect Slack]</span>
        </div>
      </div>
      <div style="margin-top:6px;font-size:10px;color:#565f89;text-align:center;">Preview based on current interaction data. Updates as config changes.</div>
    </div>

    <!-- WORKFLOW DIAGRAM -->
    <div style="margin-bottom:20px;">
      <label style="display:block;margin-bottom:8px;color:#a9b1d6;font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:0.5px;">Workflow</label>
      <div style="padding:16px 8px;background:#0d0d1a;border:1px solid #2a2a4a;border-radius:6px;overflow-x:auto;">
        <div id="opt-workflow" style="display:flex;align-items:center;justify-content:center;gap:0;min-width:560px;flex-wrap:nowrap;">
          <div class="opt-wf-step" data-step="msg" style="padding:10px 12px;background:#1a1a2e;border:1px solid #2a2a4a;border-radius:6px;text-align:center;font-size:11px;color:#c0caf5;min-width:70px;transition:all 0.15s;">
            <div style="display:flex;justify-content:center;margin-bottom:4px;"><i data-lucide="message-circle" style="width:14px;height:14px;"></i></div>
            <div style="font-weight:600;">User Msg</div>
          </div>
          <div class="opt-wf-arrow" style="padding:0 3px;color:#2a2a4a;font-size:14px;">▸</div>
          <div class="opt-wf-step" data-step="analyzer" style="padding:10px 12px;background:#1a1a2e;border:1px solid #2a2a4a;border-radius:6px;text-align:center;font-size:11px;color:#c0caf5;min-width:70px;transition:all 0.15s;">
            <div style="display:flex;justify-content:center;margin-bottom:4px;"><i data-lucide="search" style="width:14px;height:14px;"></i></div>
            <div style="font-weight:600;">Analyzer</div>
          </div>
          <div class="opt-wf-arrow" style="padding:0 3px;color:#2a2a4a;font-size:14px;">▸</div>
          <div class="opt-wf-step" data-step="proposer" style="padding:10px 12px;background:#1a1a2e;border:1px solid #2a2a4a;border-radius:6px;text-align:center;font-size:11px;color:#c0caf5;min-width:70px;transition:all 0.15s;">
            <div style="display:flex;justify-content:center;margin-bottom:4px;"><i data-lucide="pen-line" style="width:14px;height:14px;"></i></div>
            <div style="font-weight:600;">Proposer</div>
          </div>
          <div class="opt-wf-arrow" style="padding:0 3px;color:#2a2a4a;font-size:14px;">▸</div>
          <div class="opt-wf-step" data-step="validator" style="padding:10px 12px;background:#1a1a2e;border:1px solid #2a2a4a;border-radius:6px;text-align:center;font-size:11px;color:#c0caf5;min-width:70px;transition:all 0.15s;">
            <div style="display:flex;justify-content:center;margin-bottom:4px;"><i data-lucide="check-square" style="width:14px;height:14px;"></i></div>
            <div style="font-weight:600;">Validator</div>
          </div>
          <div class="opt-wf-arrow" style="padding:0 3px;color:#2a2a4a;font-size:14px;">▸</div>
          <div class="opt-wf-step" data-step="deployer" style="padding:10px 12px;background:#1a1a2e;border:1px solid #2a2a4a;border-radius:6px;text-align:center;font-size:11px;color:#c0caf5;min-width:70px;transition:all 0.15s;">
            <div style="display:flex;justify-content:center;margin-bottom:4px;"><i data-lucide="package" style="width:14px;height:14px;"></i></div>
            <div style="font-weight:600;">Deployer</div>
          </div>
          <div class="opt-wf-arrow" style="padding:0 3px;color:#2a2a4a;font-size:14px;">▸</div>
          <div class="opt-wf-step" data-step="skill" style="padding:10px 12px;background:#1a1a2e;border:1px solid #2a2a4a;border-radius:6px;text-align:center;font-size:11px;color:#c0caf5;min-width:80px;transition:all 0.15s;">
            <div style="display:flex;justify-content:center;margin-bottom:4px;"><i data-lucide="sparkles" style="width:14px;height:14px;"></i></div>
            <div style="font-weight:600;">Skill v2</div>
          </div>
        </div>
        <div id="opt-workflow-labels" style="display:flex;justify-content:center;gap:0;margin-top:8px;font-size:9px;color:#565f89;min-width:560px;">
          <span style="min-width:70px;text-align:center;">triggers</span>
          <span style="min-width:16px;"></span>
          <span style="min-width:70px;text-align:center;">reads DB</span>
          <span style="min-width:16px;"></span>
          <span style="min-width:70px;text-align:center;">generates v2</span>
          <span style="min-width:16px;"></span>
          <span style="min-width:70px;text-align:center;">replays</span>
          <span style="min-width:16px;"></span>
          <span style="min-width:70px;text-align:center;">writes to DB</span>
          <span style="min-width:16px;"></span>
          <span style="min-width:80px;text-align:center;">next msg uses v2</span>
        </div>
      </div>
    </div>

    <!-- ACTIVITY LOG (collapsed) -->
    <div style="margin-bottom:20px;">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;">
        <label style="color:#a9b1d6;font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:0.5px;">Activity Log</label>
        <button id="opt-toggle-log" style="background:none;border:none;color:#7dcfff;cursor:pointer;font-size:11px;font-family:inherit;">Show ▾</button>
      </div>
      <div id="opt-activity-log" style="display:none;padding:8px;background:#0d0d1a;border:1px solid #2a2a4a;border-radius:6px;font-size:11px;max-height:120px;overflow-y:auto;">
        <div style="padding:4px 0;border-bottom:1px solid #1a1a2e;">
          <span style="color:#9ece6a;">✓</span>
          <span style="color:#565f89;">12min ago</span>
          <span style="color:#c0caf5;">Optimized send-email</span>
          <span style="color:#9ece6a;">-15% tokens, -22% time</span>
        </div>
        <div style="padding:4px 0;border-bottom:1px solid #1a1a2e;">
          <span style="color:#e0af68;">⊗</span>
          <span style="color:#565f89;">2h ago</span>
          <span style="color:#c0caf5;">Proposed process-image v2 rejected</span>
          <span style="color:#e0af68;">expected gain too small (3%)</span>
        </div>
        <div style="padding:4px 0;">
          <span style="color:#9ece6a;">✓</span>
          <span style="color:#565f89;">5h ago</span>
          <span style="color:#c0caf5;">Optimized check-calendar</span>
          <span style="color:#9ece6a;">-40% turns, -18 tokens</span>
        </div>
      </div>
    </div>

    <!-- NOTIFICATIONS -->
    <div style="margin-bottom:20px;">
      <label style="display:block;margin-bottom:8px;color:#a9b1d6;font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:0.5px;">Notifications</label>
      <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;padding:10px;background:#0d0d1a;border:1px solid #2a2a4a;border-radius:6px;">
        <label style="display:flex;align-items:center;gap:6px;font-size:12px;color:#c0caf5;cursor:pointer;">
          <input type="checkbox" id="opt-notify-user" checked style="accent-color:#7dcfff;">
          Notify user
        </label>
        <label style="display:flex;align-items:center;gap:6px;font-size:12px;color:#c0caf5;cursor:pointer;">
          <input type="checkbox" id="opt-notify-devs" checked style="accent-color:#fb4934;">
          Notify devs
        </label>
        <span style="color:#565f89;font-size:11px;">via</span>
        <select id="opt-notify-channel" style="padding:4px 6px;background:#1a1a2e;border:1px solid #2a2a4a;border-radius:4px;color:#c0caf5;font-size:11px;font-family:inherit;">
          <option>email</option>
          <option>telegram</option>
          <option>webhook</option>
        </select>
      </div>
    </div>

    <!-- PROMPT TEMPLATES -->
    <div style="margin-bottom:20px;">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
        <label style="color:#a9b1d6;font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:0.5px;">Prompt Templates</label>
        <button id="opt-toggle-prompts" style="background:none;border:none;color:#7dcfff;cursor:pointer;font-size:11px;font-family:inherit;">Show ▾</button>
      </div>
      <div id="opt-prompt-templates" style="display:none;padding:8px;background:#0d0d1a;border:1px solid #2a2a4a;border-radius:6px;font-size:11px;">
        <div id="opt-prompt-list" style="margin-bottom:8px;display:flex;gap:6px;flex-wrap:wrap;"></div>
        <textarea id="opt-prompt-editor" readonly style="width:100%;height:200px;padding:10px;background:#1a1a2e;border:1px solid #2a2a4a;border-radius:6px;color:#c0caf5;font-size:12px;font-family:monospace;resize:vertical;box-sizing:border-box;"></textarea>
        <div style="display:flex;gap:6px;margin-top:6px;align-items:center;">
          <button id="opt-prompt-save" style="padding:6px 14px;background:#7dcfff;border:none;border-radius:4px;color:#0d0d1a;font-size:11px;font-weight:600;cursor:pointer;">Save</button>
          <button id="opt-prompt-reset" style="padding:6px 14px;background:transparent;border:1px solid #565f89;border-radius:4px;color:#565f89;font-size:11px;cursor:pointer;">Reset to default</button>
          <span id="opt-prompt-status" style="font-size:10px;color:#565f89;"></span>
        </div>
        <div style="margin-top:4px;font-size:9px;color:#565f89;">
          These .md files control how the optimizer subagents think. Changes affect the next optimizer run.
        </div>
      </div>
    </div>

    <!-- ACTIONS -->
    <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
      <button id="opt-save" style="padding:10px 24px;background:#7dcfff;border:none;border-radius:6px;color:#0d0d1a;font-size:14px;font-weight:600;cursor:pointer;">Save</button>
      <button id="opt-run-now" style="padding:10px 20px;background:transparent;border:1px solid #9ece6a;border-radius:6px;color:#9ece6a;font-size:13px;cursor:pointer;display:inline-flex;align-items:center;gap:5px;"><i data-lucide="play" style="width:13px;height:13px;"></i> Run Now</button>
      <button id="opt-view-history" style="padding:10px 20px;background:transparent;border:1px solid #565f89;border-radius:6px;color:#565f89;font-size:13px;cursor:pointer;">View History</button>
      <span id="opt-status" style="margin-left:auto;font-size:11px;color:#9ece6a;display:none;"></span>
    </div>

  </div>
</div>

<!-- Connections modal -->
<div id="connections-modal" style="display:none;position:fixed;top:0;left:0;right:0;bottom:0;z-index:1000;">
  <div id="connections-backdrop" style="position:absolute;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.6);"></div>
  <div id="connections-panel" style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);background:#1a1a2e;border:1px solid #2a2a4a;border-radius:12px;padding:24px;min-width:420px;max-width:560px;max-height:80vh;overflow-y:auto;color:#c0caf5;font-size:14px;">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
      <h2 style="margin:0;font-size:18px;font-weight:600;display:inline-flex;align-items:center;gap:6px;"><i data-lucide="link" style="width:18px;height:18px;"></i> Connections</h2>
      <button id="connections-close" style="background:none;border:none;color:#565f89;cursor:pointer;font-size:20px;">&times;</button>
    </div>

    <!-- Webhook Base URL -->
    <div style="margin-bottom:20px;">
      <label style="display:block;margin-bottom:6px;color:#a9b1d6;font-size:13px;font-weight:600;">Webhook Base URL</label>
      <div style="display:flex;gap:8px;">
        <input type="text" id="conn-base-url" placeholder="https://webagent.com" autocomplete="off" style="flex:1;padding:10px;background:#0d0d1a;border:1px solid #2a2a4a;border-radius:6px;color:#c0caf5;font-size:14px;font-family:inherit;">
        <button id="conn-base-url-save" style="padding:10px 16px;background:#7dcfff;border:none;border-radius:6px;color:#0d0d1a;font-size:13px;font-weight:600;cursor:pointer;">Save</button>
      </div>
      <div style="margin-top:4px;font-size:11px;color:#565f89;">Set this to your public domain so webhook URLs resolve correctly.</div>
      <span id="conn-base-url-status" style="font-size:11px;display:none;"></span>
    </div>

    <!-- Registered webhooks -->
    <div style="margin-bottom:16px;">
      <label style="display:block;margin-bottom:8px;color:#a9b1d6;font-size:13px;font-weight:600;">Registered Webhooks</label>
      <div id="conn-webhook-list" style="display:flex;flex-direction:column;gap:6px;">
        <div style="color:#565f89;font-size:12px;padding:8px 0;">Loading...</div>
      </div>
    </div>

    <!-- Telegram -->
    <div style="margin-bottom:16px;">
      <label style="display:block;margin-bottom:8px;color:#a9b1d6;font-size:13px;font-weight:600;">Telegram Bot</label>
      <div id="conn-telegram-status" style="font-size:12px;color:#565f89;padding:8px 0;">Loading...</div>
    </div>

    <!-- HTTP tool note -->
    <div style="padding:10px 12px;background:#0d0d1a;border-radius:6px;border-left:3px solid #7dcfff;font-size:12px;color:#a9b1d6;margin-bottom:8px;">
      <strong style="color:#7dcfff;">HTTP Requests</strong> — The agent has a built-in <code>http_request</code> tool for outbound GET/POST/PUT/DELETE/PATCH calls. No config needed.
    </div>

    <!-- Close button at bottom -->
    <div style="text-align:right;margin-top:16px;">
      <button id="connections-close-btn" style="padding:8px 20px;background:transparent;border:1px solid #565f89;border-radius:6px;color:#565f89;font-size:13px;cursor:pointer;">Close</button>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/@xterm/xterm/lib/xterm.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@xterm/addon-fit/lib/addon-fit.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@xterm/addon-web-links/lib/addon-web-links.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    // ── Custom db-select dropdown ──

    // Multi-DB checked-set (persisted). When > 1, viewer enters multi-mode.
    function getCheckedDbs() {
      try {
        var raw = localStorage.getItem('dbCheckedDbs');
        var arr = raw ? JSON.parse(raw) : [];
        if (Array.isArray(arr) && arr.length) return arr;
      } catch(e) {}
      var sel = document.getElementById('db-select');
      return sel && sel.value ? [sel.value] : [];
    }
    function setCheckedDbs(arr) {
      localStorage.setItem('dbCheckedDbs', JSON.stringify(arr));
      window.dispatchEvent(new CustomEvent('db-checked-changed', { detail: arr }));
    }
    window.getCheckedDbs = getCheckedDbs;
    window.setCheckedDbs = setCheckedDbs;

    function setDbSelectValue(name) {
      var sel = document.getElementById('db-select');
      var label = document.getElementById('db-select-label');
      if (!sel) return;
      var prev = sel.value;
      sel.value = name;
      if (label) label.textContent = name;
      // Sole-select also resets checked set to just this name
      setCheckedDbs([name]);
      if (prev !== name) {
        sel.dispatchEvent(new Event('change', { bubbles: true }));
      } else {
        // Same value but checked set changed — trigger refresh
        sel.dispatchEvent(new Event('change', { bubbles: true }));
      }
    }

    function closeDbMenu() {
      var menu = document.getElementById('db-select-menu');
      if (menu) menu.style.display = 'none';
    }

    function getShowAllDbs() {
      return localStorage.getItem('dbShowAllDbs') === 'true';
    }
    function setShowAllDbs(v) {
      localStorage.setItem('dbShowAllDbs', v ? 'true' : 'false');
    }

    function renderDbMenu(databases) {
      var menu = document.getElementById('db-select-menu');
      var sel = document.getElementById('db-select');
      if (!menu || !sel) return;
      menu.innerHTML = '';

      // ── Header row: "All databases" master toggle ──
      var header = document.createElement('li');
      header.style.cssText = 'display:flex;align-items:center;gap:8px;padding:6px;border-bottom:1px solid var(--border);margin-bottom:4px;color:var(--accent);font-weight:bold;';
      var allCb = document.createElement('input');
      allCb.type = 'checkbox';
      allCb.checked = getShowAllDbs();
      allCb.title = 'Auto-select all databases (regular polling)';
      allCb.style.cssText = 'margin:0;cursor:pointer;accent-color:var(--accent);';
      allCb.addEventListener('click', function(ev) { ev.stopPropagation(); });
      allCb.addEventListener('change', function() {
        setShowAllDbs(allCb.checked);
        if (allCb.checked) {
          setCheckedDbs(databases.slice());
          startDbAutoPoll();
        } else {
          stopDbAutoPoll();
          setCheckedDbs([]);
        }
        refreshDbSelectLabel();
        window.dispatchEvent(new CustomEvent('db-active-changed'));
        renderDbMenu(databases);
      });
      var headerLabel = document.createElement('span');
      headerLabel.textContent = 'All databases';
      headerLabel.style.cssText = 'flex:1;cursor:pointer;font-size:11px;';
      headerLabel.addEventListener('click', function() {
        allCb.checked = !allCb.checked;
        allCb.dispatchEvent(new Event('change'));
      });
      header.appendChild(allCb);
      header.appendChild(headerLabel);

      // Delete-all button (skips local.db)
      var delAll = document.createElement('button');
      delAll.type = 'button';
      delAll.textContent = '🗑';
      delAll.title = 'Delete all databases (keeps local.db)';
      delAll.style.cssText = 'background:transparent;border:none;color:var(--fg-3);cursor:pointer;font-size:13px;line-height:1;padding:0 4px;border-radius:3px;';
      delAll.addEventListener('mouseenter', function() {
        delAll.style.color = 'var(--danger)';
        delAll.style.background = 'var(--danger-soft)';
      });
      delAll.addEventListener('mouseleave', function() {
        delAll.style.color = 'var(--fg-3)';
        delAll.style.background = 'transparent';
      });
      delAll.addEventListener('click', async function(ev) {
        ev.stopPropagation();
        var victims = databases.filter(function(n) { return n !== 'local.db'; });
        if (!victims.length) {
          alert('No databases to delete (only local.db present).');
          return;
        }
        if (!confirm('Delete ' + victims.length + ' database file(s)? local.db will be kept. This cannot be undone.')) return;
        var token = localStorage.getItem('auth_token');
        var failed = [];
        await Promise.all(victims.map(async function(name) {
          try {
            var res = await fetch(
              '/api/v1/db/file?db=' + encodeURIComponent(name) +
              '&token=' + encodeURIComponent(token || ''),
              { method: 'DELETE' }
            );
            if (!res.ok) {
              var err = await res.json().catch(function() { return { detail: res.statusText }; });
              failed.push(name + ': ' + (err.detail || res.statusText));
            }
          } catch(e) {
            failed.push(name + ': ' + e.message);
          }
        }));
        if (failed.length) alert('Some deletes failed:\n' + failed.join('\n'));
        // Reset selection back to local.db, refresh list
        var s = document.getElementById('db-select');
        if (s) s.value = 'local.db';
        setCheckedDbs(['local.db']);
        refreshDbSelectLabel();
        await populateDbList({ force: true });
        window.dispatchEvent(new CustomEvent('db-active-changed'));
      });
      header.appendChild(delAll);

      menu.appendChild(header);

      var checked = new Set(getCheckedDbs());
      databases.forEach(function(name) {
        var li = document.createElement('li');
        li.setAttribute('role', 'option');
        li.dataset.dbName = name;
        li.style.cssText = 'display:flex;align-items:center;gap:8px;padding:4px 6px;border-radius:4px;cursor:pointer;color:var(--fg-1);';
        if (name === sel.value) {
          li.style.background = 'var(--bg-tint)';
        }
        li.addEventListener('mouseenter', function() {
          if (name !== sel.value) li.style.background = 'var(--bg-elev)';
        });
        li.addEventListener('mouseleave', function() {
          li.style.background = (name === sel.value) ? 'var(--bg-tint)' : 'transparent';
        });

        // Checkbox — multi-select for merged view
        var cb = document.createElement('input');
        cb.type = 'checkbox';
        cb.checked = checked.has(name);
        cb.title = 'Include in merged view';
        cb.style.cssText = 'margin:0;cursor:pointer;accent-color:var(--accent);';
        cb.addEventListener('click', function(ev) {
          ev.stopPropagation();
        });
        cb.addEventListener('change', function() {
          var current = new Set(getCheckedDbs());
          if (cb.checked) current.add(name); else current.delete(name);
          var arr = Array.from(current);
          setCheckedDbs(arr);
          // If active sel is now unchecked and others remain, switch sel to first checked
          if (!cb.checked && sel.value === name && arr.length > 0) {
            sel.value = arr[0];
          }
          // Update only the highlight on the active row without rebuilding menu
          Array.from(menu.querySelectorAll('li[role="option"]')).forEach(function(rowEl) {
            var rowName = rowEl.dataset.dbName;
            rowEl.style.background = (rowName === sel.value) ? 'var(--bg-tint)' : 'transparent';
          });
          refreshDbSelectLabel();
          // Soft notify — pagination.js debounces and does silent re-query.
          // Use custom event (not sel.change) to avoid re-rendering menu DOM.
          window.dispatchEvent(new CustomEvent('db-active-changed'));
        });
        li.appendChild(cb);

        var label = document.createElement('span');
        label.textContent = name;
        label.style.cssText = 'flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;';
        label.addEventListener('click', function() {
          setDbSelectValue(name);
          closeDbMenu();
        });
        li.appendChild(label);

        // X delete button — hidden for local.db
        if (name !== 'local.db') {
          var x = document.createElement('button');
          x.type = 'button';
          x.textContent = '×';
          x.title = 'Delete ' + name;
          x.style.cssText = 'background:transparent;border:none;color:var(--fg-3);cursor:pointer;font-size:14px;line-height:1;padding:0 4px;border-radius:3px;';
          x.addEventListener('mouseenter', function() {
            x.style.color = 'var(--danger)';
            x.style.background = 'var(--danger-soft)';
          });
          x.addEventListener('mouseleave', function() {
            x.style.color = 'var(--fg-3)';
            x.style.background = 'transparent';
          });
          x.addEventListener('click', async function(ev) {
            ev.stopPropagation();
            if (!confirm('Delete database file "' + name + '"? This cannot be undone.')) return;
            var token = localStorage.getItem('auth_token');
            try {
              var res = await fetch(
                '/api/v1/db/file?db=' + encodeURIComponent(name) +
                '&token=' + encodeURIComponent(token || ''),
                { method: 'DELETE' }
              );
              if (!res.ok) {
                var err = await res.json().catch(function() { return { detail: res.statusText }; });
                alert('Delete failed: ' + (err.detail || res.statusText));
                return;
              }
              // If deleted the currently selected DB, fall back to local.db
              if (sel.value === name) {
                setDbSelectValue('local.db');
              }
              await populateDbList();
            } catch(e) {
              alert('Delete failed: ' + e.message);
            }
          });
          li.appendChild(x);
        }

        menu.appendChild(li);
      });
    }

    var __lastDbList = [];

    function arraysEqualUnordered(a, b) {
      if (a.length !== b.length) return false;
      var sa = a.slice().sort();
      var sb = b.slice().sort();
      for (var i = 0; i < sa.length; i++) if (sa[i] !== sb[i]) return false;
      return true;
    }

    async function populateDbList(opts) {
      var sel = document.getElementById('db-select');
      if (!sel) return;
      var token = localStorage.getItem('auth_token');
      if (!token) return;
      try {
        var res = await fetch('/api/v1/db/list?token=' + encodeURIComponent(token));
        if (!res.ok) return;
        var data = await res.json();
        var prevValue = sel.value;
        sel.innerHTML = '';
        data.databases.forEach(function(name) {
          var opt = document.createElement('option');
          opt.value = name;
          opt.textContent = name;
          sel.appendChild(opt);
        });
        // Restore previous selection if still present, else local.db, else first
        var nextValue = data.databases.includes(prevValue) ? prevValue
          : data.databases.includes('local.db') ? 'local.db'
          : (data.databases[0] || '');
        if (nextValue) {
          sel.value = nextValue;
        }

        // If "All databases" mode is on, sync checked set to full list.
        if (getShowAllDbs()) {
          var prevChecked = getCheckedDbs();
          if (!arraysEqualUnordered(prevChecked, data.databases)) {
            setCheckedDbs(data.databases.slice());
            // Trigger viewer refresh only on actual change
            sel.dispatchEvent(new Event('change', { bubbles: true }));
          }
        }

        refreshDbSelectLabel();
        // Re-render only on list change or when menu open, to avoid clobbering hover state.
        var listChanged = !arraysEqualUnordered(__lastDbList, data.databases);
        var menu = document.getElementById('db-select-menu');
        var menuOpen = menu && menu.style.display === 'block';
        if (listChanged || menuOpen || (opts && opts.force)) {
          renderDbMenu(data.databases);
        }
        __lastDbList = data.databases.slice();
      } catch(e) {
        console.warn('Failed to load db list:', e);
      }
    }

    // ── Regular polling (active when "All databases" toggle is on) ──
    var __dbPollTimer = null;
    function startDbAutoPoll() {
      if (__dbPollTimer) return;
      __dbPollTimer = setInterval(function() {
        populateDbList();
      }, 3000);
    }
    function stopDbAutoPoll() {
      if (__dbPollTimer) {
        clearInterval(__dbPollTimer);
        __dbPollTimer = null;
      }
    }

    // Keep label + menu in sync if any other code sets sel.value directly
    function refreshDbSelectLabel() {
      var sel = document.getElementById('db-select');
      var label = document.getElementById('db-select-label');
      if (!sel || !label) return;
      var checked = getCheckedDbs();
      if (checked.length > 1) {
        label.textContent = sel.value + ' +' + (checked.length - 1);
      } else {
        label.textContent = sel.value;
      }
    }
    var selEl = document.getElementById('db-select');
    if (selEl) {
      selEl.addEventListener('change', function() {
        refreshDbSelectLabel();
        // Only rebuild menu DOM when menu is actually open (avoids flicker during background updates)
        var menu = document.getElementById('db-select-menu');
        if (menu && menu.style.display === 'block') {
          var names = Array.from(selEl.options).map(function(o) { return o.value; });
          renderDbMenu(names);
        }
      });
    }
    window.addEventListener('db-checked-changed', refreshDbSelectLabel);

    // Trigger toggles menu (fixed-positioned at trigger rect so no ancestor clips it)
    function positionDbMenu() {
      var trig = document.getElementById('db-select-trigger');
      var menu = document.getElementById('db-select-menu');
      if (!trig || !menu) return;
      var r = trig.getBoundingClientRect();
      menu.style.top = (r.bottom + 2) + 'px';
      menu.style.left = r.left + 'px';
      menu.style.minWidth = Math.max(r.width, 240) + 'px';
    }
    var trigger = document.getElementById('db-select-trigger');
    if (trigger) {
      trigger.addEventListener('click', function(ev) {
        ev.stopPropagation();
        var menu = document.getElementById('db-select-menu');
        if (!menu) return;
        var open = !(menu.style.display === 'none' || !menu.style.display);
        if (open) {
          menu.style.display = 'none';
        } else {
          // Refetch list every time menu opens so newly-created/deleted DBs appear
          populateDbList({ force: true }).then(function() {
            positionDbMenu();
            menu.style.display = 'block';
          });
        }
      });
    }
    window.addEventListener('resize', positionDbMenu);
    window.addEventListener('scroll', positionDbMenu, true);
    // Click outside closes menu
    document.addEventListener('click', function(ev) {
      var wrap = document.getElementById('db-select-wrap');
      if (wrap && !wrap.contains(ev.target)) closeDbMenu();
    });
    document.addEventListener('keydown', function(ev) {
      if (ev.key === 'Escape') closeDbMenu();
    });

    // ── Download button ──
    var downloadBtn = document.getElementById('db-download-btn');
    if (downloadBtn) {
      downloadBtn.addEventListener('click', function() {
        var sel = document.getElementById('db-select');
        var dbName = sel ? sel.value : 'local.db';
        var token = localStorage.getItem('auth_token');
        var url = '/api/v1/db/download?db=' + encodeURIComponent(dbName);
        if (token) url += '&token=' + encodeURIComponent(token);
        window.open(url, '_blank');
      });
    }

    // ── Populate on first db tab appearance ──
    populateDbList().then(function() {
      // Resume auto-poll if "All databases" was previously enabled
      if (getShowAllDbs()) startDbAutoPoll();
    });
  });
</script>
<script type="module" src="./ui/js/main.js"></script>
<script type="module" src="./ui/js/attachments.js"></script>
<script type="module" src="./ui/js/optimizer.js"></script>
<!-- ── Lucide icons + custom tab-select popup ───────────────── -->
<script>
(function () {
  // Render all data-lucide icons in the DOM
  lucide.createIcons();

  // ── Custom tab-select popup ──────────────────────────────────
  // The hidden <select id="main-tab-select"> is used by tabs.js.
  // This block drives the visible pill button + popup and stays in sync.

  var TABS = [
    { id: 'terminal',    icon: 'terminal',    label: 'Terminal'   },
    { id: 'stream',      icon: 'radio-tower', label: 'Stream'     },
    { id: 'flow',        icon: 'git-branch',  label: 'Flow'       },
    { id: 'loop-visual', icon: 'repeat',      label: 'Loop'       },
    { id: 'database',    icon: 'database',    label: 'Database'   },
    { id: 'github',      icon: 'github',      label: 'GitHub'     },
    { id: 'autoagent',   icon: 'palette',     label: 'AutoAgent'  },
    { id: 'agents',      icon: 'bot',              label: 'Agents'     },
    { id: 'app-config',  icon: 'sliders-horizontal', label: 'App Config' },
  ];

  var nativeSelect = document.getElementById('main-tab-select');
  var btn          = document.getElementById('tab-select-btn');
  var popup        = document.getElementById('tab-select-popup');
  var labelEl      = document.getElementById('tab-select-label');
  var btnIconEl    = document.getElementById('tab-btn-icon');
  if (!nativeSelect || !btn || !popup) return;

  function syncBtn(tabId) {
    var t = TABS.find(function (t) { return t.id === tabId; }) || TABS[1];
    labelEl.textContent = t.label;
    btnIconEl.setAttribute('data-lucide', t.icon);
    lucide.createIcons({ nodes: [btnIconEl] });
    popup.querySelectorAll('.tab-option').forEach(function (o) {
      o.classList.toggle('active', o.dataset.value === tabId);
    });
  }

  // Open / close popup
  btn.addEventListener('click', function (e) {
    e.stopPropagation();
    popup.style.display = popup.style.display === 'none' ? 'block' : 'none';
  });

  // Pick a tab
  popup.querySelectorAll('.tab-option').forEach(function (opt) {
    opt.addEventListener('click', function () {
      var val = opt.dataset.value;
      nativeSelect.value = val;
      nativeSelect.dispatchEvent(new Event('change', { bubbles: true }));
      popup.style.display = 'none';
      syncBtn(val);
    });
  });

  // Close on outside click
  document.addEventListener('click', function (e) {
    if (!e.target.closest('.tab-select-group')) {
      popup.style.display = 'none';
    }
  });

  // MutationObserver: sync when tabs.js (or config menu) switches tab externally
  var tabContents = document.querySelectorAll('.tab-content');
  if (tabContents.length) {
    var observer = new MutationObserver(function () {
      var active = document.querySelector('.tab-content.active');
      if (active) {
        syncBtn(active.id.replace('tab-', ''));
      }
    });
    tabContents.forEach(function (el) {
      observer.observe(el, { attributes: true, attributeFilter: ['class'] });
    });
  }

  // Sync pill to whatever tab is currently active on load
  var initActive = document.querySelector('.tab-content.active');
  if (initActive) syncBtn(initActive.id.replace('tab-', ''));

})();
</script>
</body>
</html>
