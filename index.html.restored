<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>webAgent</title>
<link rel="icon" href="./ui/favicon.svg" type="image/svg+xml">
<!-- Fonts: Inter (sans) + JetBrains Mono (mono) -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap">
<!-- Lucide icons (UMD — same version as UI kit) -->
<script src="https://unpkg.com/lucide@0.469.0/dist/umd/lucide.min.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@xterm/xterm/css/xterm.css">
<link rel="stylesheet" href="./ui/css/app1.css">
<link rel="stylesheet" href="./ui/css/app2.css">
<link rel="stylesheet" href="./ui/css/app3.css">
<link rel="stylesheet" href="./ui/css/loop.css">
<link rel="stylesheet" href="./ui/css/loop-visual.css">
<link rel="stylesheet" href="./ui/css/autoagent.css">
<link rel="stylesheet" href="./ui/css/agents.css">
<!-- Design system tokens + visual overrides (loaded last to take effect) -->
<link rel="stylesheet" href="./ui/css/design-system.css">
</head>
<body>

<div id="status-bar">

  <!-- Tab select: hidden native <select> for JS compat + custom pill button + popup -->
  <div class="status-group tab-select-group" style="position:relative;">
    <select id="main-tab-select" style="display:none;" aria-hidden="true">
      <option value="terminal">Terminal</option>
      <option value="stream" selected>Stream</option>
      <option value="flow">Flow</option>
      <option value="loop-visual">Loop</option>
      <option value="database">Database</option>
      <option value="github">GitHub</option>
      <option value="autoagent">AutoAgent</option>
      <option value="agents">Agents</option>
      <option value="app-config">App Config</option>
    </select>
    <button id="tab-select-btn" class="tab-select-pill" aria-haspopup="listbox">
      <i id="tab-btn-icon" data-lucide="radio-tower" class="lucide-icon" style="width:14px;height:14px;"></i>
      <span id="tab-select-label">Stream</span>
      <i data-lucide="chevron-down" class="lucide-icon" style="width:12px;height:12px;opacity:0.6;margin-left:2px;"></i>
    </button>
    <div id="tab-select-popup" class="tab-select-popup" style="display:none;" role="listbox">
      <div class="tab-option" data-value="terminal" data-icon="terminal" role="option">
        <i data-lucide="terminal" class="lucide-icon menu-icon"></i>Terminal
      </div>
      <div class="tab-option active" data-value="stream" data-icon="radio-tower" role="option">
        <i data-lucide="radio-tower" class="lucide-icon menu-icon"></i>Stream
      </div>
      <div class="tab-option" data-value="flow" data-icon="git-branch" role="option">
        <i data-lucide="git-branch" class="lucide-icon menu-icon"></i>Flow
      </div>
      <div class="tab-option" data-value="loop-visual" data-icon="repeat" role="option">
        <i data-lucide="repeat" class="lucide-icon menu-icon"></i>Loop
      </div>
      <div class="tab-option" data-value="database" data-icon="database" role="option">
        <i data-lucide="database" class="lucide-icon menu-icon"></i>Database
      </div>
      <div class="tab-option" data-value="github" data-icon="github" role="option">
        <i data-lucide="github" class="lucide-icon menu-icon"></i>GitHub
      </div>
      <div class="tab-option" data-value="autoagent" data-icon="palette" role="option">
        <i data-lucide="palette" class="lucide-icon menu-icon"></i>AutoAgent
      </div>
      <div class="tab-option" data-value="agents" data-icon="bot" role="option">
        <i data-lucide="bot" class="lucide-icon menu-icon"></i>Agents
      </div>
      <div class="tab-option" data-value="app-config" data-icon="sliders-horizontal" role="option">
        <i data-lucide="sliders-horizontal" class="lucide-icon menu-icon"></i>App Config
      </div>
    </div>
  </div>

  <!-- Status dots + restart -->
  <div class="status-group" style="margin-left:12px;">
    <span class="status-dot yellow" id="terminal-dot" title="Terminal Connection"></span>
    <span id="terminal-status" style="display:none;"></span>
    <span class="status-dot yellow" id="agent-dot" title="Server Connection"></span>
    <span id="agent-status" style="display:none;"></span>
    <button id="btn-restart" class="icon-btn-pill" title="Restart the Python agent server">
      <i data-lucide="refresh-cw" class="lucide-icon" style="width:14px;height:14px;"></i>
    </button>
    <span id="restart-status" style="font-size:11px;color:var(--text-muted,#888);margin-left:6px;display:none;"></span>
  </div>

  <!-- User menu -->
  <span id="status-right">
    <div class="user-dropdown" id="user-dropdown">
      <span id="top-user-id" class="user-dropdown-trigger" style="color:var(--accent);font-weight:600;display:flex;align-items:center;gap:4px;font-size:13px;cursor:pointer;">
        <span id="top-user-id-val">None</span>
        <i data-lucide="chevron-down" class="lucide-icon" style="width:12px;height:12px;opacity:0.6;"></i>
      </span>
      <div id="user-dropdown-menu" class="user-dropdown-menu" style="display:none;">
        <div class="user-dropdown-header">
          <span id="dropdown-user-label">User</span>
        </div>
        <div class="theme-toggle-section">
          <span class="theme-toggle-label">Theme</span>
          <div class="theme-toggle-group">
            <button class="theme-option" data-theme="light" title="Light">
              <i data-lucide="sun" class="lucide-icon" style="width:15px;height:15px;"></i>
            </button>
            <button class="theme-option" data-theme="dark" title="Dark">
              <i data-lucide="moon" class="lucide-icon" style="width:15px;height:15px;"></i>
            </button>
            <button class="theme-option" data-theme="system" title="System">
              <i data-lucide="monitor" class="lucide-icon" style="width:15px;height:15px;"></i>
            </button>
          </div>
        </div>
        <div class="user-dropdown-divider"></div>
        <button id="btn-signout-header" class="user-dropdown-action">
          <i data-lucide="log-out" class="lucide-icon" style="width:15px;height:15px;"></i>
          Sign Out
        </button>
      </div>
    </div>
  </span>

</div>

<!-- Split container -->
<div id="app-container">

  <!-- Terminal side -->
  <div id="terminal-side">
    <!-- Tab content -->
    <div id="tab-terminal" class="tab-content">
      <div id="terminal-container"></div>
    </div>
    <div id="tab-stream" class="tab-content active">
      <div id="stream-viewer">
        <div id="stream-toolbar">
          <span style="color:#565f89;font-size:11px;display:inline-flex;align-items:center;gap:4px;"><i data-lucide="radio" style="width:12px;height:12px;"></i> Live interactions</span>
          <button id="stream-filter-btn" title="Filter roles and tools" style="background:#1a1a2e;border:1px solid #2a2a4a;color:#565f89;padding:2px 10px;border-radius:4px;cursor:pointer;font-size:11px;font-family:inherit;margin-left:8px;display:inline-flex;align-items:center;gap:4px;"><i data-lucide="sliders-horizontal" style="width:11px;height:11px;"></i> Filters</button>
          <span id="stream-status" style="color:#565f89;font-size:11px;margin-left:auto;display:inline-flex;align-items:center;gap:4px;"><i data-lucide="pause" style="width:11px;height:11px;"></i> paused</span>
          <button id="stream-clear" style="background:#1a1a2e;border:1px solid #2a2a4a;color:#c0caf5;padding:2px 10px;border-radius:4px;cursor:pointer;font-size:11px;font-family:inherit;margin-left:8px;display:inline-flex;align-items:center;gap:4px;"><i data-lucide="x" style="width:11px;height:11px;"></i> Clear</button>
        </div>
        <div id="stream-filter-panel" style="display:none;background:#1a1a2e;border-bottom:1px solid #2a2a4a;padding:8px 12px;font-size:12px;flex-shrink:0;">
          <div id="stream-filter-panel-inner"></div>
        </div>
        <div id="stream-list">
          <div class="db-hint">Switch to this tab to start streaming interactions</div>
        </div>
      </div>
    </div>
    <div id="tab-flow" class="tab-content">
      <div id="loop-container">
        <div id="loop-toolbar">
          <span style="color:#565f89;font-size:11px;display:inline-flex;align-items:center;gap:4px;"><i data-lucide="refresh-cw" style="width:12px;height:12px;"></i> Pipeline</span>
          <button class="loop-filter-btn" data-level="basic">Basic</button>
          <button class="loop-filter-btn active" data-level="detailed">Detailed</button>
          <button class="loop-filter-btn" data-level="debug">Debug</button>
          <button id="loop-autoscroll" class="active">Auto-scroll ✓</button>
        </div>
        <div id="loop-list">
          <div class="loop-hint">Pipeline visualizer — connect to see agent flow</div>
        </div>
      </div>
    </div>
    <div id="tab-loop-visual" class="tab-content">
      <div id="loop-visual-container">
        <div id="loop-visual-toolbar">
          <span style="color:#565f89;font-size:11px;display:inline-flex;align-items:center;gap:4px;"><i data-lucide="repeat" style="width:12px;height:12px;"></i> Agent Loop</span>
          <div id="loop-visual-pages"></div>
          <div id="loop-visual-legend">
            <span class="lv-legend-item"><span class="lv-legend-dot" style="background:#2a2a4a;"></span> idle</span>
            <span class="lv-legend-item"><span class="lv-legend-dot" style="background:#7dcfff;"></span> active</span>
            <span class="lv-legend-item"><span class="lv-legend-dot" style="background:#9ece6a;"></span> done</span>
            <span class="lv-legend-item"><span class="lv-legend-dot" style="background:#f7768e;"></span> error</span>
          </div>
        </div>
        <div id="loop-visual-graph-area">
          <div class="loop-visual-hint">Agent loop visualizer — connect to see events light up the graph</div>
        </div>
      </div>
    </div>
    <div id="tab-github" class="tab-content">
      <div id="gh-restricted-overlay" style="display:none;">
        <div class="gh-restricted-card">
          <div class="gh-restricted-icon"><i data-lucide="lock" style="width:32px;height:32px;"></i></div>
          <div class="gh-restricted-title">Restricted Access</div>
          <div class="gh-restricted-desc">The GitHub tab is only available for admin users.</div>
          <div class="gh-restricted-desc" style="margin-top:8px;font-size:12px;color:#565f89;">
            Log in as <strong>admin</strong> to manage the repository.
          </div>
        </div>
      </div>
      <div id="gh-viewer" style="display:none;">
        <div id="gh-toolbar">
          <span style="color:#565f89;font-size:11px;display:inline-flex;align-items:center;gap:4px;"><i data-lucide="github" style="width:12px;height:12px;"></i> GitHub Repository</span>
          <span id="gh-repo-badge" style="color:#565f89;font-size:11px;margin-left:8px;">
            <span id="gh-branch-display"><span id="gh-branch">—</span></span>
          </span>
          <span style="margin-left:auto;display:flex;gap:6px;align-items:center;">
            <button id="gh-refresh-btn" class="gh-btn gh-btn-sm">↻ Refresh</button>
            <span id="gh-refresh-spinner" class="gh-spinner" style="display:none;">⟳</span>
          </span>
        </div>

        <div id="gh-body">
          <!-- Left column: status + actions -->
          <div id="gh-left">
            <!-- Repo status card -->
            <div class="gh-card">
              <div class="gh-card-title">Repository</div>
              <div class="gh-status-grid">
                <div class="gh-status-item">
                  <span class="gh-label">Remote</span>
                  <span id="gh-remote-url" class="gh-value">—</span>
                </div>
                <div class="gh-status-item">
                  <span class="gh-label">Last Commit</span>
                  <span id="gh-last-commit" class="gh-value">—</span>
                </div>
                <div class="gh-status-item">
                  <span class="gh-label">Sync</span>
                  <span id="gh-ahead-behind" class="gh-value">—</span>
                </div>
                <div class="gh-status-item">
                  <span class="gh-label">Files</span>
                  <span id="gh-file-count" class="gh-value">—</span>
                </div>
              </div>
            </div>

            <!-- Changed files -->
            <div class="gh-card">
              <div class="gh-card-title">Changed Files</div>
              <div id="gh-file-list" class="gh-file-list">
                <div class="gh-meta">Loading...</div>
              </div>
            </div>

            <!-- Commit area -->
            <div id="gh-commit-section" class="gh-card" style="display:none;">
              <div class="gh-card-title">Commit</div>
              <div class="gh-commit-row">
                <input type="text" id="gh-commit-msg" class="gh-input" placeholder="Commit message..." maxlength="200">
                <button id="gh-commit-btn" class="gh-btn gh-btn-primary">Commit</button>
                <span id="gh-commit-spinner" class="gh-spinner" style="display:none;">⟳</span>
              </div>
              <div id="gh-commit-result" class="gh-result" style="display:none;"></div>
            </div>

            <!-- Push / Pull -->
            <div id="gh-push-pull-group" class="gh-card" style="display:none;">
              <div class="gh-card-title">Sync</div>
              <div class="gh-sync-row">
                <button id="gh-push-btn" class="gh-btn gh-btn-primary" style="display:inline-flex;align-items:center;gap:4px;"><i data-lucide="arrow-up" style="width:13px;height:13px;"></i> Push</button>
                <span id="gh-push-spinner" class="gh-spinner" style="display:none;">⟳</span>
                <span id="gh-push-result" class="gh-result" style="display:none;"></span>
                <button id="gh-pull-btn" class="gh-btn" style="display:inline-flex;align-items:center;gap:4px;"><i data-lucide="arrow-down" style="width:13px;height:13px;"></i> Pull</button>
                <span id="gh-pull-spinner" class="gh-spinner" style="display:none;">⟳</span>
                <span id="gh-pull-result" class="gh-result" style="display:none;"></span>
              </div>
            </div>

            <!-- Token config -->
            <div id="gh-token-section" class="gh-card">
              <div class="gh-card-title">GitHub Token <span id="gh-token-configured" style="font-weight:400;font-size:11px;color:#565f89;margin-left:8px;">—</span></div>
              <div class="gh-token-row">
                <input type="password" id="gh-token-input" class="gh-input" placeholder="ghp_... or github_pat_...">
                <button id="gh-token-save-btn" class="gh-btn gh-btn-primary">Save</button>
              </div>
              <div id="gh-token-status" class="gh-result" style="display:none;"></div>
              <details class="gh-hint-details">
                <summary style="cursor:pointer;color:#7dcfff;font-size:11px;font-weight:500;">How to create a GitHub token →</summary>
                <div class="gh-hint-steps">
                  <p><strong>Classic token:</strong></p>
                  <ol>
                    <li>Go to <a href="https://github.com/settings/tokens" target="_blank" style="color:#7dcfff;">github.com/settings/tokens</a></li>
                    <li>Click <strong>Generate new token (classic)</strong></li>
                    <li>Give it a name (e.g. "webAgent")</li>
                    <li>Select scope: <strong>repo</strong> (full control)</li>
                    <li>Click <strong>Generate token</strong> and copy it</li>
                  </ol>
                  <p style="margin-top:6px;"><strong>Fine-grained token:</strong></p>
                  <ol>
                    <li>Go to <a href="https://github.com/settings/tokens?type=beta" target="_blank" style="color:#7dcfff;">github.com/settings/tokens</a></li>
                    <li>Click <strong>Generate new token (fine-grained)</strong></li>
                    <li>Select this repository only</li>
                    <li>Permissions → <strong>Contents: Read and write</strong></li>
                    <li>Click <strong>Generate token</strong> and copy it</li>
                  </ol>
                  <p style="margin-top:6px;color:#e0af68;">Paste the token above and click Save. It's stored locally in provider.json.</p>
                </div>
              </details>
            </div>
          </div>

          <!-- Right column: commit log -->
          <div id="gh-right">
            <div class="gh-card">
              <div class="gh-card-title">Recent Commits</div>
              <div id="gh-log-list" class="gh-log-list">
                <div class="gh-meta">Loading...</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div id="tab-autoagent" class="tab-content">
      <div id="autoagent-container">

        <!-- Page nav: dropdown + new / delete buttons -->
        <div id="autoagent-page-nav">
          <select id="autoagent-page-select" class="aa-page-select" title="Switch page"></select>
          <button id="autoagent-new-page-btn" class="aa-icon-btn" title="New page">+</button>
          <button id="autoagent-delete-page-btn" class="aa-icon-btn aa-delete-btn" title="Delete page" disabled><i data-lucide="trash-2" style="width:14px;height:14px;"></i></button>
        </div>

        <!-- New-page dialog (hidden by default) -->
        <div id="aa-new-page-dialog">
          <div class="aa-dialog-box">
            <h3>New Page</h3>
            <input type="text" id="aa-dialog-input" class="aa-dialog-input" placeholder="Page title (e.g. Dashboard, Notes)" maxlength="60">
            <div class="aa-dialog-actions">
              <button id="aa-dialog-cancel" class="aa-dialog-btn aa-dialog-btn-cancel">Cancel</button>
              <button id="aa-dialog-confirm" class="aa-dialog-btn aa-dialog-btn-primary">Create</button>
            </div>
          </div>
        </div>

        <!-- Prompt bar -->
        <div id="autoagent-prompt-bar">
          <input type="text" id="autoagent-prompt-input" class="aa-prompt-input" placeholder="Tell the page agent what to build or change..." maxlength="2000">
          <button id="autoagent-send-btn" class="aa-send-btn" title="Send to page agent">&#9654;</button>
        </div>

        <!-- Viewport -->
        <div id="autoagent-viewport">
          <div id="autoagent-placeholder" class="aa-placeholder">
            <span class="aa-placeholder-icon"><i data-lucide="palette" style="width:48px;height:48px;"></i></span>
            <span class="aa-placeholder-text">Loading your pages...</span>
            <span class="aa-placeholder-hint">Each page has its own dedicated agent</span>
          </div>
          <iframe id="autoagent-iframe" class="aa-iframe" sandbox="allow-scripts" style="display:none;" title="Page output"></iframe>
          <div id="autoagent-loading" class="aa-loading" style="display:none;">
            <span class="aa-spinner"></span>
            <span>Page agent is working...</span>
          </div>
        </div>

        <div id="autoagent-status" class="aa-status"></div>
      </div>
    </div>
    <div id="tab-agents" class="tab-content">
      <!-- Toolbar -->
      <div id="agents-toolbar">
        <div id="agents-toolbar-left">
          <span id="agents-toolbar-title">Agents</span>
          <span id="agents-toolbar-sub"> &middot; Agent templates &middot; system prompts &middot; model assignments</span>
        </div>
        <button id="btn-new-agent">+ New agent</button>
      </div>

      <!-- Card grid -->
      <div id="agents-grid"></div>

      <!-- Per-agent inline panels are generated dynamically by agents.js -->
      <div id="agents-create-modal" class="hidden">
        <div id="agents-create-box">
          <h3>New Agent</h3>
          <div class="agents-create-row">
            <label for="agents-create-name">Name</label>
            <input type="text" id="agents-create-name" class="agents-input" placeholder="My Custom Agent" maxlength="60">
          </div>
          <div class="agents-create-row">
            <label for="agents-create-desc">Description</label>
            <input type="text" id="agents-create-desc" class="agents-input" placeholder="Optional description" maxlength="200">
          </div>
          <div class="agents-create-row">
            <label for="agents-create-template">Template</label>
            <select id="agents-create-template" class="agents-input">
              <option value="">— No template —</option>
            </select>
          </div>
          <div id="agents-create-actions">
            <button class="agents-btn" id="btn-create-cancel">Cancel</button>
            <button class="agents-btn primary" id="btn-create-confirm">Create</button>
          </div>
        </div>
      </div>
    </div>

    <!-- App Config tab -->
    <div id="tab-app-config" class="tab-content">
      <div id="app-config-container">

        <!-- Sidebar nav -->
        <nav id="app-config-sidebar">
          <div class="ac-nav-title">App Config</div>
          <a class="ac-nav-item active" data-section="llm" href="#ac-section-llm">
            <i data-lucide="bot" class="lucide-icon ac-nav-icon"></i>Default LLM
          </a>
          <a class="ac-nav-item" data-section="connections" href="#ac-section-connections">
            <i data-lucide="plug" class="lucide-icon ac-nav-icon"></i>App Connections
          </a>
          <a class="ac-nav-item" data-section="integrations" href="#ac-section-integrations">
            <i data-lucide="puzzle" class="lucide-icon ac-nav-icon"></i>Integrations
          </a>
          <a class="ac-nav-item" data-section="database" href="#ac-section-database">
            <i data-lucide="database" class="lucide-icon ac-nav-icon"></i>Database
          </a>
          <a class="ac-nav-item" data-section="optimizer" href="#ac-section-optimizer">
            <i data-lucide="zap" class="lucide-icon ac-nav-icon"></i>Optimizer Stats
          </a>
          <a class="ac-nav-item" data-section="git" href="#ac-section-git">
            <i data-lucide="git-branch" class="lucide-icon ac-nav-icon"></i>Git Providers
          </a>
        </nav>

        <!-- Scrollable content -->
        <div id="app-config-content">

          <!-- ── Default LLM ── -->
          <section id="ac-section-llm" class="ac-section">
            <div class="ac-section-header">
              <i data-lucide="bot" class="lucide-icon ac-section-icon"></i>
              <div>
                <h2 class="ac-section-title">Default LLM</h2>
                <p class="ac-section-desc">Configure the language model provider, API key, and default model.</p>
              </div>
            </div>
            <div class="ac-card">
              <div class="ac-field">
                <label class="ac-label">Provider</label>
                <select id="ac-settings-provider" class="ac-input"></select>
              </div>
              <div class="ac-field">
                <label class="ac-label">Base URL</label>
                <input type="text" id="ac-settings-base-url" class="ac-input" placeholder="https://openrouter.ai/api/v1" autocomplete="off">
                <div class="ac-hint">Auto-filled when you pick a provider. Edit for custom endpoints.</div>
              </div>
              <div class="ac-field">
                <label class="ac-label">API Key</label>
                <input type="text" id="ac-settings-api-key" class="ac-input" placeholder="sk-..." autocomplete="off">
                <div class="ac-hint">Stored on this device only. Never sent elsewhere.</div>
              </div>
              <div class="ac-field" id="ac-settings-model-group">
                <label class="ac-label">Model</label>
                <div style="position:relative;">
                  <input type="text" id="ac-settings-model-search" class="ac-input" placeholder="Search models…" autocomplete="off">
                  <div id="ac-settings-model-dropdown" class="ac-model-dropdown" style="display:none;"></div>
                </div>
                <div id="ac-settings-model-status" class="ac-hint"></div>
              </div>
              <div class="ac-actions">
                <button id="ac-settings-save" class="ac-btn ac-btn-primary">Save</button>
                <button id="ac-settings-clear" class="ac-btn ac-btn-ghost">Clear</button>
                <span id="ac-settings-status" class="ac-status" style="display:none;"></span>
              </div>
            </div>

            <!-- Saved / parallel providers -->
            <div class="ac-card" id="ac-settings-saved-wrap" style="display:none;">
              <div class="ac-card-label">Saved Configurations</div>
              <div class="ac-card-sublabel">Check multiple rows to send requests in parallel — fastest response wins.</div>
              <div id="ac-settings-saved-list" style="display:flex;flex-direction:column;gap:6px;margin-top:8px;"></div>
              <div id="ac-settings-parallel-count" class="ac-hint" style="margin-top:6px;text-align:right;"></div>
            </div>
          </section>

          <!-- ── App Connections ── -->
          <section id="ac-section-connections" class="ac-section">
            <div class="ac-section-header">
              <i data-lucide="plug" class="lucide-icon ac-section-icon"></i>
              <div>
                <h2 class="ac-section-title">App Connections</h2>
                <p class="ac-section-desc">Webhooks, Telegram bot, and outbound HTTP settings.</p>
              </div>
            </div>

            <div class="ac-card">
              <div class="ac-card-label">Webhook Base URL</div>
              <div class="ac-field">
                <div style="display:flex;gap:8px;">
                  <input type="text" id="ac-conn-base-url" class="ac-input" placeholder="https://your-domain.com" style="flex:1;" autocomplete="off">
                  <button id="ac-conn-base-url-save" class="ac-btn ac-btn-primary" style="flex-shrink:0;">Save</button>
                </div>
                <div class="ac-hint">Set to your public domain so webhook callback URLs resolve correctly.</div>
                <span id="ac-conn-base-url-status" class="ac-status" style="display:none;"></span>
              </div>
            </div>

            <div class="ac-card">
              <div class="ac-card-label">Registered Webhooks</div>
              <div id="ac-conn-webhook-list" style="display:flex;flex-direction:column;gap:6px;margin-top:8px;">
                <div class="ac-hint">Loading…</div>
              </div>
            </div>

            <div class="ac-card">
              <div class="ac-card-label">Telegram Bot</div>
              <div id="ac-conn-telegram-status" class="ac-hint" style="padding:8px 0;">Loading…</div>
            </div>

            <div class="ac-info-banner">
              <strong style="color:var(--accent);">HTTP Requests</strong> — The agent has a built-in <code>http_request</code> tool for outbound GET/POST/PUT/DELETE/PATCH calls. No config needed.
            </div>
          </section>

          <!-- ── Integrations ── -->
          <section id="ac-section-integrations" class="ac-section">
            <div class="ac-section-header">
              <i data-lucide="puzzle" class="lucide-icon ac-section-icon"></i>
              <div>
                <h2 class="ac-section-title">Integrations</h2>
                <p class="ac-section-desc">Configure third-party service credentials. Users connect their accounts via each agent's Connections tab.</p>
              </div>
            </div>

            <!-- Google OAuth Config -->
            <div class="ac-card" id="ac-int-google-card">
              <div style="display:flex;align-items:center;gap:12px;margin-bottom:12px;">
                <svg viewBox="0 0 24 24" width="24" height="24" style="flex-shrink:0;">
                  <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.27-4.74 3.27-8.1z"/>
                  <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                  <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18A10.96 10.96 0 0 0 1 12c0 1.77.42 3.45 1.18 4.93l3.66-2.84z"/>
                  <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                </svg>
                <div style="flex:1;">
                  <div style="font-weight:600;font-size:14px;">Google OAuth</div>
                  <div class="ac-hint" style="margin:0;">Gmail, Drive, Docs, Calendar — app-level credentials</div>
                </div>
                <span id="ac-int-google-badge" class="ac-int-badge ac-int-badge-off">Not configured</span>
              </div>

              <div id="ac-int-google-configured" style="display:none;font-size:12px;">
                <div style="display:flex;flex-direction:column;gap:6px;">
                  <div><span style="color:var(--fg-muted);">Client ID:</span> <code id="ac-int-google-cid" style="font-size:11px;"></code></div>
                  <div><span style="color:var(--fg-muted);">Redirect URI:</span> <code id="ac-int-google-uri" style="font-size:11px;word-break:break-all;"></code></div>
                  <div class="ac-hint" style="margin-top:4px;">Users connect their Google accounts from each agent's <strong>Connections</strong> tab.</div>
                </div>
                <div style="margin-top:12px;">
                  <button id="ac-int-google-unconfigure" class="ac-btn ac-btn-ghost" style="color:#f7768e;">Unconfigure</button>
                </div>
              </div>

              <div id="ac-int-google-form" style="display:none;">
                <div class="ac-field" style="margin-bottom:10px;">
                  <label class="ac-label">Client ID</label>
                  <input type="text" id="ac-int-google-input-cid" class="ac-input" placeholder="xxxx.apps.googleusercontent.com" autocomplete="off">
                </div>
                <div class="ac-field" style="margin-bottom:10px;">
                  <label class="ac-label">Client Secret</label>
                  <input type="password" id="ac-int-google-input-secret" class="ac-input" placeholder="GOCSPX-..." autocomplete="off">
                </div>
                <div class="ac-field">
                  <label class="ac-label" style="color:var(--fg-muted);">Redirect URI (add to Google Cloud Console)</label>
                  <code id="ac-int-google-form-uri" style="font-size:11px;display:block;padding:6px 8px;background:var(--bg-base,#0d0d1a);border-radius:4px;word-break:break-all;"></code>
                </div>
                <div style="margin-top:12px;">
                  <button id="ac-int-google-save" class="ac-btn ac-btn-primary">Save</button>
                </div>
              </div>
              <span id="ac-int-google-status" class="ac-status" style="display:none;margin-top:8px;"></span>
              <details class="ac-details" style="margin-top:12px;">
                <summary>Setup instructions</summary>
                <div class="ac-details-body">
                  <ol style="margin:6px 0 0 16px;padding:0;">
                    <li>Go to <a href="https://console.cloud.google.com/apis/credentials" target="_blank" style="color:var(--accent);">Google Cloud Console → Credentials</a></li>
                    <li>Create an OAuth 2.0 Client ID (Web application)</li>
                    <li>Add the <strong>Redirect URI</strong> shown above as an Authorized redirect URI</li>
                    <li>Copy the Client ID and Client Secret into the fields above and click Save</li>
                  </ol>
                </div>
              </details>
            </div>

            <!-- Microsoft OAuth Config -->
            <div class="ac-card" id="ac-int-microsoft-card">
              <div style="display:flex;align-items:center;gap:12px;margin-bottom:12px;">
                <svg viewBox="0 0 24 24" width="24" height="24" style="flex-shrink:0;">
                  <rect x="1" y="1" width="10" height="10" fill="#F25022"/>
                  <rect x="13" y="1" width="10" height="10" fill="#7FBA00"/>
                  <rect x="1" y="13" width="10" height="10" fill="#00A4EF"/>
                  <rect x="13" y="13" width="10" height="10" fill="#FFB900"/>
                </svg>
                <div style="flex:1;">
                  <div style="font-weight:600;font-size:14px;">Microsoft 365 OAuth</div>
                  <div class="ac-hint" style="margin:0;">Outlook, OneDrive, SharePoint — app-level credentials</div>
                </div>
                <span id="ac-int-microsoft-badge" class="ac-int-badge ac-int-badge-off">Not configured</span>
              </div>

              <div id="ac-int-microsoft-configured" style="display:none;font-size:12px;">
                <div style="display:flex;flex-direction:column;gap:6px;">
                  <div><span style="color:var(--fg-muted);">Client ID:</span> <code id="ac-int-microsoft-cid" style="font-size:11px;"></code></div>
                  <div><span style="color:var(--fg-muted);">Redirect URI:</span> <code id="ac-int-microsoft-uri" style="font-size:11px;word-break:break-all;"></code></div>
                  <div class="ac-hint" style="margin-top:4px;">Users connect their Microsoft accounts from each agent's <strong>Connections</strong> tab.</div>
                </div>
                <div style="margin-top:12px;">
                  <button id="ac-int-microsoft-unconfigure" class="ac-btn ac-btn-ghost" style="color:#f7768e;">Unconfigure</button>
                </div>
              </div>

              <div id="ac-int-microsoft-form" style="display:none;">
                <div class="ac-field" style="margin-bottom:10px;">
                  <label class="ac-label">Application (Client) ID</label>
                  <input type="text" id="ac-int-microsoft-input-cid" class="ac-input" placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx" autocomplete="off">
                </div>
                <div class="ac-field" style="margin-bottom:10px;">
                  <label class="ac-label">Client Secret Value</label>
                  <input type="password" id="ac-int-microsoft-input-secret" class="ac-input" placeholder="Client secret value (not ID)" autocomplete="off">
                </div>
                <div class="ac-field">
                  <label class="ac-label" style="color:var(--fg-muted);">Redirect URI (add to Azure App Registration)</label>
                  <code id="ac-int-microsoft-form-uri" style="font-size:11px;display:block;padding:6px 8px;background:var(--bg-base,#0d0d1a);border-radius:4px;word-break:break-all;"></code>
                </div>
                <div style="margin-top:12px;">
                  <button id="ac-int-microsoft-save" class="ac-btn ac-btn-primary">Save</button>
                </div>
              </div>
              <span id="ac-int-microsoft-status" class="ac-status" style="display:none;margin-top:8px;"></span>
              <details class="ac-details" style="margin-top:12px;">
                <summary>Setup instructions</summary>
                <div class="ac-details-body">
                  <ol style="margin:6px 0 0 16px;padding:0;">
                    <li>Go to <a href="https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps/ApplicationsListBlade" target="_blank" style="color:var(--accent);">Azure Portal → App registrations</a></li>
                    <li>Click <strong>New registration</strong> — choose "Accounts in any organizational directory and personal Microsoft accounts"</li>
                    <li>Under <strong>Authentication</strong>, add the Redirect URI above as a Web platform redirect</li>
                    <li>Under <strong>Certificates &amp; secrets</strong>, create a new Client secret and copy its <em>Value</em></li>
                    <li>Copy the Application (Client) ID and Secret Value into the fields above and click Save</li>
                    <li>Under <strong>API permissions</strong>, add: User.Read, Mail.ReadWrite, Mail.Send, Calendars.ReadWrite, Files.ReadWrite.All, Sites.ReadWrite.All (delegated)</li>
                  </ol>
                </div>
              </details>
            </div>

            <!-- Yahoo OAuth Config -->
            <div class="ac-card" id="ac-int-yahoo-card">
              <div style="display:flex;align-items:center;gap:12px;margin-bottom:12px;">
                <svg viewBox="0 0 24 24" width="24" height="24" style="flex-shrink:0;">
                  <path fill="#6001D2" d="M0 4h6.5l3.5 8.5L13.5 4H20l-7.5 16H7L9 16 0 4z"/>
                  <circle fill="#6001D2" cx="20" cy="20" r="3"/>
                </svg>
                <div style="flex:1;">
                  <div style="font-weight:600;font-size:14px;">Yahoo OAuth</div>
                  <div class="ac-hint" style="margin:0;">Yahoo Mail — app-level credentials</div>
                </div>
                <span id="ac-int-yahoo-badge" class="ac-int-badge ac-int-badge-off">Not configured</span>
              </div>

              <div id="ac-int-yahoo-configured" style="display:none;font-size:12px;">
                <div style="display:flex;flex-direction:column;gap:6px;">
                  <div><span style="color:var(--fg-muted);">Client ID:</span> <code id="ac-int-yahoo-cid" style="font-size:11px;"></code></div>
                  <div><span style="color:var(--fg-muted);">Redirect URI:</span> <code id="ac-int-yahoo-uri" style="font-size:11px;word-break:break-all;"></code></div>
                  <div class="ac-hint" style="margin-top:4px;">Users connect their Yahoo accounts from each agent's <strong>Connections</strong> tab.</div>
                </div>
                <div style="margin-top:12px;">
                  <button id="ac-int-yahoo-unconfigure" class="ac-btn ac-btn-ghost" style="color:#f7768e;">Unconfigure</button>
                </div>
              </div>

              <div id="ac-int-yahoo-form" style="display:none;">
                <div class="ac-field" style="margin-bottom:10px;">
                  <label class="ac-label">Client ID (Consumer Key)</label>
                  <input type="text" id="ac-int-yahoo-input-cid" class="ac-input" placeholder="dj0yJi..." autocomplete="off">
                </div>
                <div class="ac-field" style="margin-bottom:10px;">
                  <label class="ac-label">Client Secret (Consumer Secret)</label>
                  <input type="password" id="ac-int-yahoo-input-secret" class="ac-input" placeholder="Consumer secret" autocomplete="off">
                </div>
                <div class="ac-field">
                  <label class="ac-label" style="color:var(--fg-muted);">Redirect URI (add to Yahoo Developer Console)</label>
                  <code id="ac-int-yahoo-form-uri" style="font-size:11px;display:block;padding:6px 8px;background:var(--bg-base,#0d0d1a);border-radius:4px;word-break:break-all;"></code>
                </div>
                <div style="margin-top:12px;">
                  <button id="ac-int-yahoo-save" class="ac-btn ac-btn-primary">Save</button>
                </div>
              </div>
              <span id="ac-int-yahoo-status" class="ac-status" style="display:none;margin-top:8px;"></span>
              <details class="ac-details" style="margin-top:12px;">
                <summary>Setup instructions</summary>
                <div class="ac-details-body">
                  <ol style="margin:6px 0 0 16px;padding:0;">
                    <li>Go to <a href="https://developer.yahoo.com/apps/create/" target="_blank" style="color:var(--accent);">Yahoo Developer Console → Create App</a></li>
                    <li>Select <strong>Web Application</strong>, enable <strong>OpenID Connect</strong> and <strong>Yahoo Mail API</strong></li>
                    <li>Add the <strong>Redirect URI</strong> above to the app's Callback Domain / Redirect URI list</li>
                    <li>Copy the Consumer Key (Client ID) and Consumer Secret into the fields above and click Save</li>
                  </ol>
                </div>
              </details>
            </div>

            <!-- Dropbox OAuth Config -->
            <div class="ac-card" id="ac-int-dropbox-card">
              <div style="display:flex;align-items:center;gap:12px;margin-bottom:12px;">
                <svg viewBox="0 0 24 24" width="24" height="24" style="flex-shrink:0;">
                  <path fill="#0061FF" d="M6 2L1 5.5 6 9l5-3.5L6 2zM1 12.5L6 16l5-3.5L6 9l-5 3.5zM6 16l5 3.5 5-3.5-5-3.5L6 16zM16 2l-5 3.5L16 9l5-3.5L16 2zM11 9l5 3.5 5-3.5L16 6l-5 3z"/>
                </svg>
                <div style="flex:1;">
                  <div style="font-weight:600;font-size:14px;">Dropbox OAuth</div>
                  <div class="ac-hint" style="margin:0;">File storage and sharing — app-level credentials</div>
                </div>
                <span id="ac-int-dropbox-badge" class="ac-int-badge ac-int-badge-off">Not configured</span>
              </div>

              <div id="ac-int-dropbox-configured" style="display:none;font-size:12px;">
                <div style="display:flex;flex-direction:column;gap:6px;">
                  <div><span style="color:var(--fg-muted);">App Key:</span> <code id="ac-int-dropbox-cid" style="font-size:11px;"></code></div>
                  <div><span style="color:var(--fg-muted);">Redirect URI:</span> <code id="ac-int-dropbox-uri" style="font-size:11px;word-break:break-all;"></code></div>
                  <div class="ac-hint" style="margin-top:4px;">Users connect their Dropbox accounts from each agent's <strong>Connections</strong> tab.</div>
                </div>
                <div style="margin-top:12px;">
                  <button id="ac-int-dropbox-unconfigure" class="ac-btn ac-btn-ghost" style="color:#f7768e;">Unconfigure</button>
                </div>
              </div>

              <div id="ac-int-dropbox-form" style="display:none;">
                <div class="ac-field" style="margin-bottom:10px;">
                  <label class="ac-label">App Key</label>
                  <input type="text" id="ac-int-dropbox-input-cid" class="ac-input" placeholder="abcdefg1234567" autocomplete="off">
                </div>
                <div class="ac-field" style="margin-bottom:10px;">
                  <label class="ac-label">App Secret</label>
                  <input type="password" id="ac-int-dropbox-input-secret" class="ac-input" placeholder="App secret" autocomplete="off">
                </div>
                <div class="ac-field">
                  <label class="ac-label" style="color:var(--fg-muted);">Redirect URI (add to Dropbox App Console)</label>
                  <code id="ac-int-dropbox-form-uri" style="font-size:11px;display:block;padding:6px 8px;background:var(--bg-base,#0d0d1a);border-radius:4px;word-break:break-all;"></code>
                </div>
                <div style="margin-top:12px;">
                  <button id="ac-int-dropbox-save" class="ac-btn ac-btn-primary">Save</button>
                </div>
              </div>
              <span id="ac-int-dropbox-status" class="ac-status" style="display:none;margin-top:8px;"></span>
              <details class="ac-details" style="margin-top:12px;">
                <summary>Setup instructions</summary>
                <div class="ac-details-body">
                  <ol style="margin:6px 0 0 16px;padding:0;">
                    <li>Go to <a href="https://www.dropbox.com/developers/apps/create" target="_blank" style="color:var(--accent);">Dropbox App Console → Create app</a></li>
                    <li>Choose <strong>Scoped access</strong> → <strong>Full Dropbox</strong></li>
                    <li>On the Settings tab, add the <strong>Redirect URI</strong> above under <em>OAuth 2 → Redirect URIs</em></li>
                    <li>On the Permissions tab, enable: account_info.read, files.metadata.read/write, files.content.read/write, sharing.read/write</li>
                    <li>Copy the App Key and App Secret into the fields above and click Save</li>
                  </ol>
                </div>
              </details>
            </div>

            <!-- ── Social Media ── -->
            <div class="ac-section-header" style="margin-top:24px;">
              <i data-lucide="share-2" class="lucide-icon ac-section-icon"></i>
              <div>
                <h3 class="ac-section-title" style="font-size:14px;">Social Media</h3>
                <p class="ac-section-desc">App-level credentials for social platform OAuth. Users connect their personal accounts from the agent's Connections tab.</p>
              </div>
            </div>

            <!-- Meta (Facebook + Instagram) OAuth Config -->
            <div class="ac-card" id="ac-int-meta-card">
              <div style="display:flex;align-items:center;gap:12px;margin-bottom:12px;">
                <svg viewBox="0 0 24 24" width="24" height="24" style="flex-shrink:0;">
                  <path fill="#1877F2" d="M24 12.073C24 5.406 18.627 0 12 0S0 5.406 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047V9.41c0-3.025 1.79-4.697 4.533-4.697 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.93-1.956 1.886v2.286h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073z"/>
                </svg>
                <div style="flex:1;">
                  <div style="font-weight:600;font-size:14px;">Meta OAuth (Facebook + Instagram)</div>
                  <div class="ac-hint" style="margin:0;">One Meta App covers both Facebook and Instagram — app-level credentials</div>
                </div>
                <span id="ac-int-meta-badge" class="ac-int-badge ac-int-badge-off">Not configured</span>
              </div>

              <div id="ac-int-meta-configured" style="display:none;font-size:12px;">
                <div style="display:flex;flex-direction:column;gap:6px;">
                  <div><span style="color:var(--fg-muted);">App ID:</span> <code id="ac-int-meta-cid" style="font-size:11px;"></code></div>
                  <div><span style="color:var(--fg-muted);">Redirect URI:</span> <code id="ac-int-meta-uri" style="font-size:11px;word-break:break-all;"></code></div>
                  <div class="ac-hint" style="margin-top:4px;">Users connect from the agent's <strong>Connections</strong> tab.</div>
                </div>
                <div style="margin-top:12px;">
                  <button id="ac-int-meta-unconfigure" class="ac-btn ac-btn-ghost" style="color:#f7768e;">Unconfigure</button>
                </div>
              </div>

              <div id="ac-int-meta-form" style="display:none;">
                <div class="ac-field" style="margin-bottom:10px;">
                  <label class="ac-label">App ID</label>
                  <input type="text" id="ac-int-meta-input-cid" class="ac-input" placeholder="1234567890" autocomplete="off">
                </div>
                <div class="ac-field" style="margin-bottom:10px;">
                  <label class="ac-label">App Secret</label>
                  <input type="password" id="ac-int-meta-input-secret" class="ac-input" placeholder="App secret" autocomplete="off">
                </div>
                <div class="ac-field">
                  <label class="ac-label" style="color:var(--fg-muted);">Redirect URI (add to Meta App → Valid OAuth Redirect URIs)</label>
                  <code id="ac-int-meta-form-uri" style="font-size:11px;display:block;padding:6px 8px;background:var(--bg-base,#0d0d1a);border-radius:4px;word-break:break-all;"></code>
                </div>
                <div style="margin-top:12px;">
                  <button id="ac-int-meta-save" class="ac-btn ac-btn-primary">Save</button>
                </div>
              </div>
              <span id="ac-int-meta-status" class="ac-status" style="display:none;margin-top:8px;"></span>
              <details class="ac-details" style="margin-top:12px;">
                <summary>Setup instructions</summary>
                <div class="ac-details-body">
                  <ol style="margin:6px 0 0 16px;padding:0;">
                    <li>Go to <a href="https://developers.facebook.com/apps/" target="_blank" style="color:var(--accent);">Meta for Developers → Create App</a></li>
                    <li>Choose <strong>Business</strong> type and add <strong>Facebook Login</strong> product</li>
                    <li>In <em>Facebook Login → Settings</em>, add the Redirect URI above to <strong>Valid OAuth Redirect URIs</strong></li>
                    <li>Copy the App ID and App Secret from <em>Settings → Basic</em> into the fields above and click Save</li>
                  </ol>
                </div>
              </details>
            </div>

            <!-- Twitter/X OAuth Config -->
            <div class="ac-card" id="ac-int-twitter-card">
              <div style="display:flex;align-items:center;gap:12px;margin-bottom:12px;">
                <svg viewBox="0 0 24 24" width="24" height="24" style="flex-shrink:0;">
                  <path fill="#000000" d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.737-8.835L1.254 2.25H8.08l4.259 5.631 5.905-5.631zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
                <div style="flex:1;">
                  <div style="font-weight:600;font-size:14px;">X (Twitter) OAuth</div>
                  <div class="ac-hint" style="margin:0;">Twitter API v2 with PKCE — app-level credentials</div>
                </div>
                <span id="ac-int-twitter-badge" class="ac-int-badge ac-int-badge-off">Not configured</span>
              </div>

