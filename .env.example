# Supabase configuration
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# LLM provider configuration (set via ⚙️ Settings UI, or override here)
# Generic vars (preferred — work with any OpenAI-compatible provider):
LLM_API_KEY=your_api_key
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-v4-flash

# Legacy OpenRouter-specific vars (fallback if LLM_* not set):
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_REFERER=
OPENROUTER_TITLE=webAgent

# Application settings
ENVIRONMENT=development
LOG_LEVEL=INFO

# Telegram Bot (from @BotFather)
TELEGRAM_BOT_TOKEN=

# Twilio (for WhatsApp, SMS, Voice — optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
TWILIO_SMS_NUMBER=

# Meta WhatsApp Cloud API (alternative to Twilio — optional)
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=
META_WA_BUSINESS_ACCOUNT_ID=
META_WA_VERIFY_TOKEN=

# Google OAuth (for Integrations page)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# File upload settings
MAX_UPLOAD_SIZE_MB=25
UPLOAD_DIR=uploads
