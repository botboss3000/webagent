# Supabase configuration
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ── Local Postgres (optional; SQLite is the zero-config default) ──────────────
# Bring up a local Postgres+pgvector:  docker compose -f docker-compose.postgres.yml up -d
# Then either activate it in the Admin → Storage modal, or env-lock it below.
# WEBAGENT_CONFIG_SOURCE=env        # makes the WEBAGENT_DB_* vars authoritative
# WEBAGENT_DB_PROVIDER=postgres     # postgres | neon | gcp_cloud_sql | supabase | sqlite
# WEBAGENT_DB_HOST=localhost
# WEBAGENT_DB_PORT=5433
# WEBAGENT_DB_NAME=webagent
# WEBAGENT_DB_USER=webagent
# WEBAGENT_DB_PASSWORD=webagent     # for remote, prefer the secrets vault over plaintext
# WEBAGENT_DB_SSLMODE=disable       # disable for local docker; require/verify-full for remote

# LLM provider configuration (set via ⚙️ Settings UI, or override here)
# Generic vars (preferred — work with any OpenAI-compatible provider):
LLM_API_KEY=your_api_key
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-v4-flash

# Legacy OpenRouter-specific vars (fallback if LLM_* not set):
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_REFERER=
OPENROUTER_TITLE=WebAgent

# Application settings
ENVIRONMENT=development
LOG_LEVEL=INFO

# Browser request boundary. Same-origin is always allowed and is the secure
# default. Add only exact canonical origins (comma-separated, no path/wildcard/
# null/default port); public embed origins are a separate per-agent policy.
WEBAGENT_ALLOWED_ORIGINS=
# Bearer-token APIs do not need credentialed CORS. Enable only after approving
# a secure cookie-authenticated endpoint and its CSRF controls.
WEBAGENT_CORS_ALLOW_CREDENTIALS=false
# report-only | enforce | disabled. Remediate reports before enforcing.
WEBAGENT_CSP_MODE=report-only

# Telegram Bot (from @BotFather)
TELEGRAM_BOT_TOKEN=

# Twilio (for WhatsApp, SMS, Voice — optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
TWILIO_SMS_NUMBER=

# Meta WhatsApp Cloud API (alternative to Twilio — optional)
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=
META_WA_BUSINESS_ACCOUNT_ID=
META_WA_VERIFY_TOKEN=

# Google OAuth (for Integrations page — Gmail, Drive, Docs, Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft OAuth (for Integrations page — Outlook, OneDrive, SharePoint)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Yahoo OAuth (for Integrations page — Yahoo Mail)
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=

# Dropbox OAuth (for Integrations page — file storage)
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

# Meta (Facebook + Instagram) OAuth — one app covers both platforms
META_APP_ID=
META_APP_SECRET=

# Twitter/X OAuth 2.0 (PKCE)
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# TikTok OAuth (PKCE)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Pinterest OAuth
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# Reddit OAuth
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Snapchat OAuth
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=

# Twitch OAuth
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ── Marketplace integrations ────────────────────────────────────────────
# eBay OAuth (Buy + Sell APIs)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Etsy OAuth (Open API v3, PKCE)
ETSY_CLIENT_ID=
ETSY_CLIENT_SECRET=

# Shopify (Partner app — Admin API, per-shop install)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Amazon Selling Partner API (LWA OAuth)
# AMAZON_SP_APP_ID is the Seller Central application id (separate from the LWA client_id)
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_SP_APP_ID=

# File upload settings
MAX_UPLOAD_SIZE_MB=25
UPLOAD_DIR=uploads

# ── Billing / monetization ─────────────────────────────────────────────
# Stripe (Checkout + Connect Express marketplace split)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PLATFORM_STRIPE_ACCOUNT_ID=

# PayPal (Orders + Subscriptions + Marketplace platform_fees split)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PLATFORM_PAYPAL_MERCHANT_ID=
# Default subscription plan id (set up once in the PayPal dashboard)
PAYPAL_DEFAULT_PLAN_ID=

# Gen UI storage backend: filesystem | database | hybrid
# Default = filesystem (best for local-hosted). Switch to database for stateless
# cloud deploys (Cloud Run, Fly.io, etc.) where the disk is wiped on restart.
# Only honored when WEBAGENT_CONFIG_SOURCE=env; otherwise the value is set
# from the App Config → Storage panel.
WEBAGENT_GENUI_STORE=filesystem

# Experimental browser storage. Both paths are disabled by default until their
# isolation, migration, quota, and invalidation contracts are fully hardened.
# Browser authority means IndexedDB owns session transcripts. Browser session
# cache keeps server SQLite authoritative and mirrors read data into IndexedDB.
WEBAGENT_ENABLE_BROWSER_AUTHORITY=false
WEBAGENT_ENABLE_BROWSER_SESSION_CACHE=false
# Stable per-user rollout after the main cache gate is enabled (0-100).
WEBAGENT_BROWSER_CACHE_CANARY_PERCENT=100
# Emergency fail-closed override; the rollback script can also set a local marker.
WEBAGENT_BROWSER_CACHE_ROLLBACK=false
# Browser cache/retention policy. These limits do not enable either feature.
# persistent_cache | memory_only | disabled
WEBAGENT_BROWSER_STORAGE_MODE=persistent_cache
WEBAGENT_BROWSER_POLICY_EPOCH=1
WEBAGENT_BROWSER_METADATA_TTL_SECONDS=0
WEBAGENT_BROWSER_TRANSCRIPT_TTL_SECONDS=0
WEBAGENT_BROWSER_RUN_STATE_TTL_SECONDS=0
WEBAGENT_BROWSER_GENERATED_HTML_TTL_SECONDS=0
WEBAGENT_BROWSER_CACHE_MAX_BYTES=52428800
WEBAGENT_BROWSER_TOMBSTONE_DAYS=90
WEBAGENT_BROWSER_SYNC_RECEIPT_DAYS=30
WEBAGENT_TURN_RESERVATION_HOURS=24
WEBAGENT_BROWSER_TELEMETRY_ENABLED=true
WEBAGENT_BROWSER_TELEMETRY_REDACT_PAYLOADS=true
WEBAGENT_BROWSER_EXPORT_ENABLED=true
WEBAGENT_BROWSER_DELETE_ENABLED=true

# ── User feedback → GitHub issues (relayed) ─────────────────────────────
# Feedback the user submits via the in-app form is POSTed to a Cloudflare
# Worker (the "relay") which creates an issue in the private feedback repo.
# By default the app talks to the upstream relay at feedback.webagent.live;
# cloners can override either of these (also exposed in app-settings.json).
# TURNSTILE_SITE_KEY is the *public* Cloudflare Turnstile site key that the
# browser uses; the matching secret key lives on the relay, never here.
# WEBAGENT_VERSION is optional metadata included with each submission.
TURNSTILE_SITE_KEY=
WEBAGENT_VERSION=
