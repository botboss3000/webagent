{
  "version": 3,
  "description": "Chat presentation defaults. chat_common is the shared base; each chat_* surface overrides only the values it needs.",
  "tier_gates": {
    "description": "Server-authoritative capability gates for the complete chat UI document. The server removes this block, resolves subject/tier overlays, and forces denied controls off after per-agent overrides. Requirements use named capabilities rather than tier rank so custom tiers work correctly.",
    "requires": {
      "features": ["chat"]
    },
    "controls": {
      "model_changer": {"features": ["model_picker"]},
      "storage_mode": {"features": ["user_byod"]},
      "sub_agent_tabs": {"ability_groups": ["agent_orchestration"]},
      "local_changes": {"ability_groups": ["developer_write"]},
      "message_id": {"admin_only": true},
      "agent_id": {"admin_only": true},
      "session_id": {"admin_only": true},
      "engine_thread_id": {"admin_only": true}
    },
    "subjects": {},
    "tiers": {
      "anonymous": {
        "chat_common": {
          "message_gutters": {
            "user": {
              "controls": {
                "undo": {
                  "locked": true,
                  "locked_feature": "Undo"
                }
              }
            },
            "agent": {
              "controls": {
                "fork": {
                  "locked": true,
                  "locked_feature": "Fork"
                }
              }
            }
          },
          "active_footer": {
            "chat_pill": {
              "controls": {
                "attach": {
                  "locked": true,
                  "locked_message": "Register to attach files and unlock the full app.",
                  "locked_cta": "Register"
                }
              }
            }
          },
          "idle_footer": {
            "chat_pill": {
              "controls": {
                "attach": {
                  "locked": true,
                  "locked_message": "Register to attach files and unlock the full app.",
                  "locked_cta": "Register"
                }
              }
            }
          },
          "chat_header": {
            "controls": {
              "session_dropdown": {
                "menu": {
                  "content_search": false,
                  "batch_delete": false,
                  "grouping": false
                }
              }
            }
          }
        }
      },
      "free": {},
      "pro": {}
    },
    "admin": {}
  },
  "chat_common": {
    "description": "Shared configuration for every chat surface. Surface profiles inherit this object at runtime, including its messages.",
    "content_max_width": "1000px",
    "message_visibility": {
      "description": "Independent show/hide per message lane type. These defaults apply when the user has no per-device override; the header filter popover (elements/visibility) writes overrides to localStorage and re-renders the transcript.",
      "defaults": {
        "main": true,
        "progress": true,
        "tool": true,
        "summary": true,
        "system": true
      }
    },
    "message_gutters": {
      "description": "Configurable footer gutters beneath user and agent messages. Order arrays replace entirely on surface or agent override. A locked control stays visible but displays its locked_message instead of executing. Tier gates are reapplied after agent overrides.",
      "user": {
        "enabled": true,
        "order": ["time", "copy", "undo", "delete", "more"],
        "controls": {
          "time": {"enabled": true},
          "copy": {"enabled": true},
          "undo": {
            "enabled": true,
            "locked": false,
            "locked_message": "Sign in to undo messages."
          },
          "delete": {"enabled": true},
          "more": {"enabled": true}
        }
      },
      "agent": {
        "enabled": true,
        "order": ["time", "collapse", "read_aloud", "copy", "fork", "delete", "schema", "more"],
        "controls": {
          "time": {"enabled": true},
          "collapse": {"enabled": true},
          "read_aloud": {"enabled": true},
          "copy": {"enabled": true},
          "fork": {
            "enabled": true,
            "locked": false,
            "locked_message": "Sign in to fork a conversation."
          },
          "delete": {"enabled": true},
          "schema": {"enabled": true},
          "more": {"enabled": true}
        }
      },
      "more_menu": {
        "enabled": true,
        "order": ["context", "cost", "model", "message_id", "refresh"],
        "controls": {
          "context": {"enabled": true},
          "cost": {"enabled": true},
          "model": {"enabled": true},
          "message_id": {"enabled": true},
          "refresh": {"enabled": true}
        }
      }
    },
    "chat_header": {
      "description": "Header layout and controls. Row arrays replace entirely on surface override. Each row has left/center/right zones; 'right' is pushed via margin-left:auto.",
      "enabled": true,
      "max_width": "750px",
      "rows": [
        {
          "left": [],
          "center": [
            "icon",
            "title",
            "status",
            "dot"
          ],
          "right": [
            "visibility",
            "close"
          ]
        }
      ],
      "controls": {
        "session_dropdown": {
          "description": "Session selector trigger and menu. Every affordance can be disabled independently; tier_gates may apply a final server-enforced override.",
          "enabled": true,
          "trigger": {
            "agent_icon": true,
            "status": true,
            "row_actions": true,
            "delete": true,
            "rename_on_hold": true
          },
          "menu": {
            "width": "min(420px, calc(100vw - 16px))",
            "max_height": "min(70vh, 640px)",
            "agent_icons": true,
            "status": true,
            "grouping": true,
            "pinning": true,
            "rename": true,
            "auto_rename": true,
            "row_actions": true,
            "delete": true,
            "agent_id": true,
            "session_id": true,
            "engine_thread_id": true,
            "search": true,
            "content_search": true,
            "recycle_bin": true,
            "hidden_sessions": true,
            "batch_delete": true
          }
        },
        "icon": {
          "container_size": "28px"
        },
        "title": {
          "container_size": "28px"
        },
        "status": {
          "container_size": "28px"
        },
        "dot": {
          "container_size": "28px"
        },
        "close": {
          "container_size": "28px"
        }
      }
    },
    "component_panel": {
      "description": "Agent component panel — the single surface for present_chat_component renderings. Drawer that slides from behind the chat pill; the grabber bar floats above the panel's top edge and is draggable (pull up/down, rubber-band like the composer). Width defaults to 85% of the live pill width, radius to 12px (structural CSS in app1.css); override with \"width\" / \"radius\" (any CSS length).",
      "enabled": true
    },
    "active_footer": {
      "description": "Full-featured footer shown when the textarea is focused or has content.",
      "margin_bottom": "0px",
      "chat_pill": {
        "description": "Shared two-row composer. Row 1: full-width textarea. Row 2: left=attach, center=carousel(stats), right=stop/continue/send.",
        "pill_width": "500px",
        "pill_radius": "41px",
        "rows": [
          {
            "center": {
              "controls": [
                "textarea"
              ]
            }
          },
          {
            "left": {
              "controls": [
                "attach"
              ],
              "align": "bottom",
              "padding": "4px 2px 20px 20px"
            },
            "center": {
              "carousel": [
                "stats"
              ],
              "align": "bottom",
              "padding": "0 0 28px 0"
            },
            "right": {
              "controls": [
                "stop",
                "continue",
                "mic_send"
              ],
              "align": "bottom",
              "padding": "4px 20px 20px 0"
            }
          }
        ],
        "controls": {
          "textarea": {
            "min_height": "88px",
            "font_size": "16px",
            "max_height": "180px",
            "padding": "28px 20px 13px 20px"
          },
          "stats": {
            "description": "Usage stats shown in the pill. visible = ordered list of stat types: ctx (current context only, e.g. 77.2k), ctx-max (full 'ctx 77.2k / 200k' current/max readout), cost (price, e.g. $0.12). Each entry is a plain string or { type, decimals } — decimals overrides the default (ctx: 1 below 1M, 2 above; cost: 2, rounded up so the first charge reads $0.01). A stat hides itself while its value is zero.",
            "visible": [
              { "type": "ctx" },
              { "type": "cost" }
            ]
          },
          "attach": {
            "enabled": true,
            "locked": false,
            "locked_message": "Register to attach files and unlock the full app.",
            "locked_cta": "Register",
            "element_size": "36px",
            "container_size": "42px"
          },
          "stop": {
            "enabled": true,
            "element_size": "36px",
            "container_size": "42px"
          },
          "continue": {
            "enabled": true,
            "element_size": "36px",
            "container_size": "42px"
          },
          "send": {
            "enabled": true,
            "element_size": "36px",
            "container_size": "42px"
          },
          "mic": {
            "enabled": true,
            "element_size": "36px",
            "container_size": "42px"
          },
          "mic_send": {
            "enabled": true,
            "element_size": "36px",
            "container_size": "42px"
          }
        }
      },
      "above_pill": {
        "enabled": true,
        "description": "Rows above the chat pill. Five-row plan: row 0 = activity; rows 1-4 are reserved slots (empty rows render nothing \u00e2\u20ac\u201d drop controls into a row to activate it).",
        "rows": [
          {
            "left": [],
            "center": [
              "activity"
            ],
            "right": [
              "scroll_bottom"
            ]
          },
          {
            "left": [],
            "center": [
              "local_changes"
            ],
            "right": []
          },
          {
            "left": [],
            "center": [],
            "right": []
          },
          {
            "left": [],
            "center": [],
            "right": []
          },
          {
            "left": [],
            "center": [],
            "right": []
          }
        ],
        "controls": {
          "local_changes": {
            "enabled": true,
            "width": "200px",
            "max_lines": 3
          }
        }
      },
      "below_pill": {
        "enabled": true,
        "rows": [
          {
            "right": [
              "changes",
              "mode",
              "model_changer",
              "abilities"
            ]
          }
        ],
        "controls": {
          "abilities": {
            "container_size": "28px"
          },
          "changes": {
            "container_size": "28px",
            "admin_only": true
          },
          "target": {
            "container_size": "28px"
          },
          "mode": {
            "container_size": "28px",
            "square": false
          },
          "model_changer": {
            "container_size": "28px",
            "square": false
          }
        }
      }
    },
    "idle_footer": {
      "description": "Simplified footer shown when the textarea is empty and unfocused. Single row (left/center/right), same width as active footer, no stats, chips, or below.",
      "margin_bottom": "24px",
      "chat_pill": {
        "pill_width": "500px",
        "pill_radius": "41px",
        "rows": [
          {
            "left": {
              "controls": [
                "attach"
              ],
              "align": "center",
              "padding": "20px 0 20px 20px"
            },
            "center": {
              "controls": [
                "textarea"
              ],
              "align": "center",
              "padding": "0"
            },
            "right": {
              "controls": [
                "stop",
                "continue",
                "mic_send"
              ],
              "align": "center",
              "padding": "20px 20px 20px 0"
            }
          }
        ],
        "controls": {
          "textarea": {
            "min_height": "62px",
            "font_size": "16px",
            "max_height": "62px",
            "padding": "20px 8px 20px 8px"
          },
          "stop": {
            "enabled": true,
            "element_size": "36px",
            "container_size": "42px"
          },
          "continue": {
            "enabled": true,
            "element_size": "36px",
            "container_size": "42px"
          },
          "mic_send": {
            "enabled": true,
            "element_size": "36px",
            "container_size": "42px"
          },
          "mic": {
            "enabled": true,
            "element_size": "36px",
            "container_size": "42px"
          },
          "send": {
            "enabled": true,
            "element_size": "36px",
            "container_size": "42px"
          },
          "attach": {
            "enabled": true,
            "locked": false,
            "locked_message": "Register to attach files and unlock the full app.",
            "locked_cta": "Register",
            "element_size": "36px",
            "container_size": "42px"
          }
        }
      },
      "above_pill": {
        "enabled": true,
        "description": "Rows above the chat pill. Five-row plan: row 0 = activity; rows 1-4 are reserved slots (empty rows render nothing \u00e2\u20ac\u201d drop controls into a row to activate it).",
        "rows": [
          {
            "left": [],
            "center": [
              "activity"
            ],
            "right": [
              "scroll_bottom"
            ]
          },
          {
            "left": [],
            "center": [
              "local_changes"
            ],
            "right": []
          },
          {
            "left": [],
            "center": [],
            "right": []
          },
          {
            "left": [],
            "center": [],
            "right": []
          },
          {
            "left": [],
            "center": [],
            "right": []
          }
        ],
        "controls": {
          "local_changes": {
            "enabled": true,
            "width": "200px",
            "max_lines": 3
          }
        }
      },
      "below_pill": {
        "enabled": false
      }
    },
    "fade": {
      "description": "Vertical fade mask on the message scroller. top/bottom are pixel heights that fade to transparent at the edges. Set to 0 to disable on that edge.",
      "top": 100,
      "bottom": 160
    },
    "pill_fade": {
      "description": "Vertical fade mask on the pill textarea when content overflows. top/bottom are pixel heights for each fade band. bottom_offset shifts the bottom band closer to the edge (same thickness).",
      "top": 8,
      "bottom": 10,
      "bottom_offset": 0
    },
    "show_mid_turn_messages": true,
    "show_tool_calls": true,
    "classify_main_messages": true,
    "fold_main_messages": true,
    "mirror_activity_in_transcript": true,
    "messages": {
      "description": "Default user-facing copy. A surface's messages object may replace any individual string.",
      "welcome_bubble": "Welcome to WebAgent",
      "new_session_bubble": "New session. Start typing below.",
      "switched_agent_bubble": "Switched agent. New session started.",
      "pill_placeholder": "Chat with the agent",
      "pill_locked_placeholder": "Sign in to chat \u00e2\u20ac\u201d this app does not allow anonymous use.",
      "session_deleted_notice": "Session not found \u00e2\u20ac\u201d it was deleted.",
      "title": "Chat with us",
      "subtitle": "",
      "greeting": "Hi! How can I help you today?"
    }
  },
  "chat_desktop": {
    "description": "Desktop side-panel overrides. Leave values absent to use chat_common.",
    "messages": {},
    "chat_header": {
      "rows": [
        {
          "left": [],
          "center": [
            "agent_name"
          ],
          "right": [
