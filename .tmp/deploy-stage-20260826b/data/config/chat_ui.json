  "controls_library": {
    "description": "Reference catalog of every available chat control. NOT consumed by UI code \u00e2\u20ac\u201d exists solely so users can see what controls exist and what each is for.",
    "controls": {
      "agent_name": {
        "display_name": "Agent Name",
        "description": "Current agent name with agent-switcher dropdown",
        "targets": [
          "header",
          "footer"
        ],
        "icon": "bot"
      },
      "session_dropdown": {
        "display_name": "Session Dropdown",
        "description": "Session selector with chevron, label, and dropdown menu",
        "targets": [
          "header",
          "footer"
        ],
        "icon": "list"
      },
      "new_session": {
        "display_name": "New Session",
        "description": "Create a new chat session",
        "targets": [
          "header",
          "footer"
        ],
        "icon": "plus"
      },
      "session_prev": {
        "display_name": "Previous Session",
        "description": "Navigate to the previous pinned session",
        "targets": [
          "header",
          "footer"
        ],
        "icon": "arrow-big-left"
      },
      "session_next": {
        "display_name": "Next Session",
        "description": "Navigate to the next pinned session",
        "targets": [
          "header",
          "footer"
        ],
        "icon": "arrow-big-right"
      },
      "changes": {
        "display_name": "Session Changes",
        "description": "Toggle the file changes panel for the current session",
        "targets": [
          "header",
          "footer",
          "below_pill"
        ],
        "icon": "files"
      },
      "local_changes": {
        "display_name": "Local Changes",
        "description": "The working-tree panel above the pill (the new design): changed file paths with added/removed line counts, plus a commit button (top right) that commits exactly those files with a note. Hidden until the 'changes' chip below the pill toggles it open; the chip's count badge signals there is something to see",
        "targets": [
          "above_pill"
        ],
        "icon": "files"
      },
      "refresh": {
        "display_name": "Refresh Transcript",
        "description": "Refresh the chat transcript",
        "targets": [
          "header",
          "footer"
        ],
        "icon": "refresh-cw"
      },
      "delete_session": {
        "display_name": "Delete Session",
        "description": "Delete the current session",
        "targets": [
          "header",
          "footer"
        ],
        "icon": "trash-2"
      },
      "sub_agent_tabs": {
        "display_name": "Session Tabs",
        "description": "Recency-ordered tabs for session resources such as browsers, plans, checklists, pages, and sub-agents",
        "targets": [
          "header"
        ],
        "icon": "layers"
      },
      "top_nav": {
        "display_name": "Top Nav",
        "description": "Jump-to-top and jump-to-last-user buttons",
        "targets": [
          "header"
        ],
        "icon": "chevrons-up"
      },
      "abilities": {
        "display_name": "Abilities",
        "description": "Toggle abilities on/off for the current chat",
        "targets": [
          "header",
          "footer",
          "below_pill"
        ],
        "icon": "blocks"
      },
      "target": {
        "display_name": "Target Device",
        "description": "Choose which device runs the next message",
        "targets": [
          "header",
          "footer",
          "below_pill"
        ],
        "icon": "monitor"
      },
      "mode": {
        "display_name": "Execution Mode",
        "description": "Toggle execution mode: Ask \u00e2\u2020\u2019 Plan \u00e2\u2020\u2019 Auto",
        "targets": [
          "header",
          "footer",
          "below_pill"
        ],
        "icon": "toggle-left"
      },
      "model_changer": {
        "display_name": "Model Changer",
        "description": "Cycle through available models with chevron buttons",
        "targets": [
          "below_pill"
        ],
        "icon": "cpu"
      },
      "storage_mode": {
        "display_name": "Storage Mode",
        "description": "Toggle between browser-backed (IndexedDB) and server-backed storage",
        "targets": [
          "below_pill"
        ],
        "icon": "database"
      },
      "textarea": {
        "display_name": "Message Input",
        "description": "Multi-line message input that fills its pill zone",
        "targets": [
