<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.TerminalLauncher" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/bg_0</item>
        <item name="android:statusBarColor">@color/bg_1</item>
        <item name="android:navigationBarColor">@color/bg_1</item>
        <item name="colorPrimary">@color/accent_green</item>
        <item name="colorOnPrimary">#06210F</item>
        <item name="colorSurface">@color/bg_2</item>
        <item name="colorOnSurface">@color/fg_1</item>
    </style>

    <!-- Footer icon button: borderless, square, finger-friendly. -->
    <style name="FooterIconButton">
        <item name="android:layout_width">@dimen/footer_button</item>
        <item name="android:layout_height">@dimen/footer_button</item>
        <item name="android:background">@drawable/bg_footer_button</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:padding">@dimen/footer_pad</item>
        <item name="android:tint">@color/fg_1</item>
    </style>
</resources>
