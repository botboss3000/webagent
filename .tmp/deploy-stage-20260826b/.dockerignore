# ──────────────────────────────────────────────────────────────────────────────
#  .dockerignore — keep the build context lean and secrets out of the image
# ──────────────────────────────────────────────────────────────────────────────

# ── Python ─────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
*.egg
.venv/
venv/
env/

# ── Dependencies (rebuilt in-container) ────────────────────────────────────────
# The builder stage re-installs from requirements.txt, so no point copying them.
# Uncomment if you vendor dependencies locally:
# vendor/

# ── Version control ────────────────────────────────────────────────────────────
.git/
.gitattributes
.gitignore
.gitmodules
.svn/

# ── IDE / Editor ───────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# ── Testing / CI ───────────────────────────────────────────────────────────────
.coverage
htmlcov/
.pytest_cache/
.coverage.*
.tox/
test*.py
tests/
__tests__/
*.test.js

# ── Secrets & config (never ship these) ────────────────────────────────────────
.env
.env.*
*.pem
*.key
*.crt
*.cer
config/secrets.yml
credentials.json
service-account.json

# ── Logs & temp ────────────────────────────────────────────────────────────────
*.log
*.tmp
*.pid
*.bak
*.orig
/logs/

# ── Docker (prevent recursive issues) ──────────────────────────────────────────
Dockerfile
.dockerignore
docker-compose*.yml
docker-compose*.yaml

# ── Documentation (not needed at runtime) ──────────────────────────────────────
README.md
CHANGELOG.md
CONTRIBUTING.md
docs/
mkdocs.yml

# ── Container images / archives ────────────────────────────────────────────────
*.tar
*.tar.gz
*.tgz