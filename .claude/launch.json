{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "webagent-dev",
      "runtimeExecutable": "python",
      "runtimeArgs": ["run.py"],
      "port": 8080
    },
    {
      "name": "webagent-diag",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--host", "127.0.0.1", "--port", "8090"],
      "port": 8090
    },
    {
      "name": "web-terminal",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "7654", "--directory", "app/web-terminal"],
      "port": 7654
    }
  ]
}
