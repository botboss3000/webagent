# Ad-hoc prompt-slot dumps written to the project root (scratch; belong in temp/)
/tmp_*.txt

# ── Runtime databases (now under data/db/) ──────────────────────────────────
# All runtime DB *files* live in data/db/ (the app's stored state); the DB *code*
# stays in app/db/. Covers local.db, logs.db, recordings.db, vault.db, tests.db,
# and the optimizer/closer scratch DBs + their WAL/SHM/journal sidecars.
data/db/
local.db

# Company-wide Wiki: the wiki.db file itself IS tracked (committed to the repo),
# but its transient SQLite sidecars are not — they only exist mid-write.
data/wiki.db-journal
data/wiki.db-wal
data/wiki.db-shm

# ── Legacy app/db/ runtime DBs ──────────────────────────────────────────────
# Pre-data/db layout. The app relocates these into data/db/ on first run; kept
# ignored so a not-yet-relocated copy is never accidentally committed.
app/db/local.db
app/db/local.db-journal
app/db/local.db-wal
app/db/local.db-shm
app/db/local.db.preprompt-bak
local.db

# Dedicated, always-local logs databases (server diagnostics + browser render
# recorder) and the per-box instance id. Runtime artifacts — see app/db/logs_store.py.
app/db/logs.db
app/db/logs.db-journal
app/db/logs.db-wal
app/db/logs.db-shm
app/db/recordings.db
app/db/recordings.db-journal
app/db/recordings.db-wal
app/db/recordings.db-shm
app/db/instance_id.txt

# Dedicated credentials "vault" DB (auth_elements — integration OAuth tokens +
# inline secret values), kept out of the user-data DB so a reset is non-destructive.
app/db/vault.db
app/db/vault.db-journal
app/db/vault.db-wal
app/db/vault.db-shm

# Per-user runtime "closer" DBs (created by the running app)
app/db/closer_*.db
app/db/closer_*.db-journal
app/db/closer_*.db-wal
app/db/closer_*.db-shm

# Optimizer runtime temp DBs (worker trials + planner sessions)
app/db/test_*.db
app/db/test_*.db-journal
app/db/test_*.db-wal
app/db/test_*.db-shm
app/db/optimizer_*.db
app/db/optimizer_*.db-journal
app/db/optimizer_*.db-wal
app/db/optimizer_*.db-shm

# Per-machine runtime artifacts (Android/proot etc.)
.proot.pid
start_server_proot.sh

# Runtime auth + config (per-machine, contains hashes/tokens)
db_connection.json
/db_mode.json
app/auth/users.json
app/auth/users.json.bak
app/db_mode.json
app/db_connection.json
app/secrets_mode.json
app/pages_mode.json
app/attachments_store_config.json
# Remote Access (per-machine config + the signpost directory written at runtime)
remote_access.json
remote_access.json.bak
remote_access_pointers.json

# FUSE / SSHFS temp leftovers
app/db/.fuse_hidden*
**/.fuse_hidden*

# Visuals user-generated artifacts (moved under data/)
data/visuals/users/

# Runtime backup files created by write_source tool
*.bak

# Uploads + visuals (runtime artifacts now live under data/)
data/uploads/*
!data/uploads/.gitkeep
data/visuals/

# Scratch / backup / PID files — kept on disk, never tracked
.source-backups/
tmp/
bg_pid.txt
TUI/server.pid
TUI/self-update/

# Launcher build output: the single portable webagent.exe now lands at the
# PROJECT ROOT (built from launcher/ via launcher/scripts/build_exe.py).
# Scratch build dirs stay under launcher/. None of these are committed.
/webagent.exe
launcher/*.exe
launcher/*snapshot*.svg
launcher/assets/webagent.ico
launcher/assets/webagent_256.png
launcher/dist/
launcher/build/

# launcher_android runtime bridge file (Browser button host↔proot)
launcher_android/.browser-bridge
