/* webAgent Server Manager — Textual CSS.
 *
 * Every color is a THEME VARIABLE (no literal hex) so the UI re-skins live
 * across all 23 shared themes and stays legible in light AND dark schemes.
 * Custom tokens ($dim, $tool, $bar-bg, $bar-fg, $bar-accent, $border-dim,
 * $sel) come from each theme plus the app's get_theme_variable_defaults().
 */

Screen {
    background: $background;
    color: $foreground;
}

/* Custom header toolbar — clickable control buttons + live server status. */
#status {
    layout: horizontal;
    height: 1;
    width: 100%;
    background: $bar-bg;
    color: $bar-fg;
    padding: 0 2;
}
#status .hdr-btn { width: auto; margin: 0 2 0 0; color: $bar-accent; }
#status .hdr-btn:hover { color: $bar-fg; text-style: bold; }
#status .hdr-note { width: auto; margin: 0 2 0 0; }

/* Animated logo banner (vendored from the launcher) — fixed height above the log. */
#anim { height: 7; width: 100%; }

/* Session HUD (tokens + context gauge) + loop-reactive walker, above the input. */
#hud { height: 1; width: 100%; background: $panel; color: $dim; padding: 0 2; }
#walker { height: 1; width: 100%; padding: 0 2; }

/* Onboarding call-to-action — the tappable "get started" button (hidden once a
 * checkout is linked). Theme variables only, so it stays legible in every theme. */
#cta {
    height: 3;
    width: 100%;
    content-align: center middle;
    text-align: center;
    text-style: bold;
    color: $bar-accent;
    background: $panel;
    border: round $primary;
}
#cta:hover { background: $primary; color: $background; }

/* Theme & animation picker (settings modal). */
SettingsModal { align: center middle; }
#settings-panel {
    width: 64; height: auto; max-height: 90%;
    background: $panel; border: round $primary; padding: 1 2;
}
#settings-title { text-style: bold; color: $bar-accent; margin-bottom: 1; }
.set-row { height: 3; width: 100%; }
.set-row .set-label { width: 12; height: 3; content-align: left middle; color: $dim; }
.set-row Select { width: 1fr; }

#log {
    height: 1fr;
    width: 100%;
    background: $background;
    border: round $border-dim;
    padding: 0 1;
    scrollbar-gutter: stable;
    scrollbar-size-vertical: 1;
    scrollbar-color: $primary $background;
    scrollbar-color-hover: $primary-lighten-2 $background;
    scrollbar-color-active: $primary-lighten-2 $background;
    scrollbar-background: $background;
}

#prompt {
    width: 100%;
    height: 3;
    border: round $border-dim;
    background: $panel;
    color: $foreground;
}
#prompt:focus {
    border: round $primary;
}

/* Footer legend — editing / exit shortcuts. */
#hints {
    height: 1;
    width: 100%;
    background: $bar-bg;
    color: $bar-fg;
    padding: 0 2;
}
