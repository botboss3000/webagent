<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="SectionHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/accent_green</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:paddingBottom">@dimen/space_s</item>
    </style>

    <style name="FieldLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/fg_2</item>
        <item name="android:textSize">13sp</item>
        <item name="android:paddingTop">@dimen/space_s</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <style name="PanelInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">@color/fg_1</item>
        <item name="android:textColorHint">@color/fg_muted</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:padding">@dimen/space_m</item>
    </style>
</resources>
