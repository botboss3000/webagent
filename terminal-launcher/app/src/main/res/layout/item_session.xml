<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_shortcut"
    android:layout_marginHorizontal="@dimen/space_m"
    android:layout_marginVertical="4dp"
    android:padding="@dimen/space_m">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <View
            android:id="@+id/item_status_dot"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginEnd="@dimen/space_s"
            android:background="@drawable/dot_idle" />

        <TextView
            android:id="@+id/item_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/fg_1"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="session 1" />

        <ImageButton
            android:id="@+id/item_rename"
            style="@style/FooterIconButton"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/ic_edit"
            android:contentDescription="Rename" />

        <ImageButton
            android:id="@+id/item_duplicate"
            style="@style/FooterIconButton"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/ic_sessions"
            android:contentDescription="Duplicate" />

        <ImageButton
            android:id="@+id/item_close"
            style="@style/FooterIconButton"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/ic_close"
            android:contentDescription="Close session" />
    </LinearLayout>

    <TextView
        android:id="@+id/item_path"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/fg_3"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:maxLines="1"
        android:ellipsize="middle"
        tools:text="~/projects/webagent" />

    <TextView
        android:id="@+id/item_lastcmd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/fg_2"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:maxLines="1"
        android:ellipsize="end"
        tools:text="$ claude" />

    <TextView
        android:id="@+id/item_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/fg_muted"
        android:textSize="11sp"
        tools:text="idle  ·  2m ago" />
</LinearLayout>
