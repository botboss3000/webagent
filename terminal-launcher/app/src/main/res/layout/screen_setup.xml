<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_0"
    android:fillViewport="true"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="28dp">

        <Space android:layout_width="match_parent" android:layout_height="48dp" />

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_terminal"
            android:tint="@color/accent_green"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/setup_title"
            android:textColor="@color/fg_1"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:text="@string/setup_body"
            android:textColor="@color/fg_2"
            android:textSize="15sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/setup_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:padding="@dimen/space_m"
            android:background="@drawable/bg_input"
            android:textColor="@color/fg_1"
            android:textSize="14sp"
            android:gravity="center" />

        <ProgressBar
            android:id="@+id/setup_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:max="100"
            android:visibility="gone" />

        <Button
            android:id="@+id/setup_install"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/setup_install"
            android:textColor="#06210F"
            android:backgroundTint="@color/accent_green" />

        <Button
            android:id="@+id/setup_retry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:text="@string/setup_retry"
            android:textColor="@color/fg_1"
            android:background="@drawable/bg_shortcut"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
