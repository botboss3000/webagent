/* webagent launcher — Textual CSS
 *
 * Tight stacked layout:
 *
 *   row  0   status: ... pid: ... uptime: ... url: ...      (status strip)
 *   row 1-3  [Launch] [Restart] [Stop] [Browser] [Theme]    (header buttons)
 *   rows ⬇   animation + WEBAGENT logo                       (1fr)
 *            log pane                                        (1fr)
 *   row N-3  [Clear DB] [Reset Py] [Full Reset] [Quit]      (footer buttons)
 *   row N-1  L:launch R:restart ... Q:quit                  (hint strip)
 *
 * Buttons are outline-only: rounded line border in the accent color,
 * matching text color, no fill. No padding around the button bars so
 * each header/footer block is just 3 rows tall.
 */

Screen {
    background: #0a0a14;
    color: #e6e6f0;
}

/* ───────────────────── top status bar (visible) ───────────────── */

#status-bar {
    height: 1;
    width: 100%;
    background: #14143a;
    color: #d0d0e8;
    padding: 0 2;
    layout: horizontal;
}

#status-bar > Static {
    height: 1;
    content-align: left middle;
    width: 1fr;
}

#status-dot {
    width: 6;
    color: #888;
    text-style: bold;
}
#status-dot.running  { color: #39ff14; }
#status-dot.starting { color: #ffb000; }
#status-dot.stopping { color: #ffb000; }
#status-dot.error    { color: #ff3344; }
#status-dot.stopped  { color: #888;    }

/* ───────────────────── header button row (compact, outline-only) ─ */

#header-buttons {
    height: 3;
    width: 100%;
    background: #0a0a14;
    padding: 0 1;
    layout: horizontal;
}

#header-buttons Button {
    width: 1fr;
    height: 3;
    margin: 0 1;
    border: round #2a2a55;
    background: #0a0a14;        /* match parent — looks like outline only */
    color: #d8d8f0;
    text-style: bold;
    content-align: center middle;
}
#header-buttons Button:hover {
    border: round #5dff4d;
    color: #5dff4d;
    background: #0a0a14;
}
#header-buttons Button:focus {
    border: round #5dff4d;
    color: #5dff4d;
}

#header-buttons Button.primary {
    border: round #39ff14;
    color: #39ff14;
    background: #0a0a14;
}
#header-buttons Button.primary:hover {
    border: round #aaffaa;
    color: #aaffaa;
}

#header-buttons Button.muted {
    border: round #5a5a8a;
    color: #b0b0d0;
    background: #0a0a14;
}
#header-buttons Button.muted:hover {
    border: round #aaaaff;
    color: #aaaaff;
}

/* ───────────────────── footer hint strip (visible) ────────────── */

#footer-bar {
    height: 1;
    width: 100%;
    background: #14143a;
    color: #a0a0bc;
    padding: 0 2;
}

/* ───────────────────── footer button row ──────────────────────── */

#footer-buttons {
    height: 3;
    width: 100%;
    background: #0a0a14;
    padding: 0 1;
    layout: horizontal;
}

#footer-buttons Button {
    width: 1fr;
    height: 3;
    margin: 0 1;
    border: round #ff5577;
    background: #0a0a14;
    color: #ff8aa0;
    text-style: bold;
    content-align: center middle;
}
#footer-buttons Button:hover {
    border: round #ffaabb;
    color: #ffccd5;
    background: #0a0a14;
}
#footer-buttons Button:focus {
    border: round #ffaabb;
    color: #ffaabb;
}

#footer-buttons Button.muted {
    border: round #5a5a8a;
    color: #b0b0d0;
    background: #0a0a14;
}
#footer-buttons Button.muted:hover {
    border: round #aaaaff;
    color: #aaaaff;
}

/* ───────────────────── middle body: stage + log ───────────────── */

#body {
    layout: vertical;
    width: 100%;
    height: 1fr;
    padding: 0;
}

#stage-widget {
    width: 100%;
    height: 1fr;
    min-height: 8;
    background: #08081a;
}

#log-pane {
    width: 100%;
    height: 1fr;
    min-height: 5;
    background: #0a0a14;
    border-top: solid #2a2a44;
    padding: 0 1;
    margin: 0;
}

#log-pane > RichLog {
    background: transparent;
    height: 100%;
    width: 100%;
    overflow-y: scroll;
    scrollbar-size-vertical: 1;
    scrollbar-color: #39ff14 #14143a;
    scrollbar-color-hover: #5dff4d #14143a;
    scrollbar-color-active: #5dff4d #14143a;
    scrollbar-background: #14143a;
    scrollbar-background-hover: #14143a;
    scrollbar-background-active: #14143a;
}

/* ───────────────────── settings screen ────────────────────────── */

SettingsScreen { align: center middle; }

#settings-panel {
    width: 78;
    max-width: 95%;
    height: 32;
    max-height: 90%;
    background: #0d0d1f;
    border: round #39ff14;
    padding: 0;
    layout: vertical;
}

#settings-header {
    height: 3;
    width: 100%;
    background: #14143a;
    border-bottom: solid #2a2a44;
    padding: 0 2;
    layout: horizontal;
}

#settings-title {
    width: 1fr;
    height: 100%;
    content-align: left middle;
    color: #aaffaa;
}

#settings-header Button {
    width: 18;
    height: 3;
    margin: 0;
    border: round #39ff14;
    background: #0a0a14;
    color: #39ff14;
    text-style: bold;
}
#settings-header Button:hover {
    border: round #aaffaa;
    color: #aaffaa;
}

#settings-body {
    width: 100%;
    height: 1fr;
    padding: 1 2;
    scrollbar-color: #39ff14 #14143a;
}

#settings-body .label {
    color: #aaaaff;
    text-style: bold;
    margin-top: 1;
}

#preset-list {
    height: 8;
    border: round #2a2a44;
    background: #08081a;
}

/* ───────────────────── setup screen ───────────────────────────── */

SetupScreen { align: center middle; }

#setup-panel {
    width: 86;
    max-width: 95%;
    height: auto;
    background: #0d0d1f;
    border: round #39ff14;
    padding: 2 3;
}

#setup-panel .label {
    color: #aaaaff;
    margin-bottom: 1;
}
#setup-panel Input {
    margin-bottom: 1;
}
#setup-panel Button {
    border: round #39ff14;
    background: #0a0a14;
    color: #39ff14;
}

/* ───────────────────── confirm modal ──────────────────────────── */

ConfirmModal { align: center middle; }

#confirm-panel {
    width: 58;
    height: auto;
    background: #1a0a1a;
    border: round #ff5577;
    padding: 1 2;
}

#confirm-panel .label {
    color: #ffaaaa;
    text-style: bold;
    margin-bottom: 1;
}

#confirm-panel Button {
    margin: 1 1 0 1;
    border: round #ff5577;
    background: #1a0a1a;
    color: #ff8aa0;
}
#confirm-panel Button:hover {
    border: round #ffaabb;
    color: #ffccd5;
}
