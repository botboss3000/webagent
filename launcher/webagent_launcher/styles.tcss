/* webagent launcher — Textual CSS
 *
 * Layout (font-safe, no exotic glyphs):
 *
 *   ┌──────────────────────────────────────────────┐
 *   │ status bar (full width)                      │
 *   ├──────────┬─────────────────────┬─────────────┤
 *   │          │  animated banner    │             │
 *   │ left col │  (logo over plasma) │ right col   │
 *   │ (5 btns) ├─────────────────────┤  (5 btns)   │
 *   │          │  log pane           │             │
 *   ├──────────┴─────────────────────┴─────────────┤
 *   │ footer hints                                 │
 *   └──────────────────────────────────────────────┘
 */

Screen {
    background: #0a0a14;
    color: #e6e6f0;
}

/* ───────────────────── top status bar ─────────────────────────── */

#status-bar {
    dock: top;
    height: 1;
    width: 100%;
    background: #0d0d1f;
    color: #b0b0c0;
    padding: 0 2;
    layout: horizontal;
}

#status-bar > Static {
    height: 1;
    content-align: left middle;
    width: 1fr;
}

#status-dot {
    width: 6;
    color: #888;
}

#status-dot.running  { color: #39ff14; }
#status-dot.starting { color: #ffb000; }
#status-dot.stopping { color: #ffb000; }
#status-dot.error    { color: #ff3344; }
#status-dot.stopped  { color: #888;    }

/* ───────────────────── footer hints ───────────────────────────── */

#footer-bar {
    dock: bottom;
    height: 1;
    width: 100%;
    background: #0d0d1f;
    color: #6a6a82;
    padding: 0 2;
}

/* ───────────────────── 3-column body ──────────────────────────── */

#body {
    layout: horizontal;
    width: 100%;
    height: 1fr;
    padding: 0;
}

.side-col {
    width: 22;
    height: 100%;
    background: #0d0d1f;
    padding: 1 1;
    layout: vertical;
}

#left-col { border-right: solid #2a2a44; }
#right-col { border-left:  solid #2a2a44; }

.side-col Button {
    width: 100%;
    height: 3;
    margin-bottom: 1;
    border: blank;
    background: #1a1a2e;
    color: #d0d0e0;
    text-style: bold;
}

.side-col Button:hover {
    background: #2a2a44;
}

.side-col Button.primary  { background: #1d3d1d; color: #c8ffc8; }
.side-col Button.primary:hover  { background: #2d5d2d; }
.side-col Button.danger   { background: #3d1d1d; color: #ffc8c8; }
.side-col Button.danger:hover   { background: #5d2d2d; }
.side-col Button.muted    { background: #1a1a2a; color: #b0b0d0; }

/* Center column: animation+logo on top, log on bottom */

#center-col {
    width: 1fr;
    height: 100%;
    layout: vertical;
    padding: 0;
}

#stage-widget {
    width: 100%;
    height: 1fr;
    min-height: 14;
    background: #08081a;
    border-bottom: solid #2a2a44;
}

#log-pane {
    width: 100%;
    height: 16;
    min-height: 8;
    background: #08081a;
    padding: 0 1;
}

#log-pane > RichLog {
    background: transparent;
    height: 100%;
    width: 100%;
    overflow-y: scroll;             /* always show the vertical scrollbar */
    scrollbar-size-vertical: 1;
    scrollbar-color: #39ff14 #14143a;
    scrollbar-color-hover: #5dff4d #14143a;
    scrollbar-color-active: #5dff4d #14143a;
    scrollbar-background: #14143a;
    scrollbar-background-hover: #14143a;
    scrollbar-background-active: #14143a;
}

/* ───────────────────── settings screen ────────────────────────── */

SettingsScreen {
    align: center middle;
}

#settings-panel {
    width: 78;
    max-width: 95%;
    height: 32;
    max-height: 90%;
    background: #0d0d1f;
    border: heavy #39ff14;
    padding: 0;
    layout: vertical;
}

#settings-header {
    dock: top;
    height: 3;
    width: 100%;
    background: #14143a;
    border-bottom: solid #2a2a44;
    padding: 0 2;
    layout: horizontal;
}

#settings-title {
    width: 1fr;
    height: 100%;
    content-align: left middle;
    color: #aaffaa;
}

#settings-header Button {
    width: 16;
    height: 3;
    margin: 0;
    border: blank;
    background: #1d3d1d;
    color: #c8ffc8;
    text-style: bold;
}

#settings-header Button:hover { background: #2d5d2d; }

#settings-body {
    width: 100%;
    height: 1fr;
    padding: 1 2;
    scrollbar-color: #2a2a44 #08081a;
}

#settings-body .label {
    color: #aaaaff;
    text-style: bold;
    margin-top: 1;
}

#preset-list {
    height: 8;
    border: solid #2a2a44;
    background: #08081a;
}

/* ───────────────────── setup screen ───────────────────────────── */

SetupScreen {
    align: center middle;
}

#setup-panel {
    width: 86;
    max-width: 95%;
    height: auto;
    background: #0d0d1f;
    border: heavy #39ff14;
    padding: 2 3;
}

#setup-panel .label {
    color: #aaaaff;
    margin-bottom: 1;
}

#setup-panel Input {
    margin-bottom: 1;
}

/* ───────────────────── confirm modal ──────────────────────────── */

ConfirmModal {
    align: center middle;
}

#confirm-panel {
    width: 58;
    height: auto;
    background: #1a0a1a;
    border: heavy #ff3344;
    padding: 1 2;
}

#confirm-panel .label {
    color: #ffaaaa;
    text-style: bold;
    margin-bottom: 1;
}

#confirm-panel Button {
    margin: 1 1 0 1;
}
