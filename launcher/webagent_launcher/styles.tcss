/* webagent launcher — Textual CSS (single-screen chat redesign)
 *
 * The launcher is now ONE screen: the chat. Server controls live in an
 * overlay admin panel; the animation is a hidden banner; a first-run installer
 * is its own screen. EVERY color here is a THEME VARIABLE (no literal hex) so
 * the whole UI re-skins live across all 23 themes and stays legible in light
 * AND dark themes (CLAUDE.md rule). Custom variables ($dim, $tool, $bar-bg,
 * $bar-fg, $bar-accent, $border-dim, $sel) come from each theme + the app's
 * get_theme_variable_defaults() fallbacks.
 */

Screen {
    background: $background;
    color: $foreground;
}

/* ═══════════════════ first-run installer / re-point ═══════════════════ */

#install-root {
    width: 100%;
    height: 100%;
    layout: vertical;
    background: $background;
}

#install-stage {
    width: 100%;
    height: 1fr;
    min-height: 8;
    background: $surface;
}

#install-tabs {
    height: 3;
    width: 100%;
    background: $bar-bg;
    padding: 0 1;
    layout: horizontal;
}
#install-tabs Button {
    width: 1fr;
    height: 3;
    margin: 0 1;
    border: round $border-dim;
    background: $background;
    color: $foreground;
    text-style: bold;
    content-align: center middle;
}
#install-tabs Button.primary { border: round $primary; color: $primary; }
#install-tabs Button.primary:hover { border: round $primary-lighten-2; color: $primary-lighten-2; }
#install-tabs Button.muted { border: round $dim; color: $text-muted; }
#install-tabs Button:hover { border: round $accent; color: $accent; }
#install-tabs Button:focus { border: round $accent; color: $accent; }

/* the SetupPanel body fills the middle of the install screen (always shown
 * there, so no display:none). */
#setup-panel-inline {
    width: 100%;
    height: 1fr;
    min-height: 5;
    background: $panel;
    border-top: solid $primary;
    padding: 0 1;
    layout: vertical;
}

#setup-form {
    width: 100%;
    height: 1fr;
    padding: 0 1;
    layout: vertical;
    overflow-y: auto;
}
#setup-heading { width: 100%; height: 1; color: $primary-lighten-2; text-style: bold; margin: 0 0 1 0; }
#setup-help { width: 100%; height: auto; color: $dim; margin-bottom: 1; }
#setup-error { width: 100%; height: auto; color: $text-error; margin-bottom: 1; }
#setup-dest-label { width: 100%; height: 1; color: $accent; text-style: bold; }
#setup-form-row { width: 100%; height: 3; margin-bottom: 1; }
#setup-form-row #path-input {
    width: 1fr; height: 3; margin: 0; border: round $border-dim; background: $surface;
}
#setup-form-row #path-input:focus { border: round $primary; }
#setup-go {
    width: auto; height: 3; margin-left: 1; padding: 0 2;
    border: round $primary; background: $background; color: $primary; text-style: bold;
}
#setup-go:hover { border: round $primary-lighten-2; color: $primary-lighten-2; }
#setup-current {
    display: none; width: auto; height: 3; margin-left: 1; padding: 0 2;
    border: round $secondary; background: $background; color: $secondary; text-style: bold;
}
#setup-current:hover { border: round $secondary-lighten-2; color: $secondary-lighten-2; }
#setup-cancel {
    display: none; width: auto; height: 3; margin-left: 1; padding: 0 2;
    border: round $dim; background: $background; color: $text-muted; text-style: bold;
}
#setup-cancel:hover { border: round $accent; color: $accent; }

.setup-subhead { width: 100%; height: 1; color: $primary-lighten-2; text-style: bold; margin: 0 0 1 0; }

#setup-manual {
    display: none; width: 100%; height: 1fr; padding: 0 1;
    scrollbar-size-vertical: 1; scrollbar-color: $primary $bar-bg;
}
#setup-manual-text { width: 100%; height: auto; color: $foreground; }

#setup-doctor { display: none; width: 100%; height: 1fr; padding: 0 1; layout: vertical; }
#setup-doctor-log {
    width: 100%; height: 1fr; background: $surface; border: round $border-dim; padding: 0 1;
    scrollbar-size-vertical: 1; scrollbar-color: $primary $bar-bg;
}

#setup-progress { display: none; width: 100%; height: 1fr; padding: 0 1; layout: vertical; }
#setup-progress-title { width: 100%; height: auto; color: $primary-lighten-2; text-style: bold; margin-bottom: 1; }
#setup-log {
    width: 100%; height: 1fr; background: $surface; border: round $border-dim; padding: 0 1;
    scrollbar-size-vertical: 1; scrollbar-color: $primary $bar-bg;
}
#setup-progress-actions { height: 3; width: 100%; margin-top: 1; }
#setup-progress-actions Button {
    width: 1fr; height: 3; margin: 0 1 0 0;
    border: round $primary; background: $background; color: $primary; text-style: bold;
}
#setup-progress-actions Button:hover { border: round $primary-lighten-2; color: $primary-lighten-2; }
#setup-progress-actions Button:disabled { border: round $border-dim; color: $dim; }

/* ═══════════════════ confirm modal ═══════════════════ */

ConfirmModal { align: center middle; }
#confirm-panel {
    width: 58; height: auto; background: $panel; border: round $error; padding: 1 2;
}
#confirm-panel .label { color: $text-error; text-style: bold; margin-bottom: 1; }
#confirm-panel Button {
    margin: 1 1 0 1; border: round $error; background: $panel; color: $text-error;
}
#confirm-panel Button:hover { border: round $error-lighten-2; color: $error-lighten-2; }

/* ═══════════════════ chat screen (the single base view) ═══════════════════ */

/* Two layers: the chat (base) and slide-in panels (overlay) that draw on top
 * WITHOUT reflowing the transcript. */
ChatScreen { background: $background; scrollbar-size: 0 0; layers: base overlay; }

#chat-status {
    height: 1; width: 100%; background: $bar-bg; color: $bar-fg; padding: 0 2;
}

#chat-body { width: 100%; height: 1fr; layout: vertical; }

/* hidden-by-default animation banner (folded in from the old home screen) */
#chat-anim-banner {
    width: 100%;
    height: 11;
    min-height: 6;
    background: $surface;
    display: none;
}

#chat-log {
    width: 100%; height: 1fr; background: $background; padding: 0 1; overflow-y: auto;
    display: none;  /* shown once loading finishes */
    scrollbar-gutter: stable;
    scrollbar-size-vertical: 1;
    scrollbar-color: $primary $background;
    scrollbar-color-hover: $primary-lighten-2 $background;
    scrollbar-color-active: $primary-lighten-2 $background;
    scrollbar-background: $background;
    scrollbar-background-hover: $background;
    scrollbar-background-active: $background;
}

.chat-banner { width: 100%; padding: 0 1; margin: 0 0 1 0; }

#chat-hud {
    height: 1; width: 100%; background: $panel; color: $dim; padding: 0 2;
}

#chat-walker { height: 1; width: 100%; padding: 0 2; }

#chat-input {
    width: 100%; height: 3; max-height: 7;
    border: round $border-dim; background: $panel; color: $foreground;
    scrollbar-size: 0 0;
}
#chat-input:focus { border: round $primary; }
#chat-input .text-area--cursor { background: $primary; color: $background; }
#chat-input .text-area--selection { background: $sel; }

#chat-hints { height: 1; width: 100%; background: $bar-bg; color: $bar-fg; padding: 0 2; }
#chat-hints .hint-btn { margin: 0 1 0 0; color: $bar-accent; }
#chat-hints .hint-btn:hover { color: $bar-fg; text-style: bold; }

/* loading log — shown during init, hidden once ready */
#chat-loading-log {
    width: 100%; height: 1fr; background: $background; padding: 0 1; overflow-y: auto;
    scrollbar-gutter: stable; scrollbar-size-vertical: 1;
    scrollbar-color: $tool $background;
    scrollbar-color-hover: $tool $background;
    scrollbar-color-active: $tool $background;
    scrollbar-background: $background;
}
.loading-line { width: 100%; color: $dim; padding: 0 1; }

/* messages */
.msg-user {
    width: 100%; background: $sel; color: $foreground;
    border-left: thick $secondary; padding: 0 1; margin: 1 0 0 0;
}
.msg-agent { width: 100%; color: $foreground; padding: 0 1; margin: 1 0 0 0; }
.msg-error { color: $text-error; }
.msg-pipe { width: 100%; color: $dim; padding: 0 1; }
.msg-stats { width: 100%; color: $dim; padding: 0 1; }

/* tool-call blocks */
.tool-block { width: 100%; background: $panel; border: round $border-dim; margin: 1 0 0 0; }
.tool-block CollapsibleTitle { color: $tool; }
.tool-body { color: $foreground; padding: 0 1; }

/* ═══════════════════ admin panel (overlay, server control) ═══════════════════ */

#admin-panel {
    layer: overlay;
    dock: right;
    width: 60;
    max-width: 90%;
    height: 100%;
    display: none;
    background: $panel;
    border-left: solid $primary;
    padding: 0 1;
    layout: vertical;
}
#admin-title {
    width: 100%; height: 1; background: $bar-bg; color: $bar-fg;
    text-style: bold; content-align: center middle;
}
#admin-status { height: 1; width: 100%; layout: horizontal; margin-top: 1; }
#admin-status2 { height: 1; width: 100%; layout: horizontal; }
#admin-status > Static, #admin-status2 > Static { height: 1; width: 1fr; color: $dim; }
#admin-panel #status-dot { width: 6; color: $dim; text-style: bold; }
#admin-panel #status-dot.running  { color: $success; }
#admin-panel #status-dot.starting { color: $tool; }
#admin-panel #status-dot.stopping { color: $tool; }
#admin-panel #status-dot.error    { color: $error; }
#admin-panel #status-dot.stopped  { color: $dim; }

#admin-buttons { width: 100%; height: auto; layout: vertical; margin: 1 0; }
.admin-btn-row { width: 100%; height: 3; layout: horizontal; }
.admin-btn-row Button {
    width: 1fr; height: 3; margin: 0 1;
    border: round $border-dim; background: $background; color: $foreground;
    text-style: bold; content-align: center middle;
}
.admin-btn-row Button:hover { border: round $primary-lighten-2; color: $primary-lighten-2; }
.admin-btn-row Button:focus { border: round $primary; color: $primary; }
.admin-btn-row Button.primary { border: round $primary; color: $primary; }
.admin-btn-row Button.primary:hover { border: round $primary-lighten-2; color: $primary-lighten-2; }
.admin-btn-row Button.muted { border: round $dim; color: $text-muted; }
.admin-btn-row Button.muted:hover { border: round $accent; color: $accent; }
.admin-btn-row Button.danger { border: round $error; color: $text-error; }
.admin-btn-row Button.danger:hover { border: round $error-lighten-2; color: $error-lighten-2; }

#admin-log-title { width: 100%; height: 1; color: $accent; text-style: bold; margin-top: 1; }
#admin-panel #log {
    width: 100%; height: 1fr; min-height: 5; background: $surface;
    border: round $border-dim; padding: 0 1;
    overflow-y: scroll; scrollbar-size-vertical: 1;
    scrollbar-color: $tool $surface;
    scrollbar-background: $surface;
}

/* ═══════════════════ keyboard pickers (theme / agent / session) ═══════════════════ */

ListPicker { align: center bottom; }
#picker-panel {
    width: 96%; max-width: 120; height: auto; max-height: 60%;
    background: $panel; border: round $primary; padding: 1 1; margin: 0 0 1 0;
}
#picker-title { color: $primary-lighten-2; text-style: bold; padding: 0 1 1 1; }
#picker-list { height: auto; max-height: 18; background: $surface; border: round $border-dim; }
#picker-list > ListItem { padding: 0 1; }
#picker-list > ListItem.--highlight { background: $sel; color: $foreground; }

/* filter modal reuses the picker panel */
#filter-list {
    height: auto; max-height: 16; background: $surface; border: round $border-dim; padding: 0 1;
}
#filter-list > .selection-list--option { padding: 0 1; }

/* credentials modal */
CredentialsModal { align: center middle; }
#creds-panel { width: 54; height: auto; background: $panel; border: round $primary; padding: 1 2; }
#creds-panel .label { color: $primary-lighten-2; text-style: bold; margin-bottom: 1; }
#creds-panel .dim { color: $dim; margin-top: 1; }
#creds-panel Input { margin-bottom: 1; }
