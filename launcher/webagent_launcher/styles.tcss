/* webagent launcher — Textual CSS
 *
 * Stacked layout:
 *
 *   ┌────────────────────────────────────────────────────────────┐
 *   │ status bar  status: ...  pid: ...  uptime: ...  url: ...   │
 *   ├────────────────────────────────────────────────────────────┤
 *   │ ╭ Launch ╮ ╭ Restart ╮ ╭ Stop ╮ ╭ Browser ╮ ╭ Theme ╮     │  header buttons
 *   │ ╰────────╯ ╰─────────╯ ╰──────╯ ╰─────────╯ ╰───────╯     │
 *   ├────────────────────────────────────────────────────────────┤
 *   │                                                            │
 *   │              animated plasma + WEBAGENT logo               │  top half
 *   │                                                            │
 *   ├────────────────────────────────────────────────────────────┤
 *   │  log line 1                                                │
 *   │  log line 2                                                │  bottom half
 *   │  ...                                                       │
 *   ├────────────────────────────────────────────────────────────┤
 *   │ ╭ Clear DB ╮ ╭ Reset Py ╮ ╭ Full Reset ╮ ╭ Quit ╮         │  footer buttons
 *   │ ╰──────────╯ ╰──────────╯ ╰────────────╯ ╰──────╯         │
 *   ├────────────────────────────────────────────────────────────┤
 *   │ footer hints                                               │
 *   └────────────────────────────────────────────────────────────┘
 */

Screen {
    background: #0a0a14;
    color: #e6e6f0;
}

/* ───────────────────── top status bar ─────────────────────────── */

#status-bar {
    dock: top;
    height: 1;
    width: 100%;
    background: #0d0d1f;
    color: #b0b0c0;
    padding: 0 2;
    layout: horizontal;
}

#status-bar > Static {
    height: 1;
    content-align: left middle;
    width: 1fr;
}

#status-dot {
    width: 6;
    color: #888;
}
#status-dot.running  { color: #39ff14; }
#status-dot.starting { color: #ffb000; }
#status-dot.stopping { color: #ffb000; }
#status-dot.error    { color: #ff3344; }
#status-dot.stopped  { color: #888;    }

/* ───────────────────── header button row ──────────────────────── */

#header-buttons {
    dock: top;
    height: 5;
    width: 100%;
    background: #0d0d1f;
    border-bottom: solid #2a2a44;
    padding: 1 2;
    layout: horizontal;
    align: center middle;
}

#header-buttons Button {
    width: 1fr;
    height: 3;
    margin: 0 1;
    border: round #2a2a44;
    background: #14143a;
    color: #d8d8f0;
    text-style: bold;
    content-align: center middle;
}
#header-buttons Button:hover {
    background: #2a2a55;
    border: round #5dff4d;
    color: #ffffff;
}
#header-buttons Button:focus {
    border: round #5dff4d;
}
#header-buttons Button.primary {
    background: #1d3d1d;
    color: #c8ffc8;
    border: round #39ff14;
}
#header-buttons Button.primary:hover {
    background: #2d5d2d;
    border: round #5dff4d;
}
#header-buttons Button.muted {
    background: #14143a;
    color: #b0b0d0;
    border: round #2a2a44;
}

/* ───────────────────── footer hint strip ──────────────────────── */

#footer-bar {
    dock: bottom;
    height: 1;
    width: 100%;
    background: #0d0d1f;
    color: #8a8aa2;
    padding: 0 2;
}

/* ───────────────────── footer button row ──────────────────────── */

#footer-buttons {
    dock: bottom;
    height: 5;
    width: 100%;
    background: #0d0d1f;
    border-top: solid #2a2a44;
    padding: 1 2;
    layout: horizontal;
    align: center middle;
}

#footer-buttons Button {
    width: 1fr;
    height: 3;
    margin: 0 1;
    border: round #2a2a44;
    background: #14143a;
    color: #d8d8f0;
    text-style: bold;
    content-align: center middle;
}
#footer-buttons Button:hover {
    background: #2a2a55;
    border: round #ff8899;
    color: #ffffff;
}
#footer-buttons Button:focus {
    border: round #ff8899;
}
#footer-buttons Button.danger {
    background: #3d1d1d;
    color: #ffc8c8;
    border: round #ff5577;
}
#footer-buttons Button.danger:hover {
    background: #5d2d2d;
    border: round #ff8899;
}
#footer-buttons Button.muted {
    background: #14143a;
    color: #b0b0d0;
    border: round #2a2a44;
}

/* ───────────────────── middle body: stage + log ───────────────── */

#body {
    layout: vertical;
    width: 100%;
    height: 1fr;
    padding: 0;
}

#stage-widget {
    width: 100%;
    height: 1fr;
    min-height: 10;
    background: #08081a;
}

#log-pane {
    width: 100%;
    height: 1fr;
    min-height: 6;
    background: #0a0a14;
    border-top: solid #2a2a44;
    border-bottom: solid #2a2a44;
    padding: 0 1;
    margin: 0;
}

#log-pane > RichLog {
    background: transparent;
    height: 100%;
    width: 100%;
    overflow-y: scroll;
    scrollbar-size-vertical: 1;
    scrollbar-color: #39ff14 #14143a;
    scrollbar-color-hover: #5dff4d #14143a;
    scrollbar-color-active: #5dff4d #14143a;
    scrollbar-background: #14143a;
    scrollbar-background-hover: #14143a;
    scrollbar-background-active: #14143a;
}

/* ───────────────────── settings screen ────────────────────────── */

SettingsScreen { align: center middle; }

#settings-panel {
    width: 78;
    max-width: 95%;
    height: 32;
    max-height: 90%;
    background: #0d0d1f;
    border: round #39ff14;
    padding: 0;
    layout: vertical;
}

#settings-header {
    dock: top;
    height: 3;
    width: 100%;
    background: #14143a;
    border-bottom: solid #2a2a44;
    padding: 0 2;
    layout: horizontal;
}

#settings-title {
    width: 1fr;
    height: 100%;
    content-align: left middle;
    color: #aaffaa;
}

#settings-header Button {
    width: 18;
    height: 3;
    margin: 0;
    border: round #39ff14;
    background: #1d3d1d;
    color: #c8ffc8;
    text-style: bold;
}
#settings-header Button:hover {
    background: #2d5d2d;
    border: round #5dff4d;
}

#settings-body {
    width: 100%;
    height: 1fr;
    padding: 1 2;
    scrollbar-color: #39ff14 #14143a;
}

#settings-body .label {
    color: #aaaaff;
    text-style: bold;
    margin-top: 1;
}

#preset-list {
    height: 8;
    border: round #2a2a44;
    background: #08081a;
}

/* ───────────────────── setup screen ───────────────────────────── */

SetupScreen { align: center middle; }

#setup-panel {
    width: 86;
    max-width: 95%;
    height: auto;
    background: #0d0d1f;
    border: round #39ff14;
    padding: 2 3;
}

#setup-panel .label {
    color: #aaaaff;
    margin-bottom: 1;
}
#setup-panel Input {
    margin-bottom: 1;
}
#setup-panel Button {
    border: round #39ff14;
    background: #1d3d1d;
    color: #c8ffc8;
}

/* ───────────────────── confirm modal ──────────────────────────── */

ConfirmModal { align: center middle; }

#confirm-panel {
    width: 58;
    height: auto;
    background: #1a0a1a;
    border: round #ff5577;
    padding: 1 2;
}

#confirm-panel .label {
    color: #ffaaaa;
    text-style: bold;
    margin-bottom: 1;
}

#confirm-panel Button {
    margin: 1 1 0 1;
    border: round #ff5577;
    background: #3d1d1d;
    color: #ffc8c8;
}
#confirm-panel Button:hover {
    background: #5d2d2d;
    border: round #ff8899;
}
